page {
  background: #B68652; /* 基础金色背景 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

.push-channel-page {
  min-height: 100vh;
  /* 增加由深到浅的渐变色，模拟祥云背景底色 */
  background: linear-gradient(to bottom, #9E6426 0%, #B68652 30%, #C49A6C 100%);
  padding-bottom: 40rpx;
}

/* 顶部导航与标题 */
.top-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  padding: 10rpx 30rpx 20rpx;
}

.back-btn {
  position: absolute;
  left: 30rpx;
  font-size: 40rpx;
  font-weight: 300;
  padding: 10rpx 20rpx 10rpx 0;
}

.right-icon {
  position: absolute;
  right: 30rpx;
  background: rgba(255, 255, 255, 0.4);
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* 艺术字标题区域 */
.title-logo {
  display: flex;
  justify-content: center;
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.title-box {
  background: #731F00;
  border: 4rpx solid #EAC085;
  border-radius: 40rpx;
  padding: 10rpx 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}

.title-box .text {
  font-size: 44rpx;
  font-weight: bold;
  color: #FFF;
  letter-spacing: 4rpx;
  margin: 0 10rpx;
}

.title-box .decor {
  color: #EAC085;
  font-family: serif;
  font-size: 30rpx;
}

/* 选项卡栏 */
.tabs {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}

.tab-item {
  background: #FFF;
  color: #888;
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  z-index: 11;
}

.tab-item.active {
  background: #E63535;
  color: #FFF;
  box-shadow: 0 4rpx 8rpx rgba(255, 122, 0, 0.3);
}

/* 瀑布流商品列表 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  justify-content: space-between;
}

.good {
  width: 48.5%;
  background: #FFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.good .cover {
  width: 100%;
  height: 340rpx;
  display: block;
}

.info-box {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.good .name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  height: 78rpx; /* 控制显示两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.good .share-tag {
  font-size: 20rpx;
  color: #FF4A4A;
  margin-bottom: 8rpx;
}

.good .price {
  font-size: 36rpx;
  color: #FF4A4A;
  font-weight: bold;
}
