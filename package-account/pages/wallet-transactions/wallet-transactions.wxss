.wt-page { min-height: 100vh; background: #f5f5f5; padding: 16rpx; }
.wt-item { display: flex; justify-content: space-between; background: #fff; padding: 24rpx; border-radius: 12rpx; margin-bottom: 12rpx; align-items: center; }
.wt-title { display: block; font-size: 28rpx; }
.wt-time { font-size: 22rpx; color: #999; }
.wt-amt { font-size: 30rpx; font-weight: 600; color: #16a34a; }
.wt-amt.out { color: #dc2626; }
.wt-empty { text-align: center; color: #999; padding: 80rpx; font-size: 26rpx; }
