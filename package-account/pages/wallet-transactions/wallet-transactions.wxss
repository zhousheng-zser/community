.wt-page { min-height: 100vh; background: #f5f5f5; padding: 16rpx; }
.wt-item { display: flex; justify-content: space-between; background: #fff; padding: 24rpx 28rpx; border-radius: 12rpx; margin-bottom: 12rpx; align-items: center; }
.wt-left { flex: 1; overflow: hidden; }
.wt-title { display: block; font-size: 28rpx; color: #333; }
.wt-time { display: block; font-size: 22rpx; color: #999; margin-top: 6rpx; }
.wt-order { display: block; font-size: 20rpx; color: #bbb; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wt-amt { font-size: 32rpx; font-weight: 600; color: #16a34a; white-space: nowrap; margin-left: 20rpx; }
.wt-loading { text-align: center; color: #999; padding: 40rpx; font-size: 26rpx; }
.wt-empty { text-align: center; color: #999; padding: 120rpx 0; font-size: 28rpx; }
.wt-nomore { text-align: center; color: #ccc; padding: 30rpx; font-size: 24rpx; }
