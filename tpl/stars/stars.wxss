/* 使用字符星标，避免内嵌大图超过 200KB 限制 */

.star-list {
  display: flex;
  align-items: center;
}

.star {
  width: 40rpx;
  height: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  background: none;
}

/* 空心星 */
.star.star0 {
  color: #ddd;
}

.star.star0::before {
  content: '\2606';
}

/* 实心星 */
.star.star1 {
  color: #ffb400;
}

.star.star1::before {
  content: '\2605';
}
