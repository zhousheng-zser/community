@import "../../styles/portal.wxss";

.sheet-btn {
  margin: 0;
  font-size: 28rpx;
  border-radius: 16rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
}

.sheet-btn.block {
  width: 100%;
  line-height: 88rpx;
}

.sheet-btn.primary {
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  color: #fff;
}

.sheet-btn.ghost {
  background: #faf8f4;
  color: #8b6914;
  border: 1rpx solid #dcc9a8;
}

page {
  background: #f5f0e8;
}

.edit-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.portal-top .portal-title {
  line-height: 1.35;
}

.portal-top .portal-sub {
  margin-top: 10rpx;
  line-height: 1.6;
}

.loading-box {
  padding: 120rpx 0;
  text-align: center;
  color: #78716c;
  font-size: 28rpx;
}

.edit-card {
  margin: 0 24rpx 32rpx;
  padding: 28rpx 24rpx;
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #57534e;
  font-weight: 600;
  margin-bottom: 14rpx;
  line-height: 1.45;
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  line-height: 1.35;
  background: #faf8f4;
  border-radius: 16rpx;
  border: 1rpx solid #e7dfd0;
}

.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  line-height: 1.6;
  background: #faf8f4;
  border-radius: 16rpx;
  border: 1rpx solid #e7dfd0;
}

.field-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.img-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.goods-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #e7dfd0;
  flex-shrink: 0;
}

.img-actions {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 4rpx;
}

.multi-img-wrap {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.multi-img-item {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}

.multi-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #e7dfd0;
}

.multi-img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(17, 17, 17, 0.8);
  color: #fff;
  font-size: 24rpx;
}

.mini-pad {
  margin: 0;
  align-self: flex-start;
}

.danger-text {
  color: #b45309 !important;
}

.step-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #7a5c28;
  background: #faf8f4;
  border-radius: 12rpx;
  border: 1rpx solid #dcc9a8;
}

.step-input {
  flex: 1;
  min-height: 72rpx;
  text-align: center;
  padding: 12rpx 16rpx;
  font-size: 32rpx;
  line-height: 1.4;
  background: #faf8f4;
  border-radius: 12rpx;
  border: 1rpx solid #e7dfd0;
}

.save-btn {
  margin-top: 16rpx;
}

.quick-tags {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tag-title {
  font-size: 22rpx;
  color: #78716c;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-tag {
  font-size: 22rpx;
  color: #7a5c28;
  background: #faf8f4;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e7dfd0;
  transition: all 0.2s ease;
}

.quick-tag.active {
  color: #fff;
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  border-color: #6b4f2a;
}

.picker-display-box {
  width: 100%;
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 14rpx 20rpx;
  font-size: 30rpx;
  background: #faf8f4;
  border-radius: 16rpx;
  border: 1rpx solid #e7dfd0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-value {
  color: #1c1917;
  font-weight: 500;
}

.picker-placeholder {
  color: #a8a29e;
}

.picker-arrow {
  font-size: 20rpx;
  color: #7a5c28;
}
