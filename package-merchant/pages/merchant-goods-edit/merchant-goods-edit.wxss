@import "../../styles/portal.wxss";

.sheet-btn {
  margin: 0;
  font-size: 28rpx;
  border-radius: 16rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
}

.sheet-btn.block {
  width: 100%;
  line-height: 88rpx;
}

.sheet-btn.primary {
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  color: #fff;
}

.sheet-btn.ghost {
  background: #faf8f4;
  color: #8b6914;
  border: 1rpx solid #dcc9a8;
}

page {
  background: #f5f0e8;
}

.edit-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.loading-box {
  padding: 120rpx 0;
  text-align: center;
  color: #78716c;
  font-size: 28rpx;
}

.edit-card {
  margin: 0 24rpx 32rpx;
}

.field {
  margin-bottom: 36rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: #57534e;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #faf8f4;
  border-radius: 16rpx;
  border: 1rpx solid #e7dfd0;
}

.field-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #faf8f4;
  border-radius: 16rpx;
  border: 1rpx solid #e7dfd0;
}

.field-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.img-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.goods-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #e7dfd0;
  flex-shrink: 0;
}

.img-actions {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mini-pad {
  margin: 0;
  align-self: flex-start;
}

.danger-text {
  color: #b45309 !important;
}

.step-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #7a5c28;
  background: #faf8f4;
  border-radius: 12rpx;
  border: 1rpx solid #dcc9a8;
}

.step-input {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 30rpx;
  background: #faf8f4;
  border-radius: 12rpx;
  border: 1rpx solid #e7dfd0;
}

.save-btn {
  margin-top: 16rpx;
}
