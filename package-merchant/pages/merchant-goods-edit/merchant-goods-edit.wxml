<view class="portal-page edit-page">
  <view class="portal-top merchant-gradient" style="padding-bottom: 24rpx;">
    <text class="portal-title">{{isCreate ? '新增商品并上架' : '编辑商品资料'}}</text>
    <text class="portal-sub">{{isCreate ? '填写商品信息后创建并立即上架' : '主图、售价、库存与文字说明；保存后用户在店铺中可见'}}</text>
  </view>

  <block wx:if="{{loading}}">
    <view class="loading-box">加载中…</view>
  </block>

  <block wx:else>
    <view class="portal-card edit-card">
      <view class="field">
        <text class="field-label">商品名称</text>
        <input
          class="field-input"
          placeholder="请输入名称"
          value="{{title}}"
          maxlength="80"
          bindinput="onTitleInput"
        />
      </view>

      <view class="field">
        <text class="field-label">店铺内分类</text>
        
        <!-- 场景 A：店铺配置了分类，展示下拉选择器（Picker） -->
        <block wx:if="{{shopCategories && shopCategories.length > 0}}">
          <picker
            mode="selector"
            range="{{shopCategories}}"
            range-key="name"
            bindchange="onCategoryPickerChange"
          >
            <view class="picker-display-box">
              <text class="picker-value" wx:if="{{categoryKey}}">{{selectedCategoryName || categoryKey}}</text>
              <text class="picker-placeholder" wx:else>请选择店铺内分类</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </block>
        
        <!-- 场景 B：店铺未配置分类，允许手动输入，并提供常用推荐快捷标签 -->
        <block wx:else>
          <input
            class="field-input"
            placeholder="如：热销爆款、今日特惠、招牌菜"
            value="{{categoryKey}}"
            maxlength="50"
            bindinput="onCategoryInput"
          />
          <view class="quick-tags">
            <text class="tag-title">常用推荐：</text>
            <view class="tag-list">
              <text class="quick-tag {{categoryKey === '今日特惠' ? 'active' : ''}}" bindtap="onCategoryInput" data-value="今日特惠">今日特惠</text>
              <text class="quick-tag {{categoryKey === '招牌推荐' ? 'active' : ''}}" bindtap="onCategoryInput" data-value="招牌推荐">招牌推荐</text>
              <text class="quick-tag {{categoryKey === '热销爆款' ? 'active' : ''}}" bindtap="onCategoryInput" data-value="热销爆款">热销爆款</text>
              <text class="quick-tag {{categoryKey === '酒水饮料' ? 'active' : ''}}" bindtap="onCategoryInput" data-value="酒水饮料">酒水饮料</text>
              <text class="quick-tag {{categoryKey === '新鲜水果' ? 'active' : ''}}" bindtap="onCategoryInput" data-value="新鲜水果">新鲜水果</text>
            </view>
          </view>
        </block>
      </view>

      <view class="field">
        <text class="field-label">商品图片（最多 6 张）</text>
        <view class="img-row">
          <image
            class="goods-cover"
            src="{{coverDisplay}}"
            mode="aspectFill"
            bindtap="previewCover"
          ></image>
          <view class="img-actions">
            <button class="sheet-btn ghost mini-pad" size="mini" bindtap="chooseCover">上传/追加图片</button>
            <button
              class="sheet-btn ghost mini-pad danger-text"
              size="mini"
              wx:if="{{mainImagePath}}"
              bindtap="clearCover"
            >移除</button>
          </view>
        </view>
        <view class="multi-img-wrap" wx:if="{{imageList.length}}">
          <view class="multi-img-item" wx:for="{{imageList}}" wx:key="index">
            <image class="multi-img" src="{{item}}" mode="aspectFill" bindtap="previewImageAt" data-idx="{{index}}"></image>
            <view class="multi-img-del" bindtap="removeImage" data-idx="{{index}}">×</view>
          </view>
        </view>
        <text class="field-hint">支持相册或拍照，将上传至服务器</text>
      </view>

      <view class="field">
        <text class="field-label">售价（元）</text>
        <input
          class="field-input"
          type="digit"
          placeholder="如 29.90"
          value="{{priceInput}}"
          bindinput="onPriceInput"
        />
      </view>

      <view class="field">
        <text class="field-label">库存数量</text>
        <view class="step-row">
          <view class="step-btn" bindtap="stockMinus">−</view>
          <input
            class="step-input"
            type="number"
            value="{{stock}}"
            bindinput="onStockInput"
          />
          <view class="step-btn" bindtap="stockPlus">+</view>
        </view>
      </view>

      <view class="field">
        <text class="field-label">安全库存（低库存提醒阈值）</text>
        <input
          class="field-input"
          type="number"
          placeholder="默认 5"
          value="{{safeStock}}"
          bindinput="onSafeInput"
        />
      </view>

      <view class="field">
        <text class="field-label">文字描述</text>
        <textarea
          class="field-textarea"
          placeholder="规格、产地、使用说明等（建议完整填写）"
          value="{{description}}"
          maxlength="500"
          auto-height
          bindinput="onDescInput"
        ></textarea>
        <text class="field-hint">{{descLen}}/500</text>
      </view>

      <button
        class="sheet-btn block primary save-btn"
        loading="{{saving}}"
        disabled="{{saving}}"
        bindtap="save"
      >{{isCreate ? '创建并上架' : '保存'}}</button>
    </view>
  </block>
</view>
