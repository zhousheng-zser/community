@import "../../styles/portal.wxss";

.goods-list-wrap {
  padding-bottom: 12rpx;
}

.goods-shop-banner {
  margin: 12rpx 28rpx 0;
  padding: 18rpx 22rpx;
  background: linear-gradient(90deg, #ecfdf5 0%, #faf6f0 100%);
  border-radius: 16rpx;
  border: 1rpx solid #a7f3d0;
}

.goods-shop-banner-txt {
  font-size: 26rpx;
  color: #166534;
  font-weight: 600;
  line-height: 1.45;
}

.goods-shop-warn {
  margin: 12rpx 28rpx 0;
  padding: 18rpx 22rpx;
  background: #fffbeb;
  border-radius: 16rpx;
  border: 1rpx solid #fcd34d;
}

.goods-shop-warn-txt {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}

.goods-shelf-banner {
  margin: 12rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(90deg, #fef3c7 0%, #faf6f0 100%);
  border-radius: 16rpx;
  border: 1rpx solid #fde68a;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.goods-shelf-banner-txt {
  flex: 1;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.45;
}

.goods-shelf-clear {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #8b6914;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcc9a8;
  background: #fff;
}

.goods-banner {
  margin: 12rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(90deg, #faf6f0 0%, #f0e8d8 100%);
  border-radius: 16rpx;
  border: 1rpx solid #dcc9a8;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.goods-banner-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #8b6914;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.goods-banner-txt {
  flex: 1;
  font-size: 24rpx;
  color: #7c5c1a;
  line-height: 1.5;
}

.goods-card {
  margin: 0 16rpx 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #ebe0d0;
  box-shadow: 0 4rpx 16rpx rgba(90, 70, 35, 0.06);
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.goods-thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: #f0e8d8;
  flex-shrink: 0;
}

.goods-card-warn {
  border-color: #fca5a5;
  background: linear-gradient(180deg, #fff 0%, #faf8f4 100%);
}

.goods-card-main {
  flex: 1;
  min-width: 0;
}

.goods-price-desc {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.goods-price-tag {
  font-size: 28rpx;
  font-weight: 800;
  color: #b45309;
}

.goods-desc-snippet {
  font-size: 22rpx;
  color: #78716c;
  line-height: 1.4;
}

.goods-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.goods-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.4;
}

.goods-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.goods-badge.on {
  background: #ecfdf5;
  color: #047857;
}

.goods-badge.off {
  background: #f5f5f4;
  color: #78716c;
}

.goods-metrics {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
}

.metric {
  display: flex;
  flex-direction: column;
}

.metric-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #8b6914;
}

.metric-val.warn {
  color: #dc2626;
}

.metric-lab {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.metric-tag {
  font-size: 22rpx;
  color: #dc2626;
  background: #fef2f2;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  border: 1rpx solid #fecaca;
}

.goods-switch-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.mg-toolbar {
  padding: 0 28rpx 12rpx;
}

.mg-search {
  display: flex;
  align-items: center;
  padding: 16rpx 22rpx;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid #e8dcc8;
}

.mg-search .search-icon {
  color: #a67c52;
  margin-right: 12rpx;
}

.mg-search .search-input {
  flex: 1;
  font-size: 28rpx;
}

.mg-search .search-clear {
  color: #8b6914;
  font-size: 24rpx;
  padding-left: 12rpx;
}

.mg-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  color: #78716c;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid #e7e5e4;
}

.chip.on {
  background: linear-gradient(135deg, #faf6f0 0%, #f0e8d8 100%);
  color: #7c5c1a;
  border-color: #c4a574;
  font-weight: 600;
}

.goods-actions-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.edit-mini {
  margin: 0;
  font-size: 24rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #faf6f0 0%, #f0e8d8 100%);
  color: #5c4a2a;
  border: 1rpx solid #c4a574;
  border-radius: 999rpx;
}

.restock-mini {
  margin: 0;
  font-size: 24rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  background: #faf6f0;
  color: #7c5c1a;
  border: 1rpx solid #dcc9a8;
  border-radius: 999rpx;
}

