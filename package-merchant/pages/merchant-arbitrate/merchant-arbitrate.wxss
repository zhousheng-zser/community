page {
  background: #f5f5f5;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.arbitrate-page {
  min-height: 100vh;
  padding: 24rpx;
}

.loading-box {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
  width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.info-value.amount {
  color: #e74c3c;
  font-weight: 600;
  font-size: 30rpx;
}

.contact-btn {
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  background: #6b4f2a;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  border: none;
  height: auto;
  line-height: normal;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: flex-end;
}

.evidence-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.chat-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.chat-item:last-child {
  border-bottom: none;
}

.chat-sender {
  font-size: 24rpx;
  color: #6b4f2a;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.chat-time {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.chat-content {
  font-size: 26rpx;
  color: #333;
  display: block;
}

.picker-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.remark-area {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.arbitrate-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #999;
}
