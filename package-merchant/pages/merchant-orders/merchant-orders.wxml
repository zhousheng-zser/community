<view class="portal-page mo-page">
  <view class="mo-mock-banner" wx:if="{{isMock}}">演示模式 · 订单为虚构，不请求后端</view>
  <view class="portal-top merchant-gradient mo-hero">
    <text class="portal-title">店铺订单</text>
    <text class="portal-sub">搜索筛选 · 分状态查看 · 点击卡片处理订单</text>
  </view>

  <view class="mo-summary-strip" wx:if="{{!loading && fullList.length}}">
    <view class="mo-strip-cell">
      <text class="mo-strip-num">{{fullList.length}}</text>
      <text class="mo-strip-lab">全部订单</text>
    </view>
    <view class="mo-strip-divider"></view>
    <view class="mo-strip-cell mo-strip-cell--hint">
      <text class="mo-strip-hint">下拉刷新同步最新状态</text>
    </view>
  </view>

  <view class="search-bar mo-search">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索商品名、订单号、状态"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">清除</text>
  </view>

  <scroll-view class="order-tabs mo-tabs" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
    <view
      class="order-tab {{tabKey === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </scroll-view>

  <view class="portal-card order-list-wrap">
    <view class="card-title-row">
      <text class="card-title-text">订单列表</text>
      <text class="card-summary" wx:if="{{!loading && summaryLine}}">{{summaryLine}}</text>
    </view>
    <block wx:if="{{loading}}">
      <view class="loading-box mo-loading">
        <view class="mo-loading-dot"></view>
        <text>加载订单中…</text>
      </view>
    </block>
    <block wx:elif="{{list.length}}">
      <block wx:for="{{list}}" wx:key="id">
        <view
          class="m-order-card m-order-card--{{item.bucket}}"
          data-no="{{item.orderNo}}"
          bindtap="openDetail"
        >
          <view class="m-order-card-inner">
            <view class="m-order-row1">
              <text class="m-order-no">订单号 {{item.orderNo}}</text>
              <text class="m-pill m-pill--{{item.bucket}}">{{item.statusText}}</text>
            </view>
            <text class="m-order-title">{{item.title}}</text>
            <view class="m-order-row2">
              <view class="m-order-pay">
                <text class="m-order-pay-label">实付金额</text>
                <text class="m-order-pay-val" wx:if="{{item.amount}}">¥{{item.amount}}</text>
                <text class="m-order-pay-val m-order-pay-val--empty" wx:else>—</text>
              </view>
              <text class="m-order-qty" wx:if="{{item.qtyText}}">{{item.qtyText}}</text>
            </view>
            <view class="m-order-row3">
              <view class="m-order-meta-col">
                <text class="m-order-time">{{item.timeDisplay}}</text>
                <text class="m-order-buyer" wx:if="{{item.buyerHint}}">收货人 {{item.buyerHint}}</text>
              </view>
              <view class="m-order-action">
                <text>查看详情</text>
                <text class="m-order-arrow">›</text>
              </view>
            </view>
            <view class="m-order-actions" catchtap="noop">
              <view
                class="m-act"
                data-no="{{item.orderNo}}"
                data-buyer-id="{{item.buyerUserId}}"
                data-buyer-name="{{item.buyerHint}}"
                data-rider-id="{{item.riderUserId}}"
                data-rider-name="{{item.riderName}}"
                bindtap="contactBuyer"
              >联系买家</view>
              <view
                class="m-act"
                data-no="{{item.orderNo}}"
                data-rider-id="{{item.riderUserId}}"
                data-rider-name="{{item.riderName}}"
                bindtap="contactRider"
              >联系骑手</view>
              <view class="m-act m-act--ghost" data-no="{{item.orderNo}}" bindtap="openRiderLocation">骑手位置</view>
            </view>
          </view>
        </view>
      </block>
    </block>
    <view class="empty-wrap mo-empty" wx:else>
      <view class="mo-empty-illu">
        <image class="empty-icon" src="/img/my_orders/market_order.png" mode="aspectFit"></image>
      </view>
      <view class="empty-title">暂无订单</view>
      <view class="empty-tip">{{emptyTip}}</view>
    </view>
  </view>

  <view class="portal-tabbar pt-bar-4">
    <view class="pt-item" bindtap="goHome">
      <image class="pt-ico" src="/img/home-0.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="pt-item" bindtap="goService">
      <image class="pt-ico" src="/img/other_services/platform_service.png" mode="aspectFit"></image>
      <text class="pt-text-nowrap">客服与售后</text>
    </view>
    <view class="pt-item pt-on">
      <image class="pt-ico" src="/img/order-1.png" mode="aspectFit"></image>
      <text>订单</text>
    </view>
    <view class="pt-item" bindtap="goMine">
      <image class="pt-ico" src="/img/user-0.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
