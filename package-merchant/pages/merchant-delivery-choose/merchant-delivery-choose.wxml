<view class="page">
  <view class="head">
    <text class="title">选择配送方式</text>
    <text class="sub">订单号 {{orderNo}}</text>
    <text class="mock-tip" wx:if="{{mockMode}}">当前为演示模式（未配置美团/饿了么密钥时将模拟配送进度）</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view class="list" wx:else>
    <view
      class="item {{selected === item.code ? 'active' : ''}}"
      wx:for="{{providers}}"
      wx:key="code"
      bindtap="onSelect"
      data-code="{{item.code}}"
    >
      <text class="icon">{{item.icon}}</text>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="desc">{{item.desc}}</text>
      </view>
      <text class="check" wx:if="{{selected === item.code}}">✓</text>
    </view>
  </view>

  <view class="footer">
    <button class="btn secondary" bindtap="viewTrack" wx:if="{{currentCarrier}}">查看配送进度</button>
    <button class="btn primary" bindtap="onConfirm" loading="{{submitting}}" disabled="{{submitting}}">
      确认发起配送
    </button>
  </view>
</view>
