.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 24rpx 200rpx;
  box-sizing: border-box;
}
.head { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: 700; display: block; color: #111; }
.sub { font-size: 24rpx; color: #888; margin-top: 8rpx; display: block; }
.mock-tip { font-size: 22rpx; color: #ff7a00; margin-top: 12rpx; display: block; }
.loading { text-align: center; padding: 80rpx; color: #999; }
.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}
.item.active { border-color: #ff7a00; background: #fff8f0; }
.icon { font-size: 48rpx; margin-right: 20rpx; }
.info { flex: 1; }
.name { font-size: 30rpx; font-weight: 600; display: block; }
.desc { font-size: 24rpx; color: #888; margin-top: 8rpx; display: block; }
.check { font-size: 36rpx; color: #ff7a00; }
.footer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.btn { margin-bottom: 16rpx; border-radius: 48rpx; font-size: 30rpx; }
.btn.primary { background: #ff7a00; color: #fff; }
.btn.secondary { background: #f0f0f0; color: #333; }
