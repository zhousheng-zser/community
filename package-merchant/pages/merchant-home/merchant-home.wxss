@import "../../styles/portal.wxss";

.mh-hero {
  padding-top: 28rpx;
}

.mh-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.mh-avatar,
.hero-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.15);
  display: block;
}

.avatar-edit-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.hero-cover-strip {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  height: 128rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.12);
}

.hero-cover-img {
  width: 100%;
  height: 100%;
}

.cover-edit-badge {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.42);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.mh-text {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.mh-greet {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.mh-sub {
  margin-top: 8rpx !important;
}

.mh-title {
  font-size: 36rpx !important;
  position: relative;
  z-index: 1;
}

.mh-stat {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 28rpx 0;
  padding: 24rpx 16rpx;
  background: linear-gradient(180deg, #faf6f0 0%, #f0e8d8 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 36rpx rgba(90, 70, 35, 0.1);
  border: 1rpx solid #dcc9a8;
  gap: 16rpx 0;
}

.mh-stat-item {
  width: 50%;
  text-align: center;
  padding: 12rpx 0;
}

.mh-stat-item.warn .mh-stat-num {
  color: #dc2626;
}

.mh-stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #8b6914;
}

.mh-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #78716c;
}

.demo-order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 28rpx 0;
  padding: 22rpx 28rpx;
  background: #faf6f0;
  border-radius: 16rpx;
  border: 1rpx solid #dcc9a8;
}

.demo-order-row:active {
  opacity: 0.88;
}

.demo-order-label {
  font-size: 28rpx;
  color: #7c5c1a;
  font-weight: 600;
}

.demo-order-go {
  font-size: 26rpx;
  color: #8b6914;
  font-weight: 600;
}

.mh-section {
  margin-top: 8rpx;
}

.mh-link-list {
  padding: 0 8rpx 16rpx;
}

.mh-link-item {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(180deg, #faf6f0 0%, #f5f0e8 100%);
  border: 1rpx solid #ede6d8;
}

.mh-link-item:active {
  opacity: 0.9;
}

.mh-link-ico {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.mh-link-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.mh-link-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #5c4518;
}

.mh-link-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #78716c;
  line-height: 1.4;
}

.mh-link-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #a8a29e;
  font-weight: 300;
  margin-left: 12rpx;
}
