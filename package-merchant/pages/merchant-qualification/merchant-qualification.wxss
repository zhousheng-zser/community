@import "../../styles/portal.wxss";

page {
  background: #f5f0e8;
}

.qua-page {
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.loading-box {
  padding: 120rpx 0;
  text-align: center;
  color: #78716c;
  font-size: 28rpx;
}

.section {
  margin: 0 24rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5c4518;
  margin-bottom: 14rpx;
}

.kv-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0e7d7;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-key {
  width: 190rpx;
  color: #78716c;
  font-size: 26rpx;
}

.kv-val {
  flex: 1;
  color: #3f3f46;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.multiline .kv-val {
  white-space: pre-wrap;
}

.img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.img-item {
  position: relative;
}

.img {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
  background: #e7dfd0;
}

.img-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #78716c;
  text-align: center;
}

.field-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

.sheet-btn {
  margin: 0;
  font-size: 28rpx;
  border-radius: 16rpx;
  line-height: 80rpx;
}

.sheet-btn.primary {
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  color: #fff;
}

.sheet-btn.ghost {
  margin-top: 16rpx;
  background: #faf8f4;
  color: #8b6914;
  border: 1rpx solid #dcc9a8;
}

.actions {
  margin-bottom: 30rpx;
}
