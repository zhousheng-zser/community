@import "../../styles/portal.wxss";

.mm-profile {
  margin: 0 0 16rpx;
  padding: 48rpx 32rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(90, 70, 35, 0.28);
}

.mm-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.45);
  margin-bottom: 20rpx;
}

.mm-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.mm-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.mm-balance-box {
  margin-top: 24rpx;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mm-balance-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 8rpx;
}

.mm-balance-amount {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}
