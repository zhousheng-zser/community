<view class="sp-home-page">
  <view class="sp-header">
    <image class="sp-avatar" src="{{userPhoto}}" mode="aspectFill" />
    <view class="sp-info">
      <text class="sp-greeting">{{greeting}}，{{displayName}}</text>
      <text class="sp-role">服务商工作台</text>
    </view>
    <view class="sp-balance-box">
      <text class="sp-balance-label">服务商结算</text>
      <text class="sp-balance-amount">¥{{balanceText}}</text>
    </view>
  </view>

  <view class="sp-banner {{spOk ? 'sp-ok' : 'sp-warn'}}" style="margin:12px;padding:10px 14px;background:{{spOk ? '#e8f5e9' : '#fff3e0'}};border-radius:8px;">
    <text style="font-size:13px;color:{{spOk ? '#2e7d32' : '#e65100'}};">{{bannerText}}</text>
    <view class="sp-go-join" wx:if="{{!spOk}}" bindtap="goJoin" style="margin-top:8px;">
      <button class="sp-btn" style="background:#ff9800;color:#fff;border:none;padding:8px 16px;border-radius:6px;font-size:13px;">去入驻</button>
    </view>
  </view>

  <view class="sp-stats">
    <view class="sp-stat-item">
      <text class="sp-stat-num">{{stats.pendingOrders}}</text>
      <text class="sp-stat-label">待接单</text>
    </view>
    <view class="sp-stat-item">
      <text class="sp-stat-num">{{stats.dispatching}}</text>
      <text class="sp-stat-label">派单中</text>
    </view>
    <view class="sp-stat-item">
      <text class="sp-stat-num">{{stats.inProgress}}</text>
      <text class="sp-stat-label">服务中</text>
    </view>
    <view class="sp-stat-item">
      <text class="sp-stat-num">{{stats.completed}}</text>
      <text class="sp-stat-label">已完成</text>
    </view>
  </view>

  <view class="sp-menu">
    <view class="sp-menu-item" bindtap="goOrders">
      <image class="sp-menu-icon" src="/img/order-0.png" mode="aspectFit" />
      <text class="sp-menu-text">服务订单</text>
    </view>
    <view class="sp-menu-item" bindtap="goDispatch">
      <image class="sp-menu-icon" src="/img/dispatch.png" mode="aspectFit" />
      <text class="sp-menu-text">派单管理</text>
    </view>
    <view class="sp-menu-item" bindtap="goServices">
      <image class="sp-menu-icon" src="/img/service.png" mode="aspectFit" />
      <text class="sp-menu-text">服务项目</text>
    </view>
    <view class="sp-menu-item" bindtap="goMine">
      <image class="sp-menu-icon" src="/img/user-0.png" mode="aspectFit" />
      <text class="sp-menu-text">账户中心</text>
    </view>
  </view>

  <view class="sp-back-btn" bindtap="backUser">返回用户端</view>
</view>
