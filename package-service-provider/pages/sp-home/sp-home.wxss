page {
  background: #f5f5f5;
}

.sp-home-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.sp-header {
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  padding: 40rpx 32rpx 48rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.sp-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-right: 24rpx;
}

.sp-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sp-greeting {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.sp-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.sp-balance-box {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  text-align: right;
}

.sp-balance-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.sp-balance-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-top: 4rpx;
}

.sp-stats {
  display: flex;
  background: #fff;
  margin: -24rpx 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.sp-stat-item {
  flex: 1;
  text-align: center;
  position: relative;
}

.sp-stat-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: #f0f0f0;
}

.sp-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #6b4f2a;
  display: block;
}

.sp-stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.sp-menu {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx;
}

.sp-menu-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.sp-menu-item:active {
  opacity: 0.8;
}

.sp-menu-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
}

.sp-menu-text {
  font-size: 28rpx;
  color: #333;
}

.sp-back-btn {
  margin: 40rpx 24rpx 0;
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #999;
}
