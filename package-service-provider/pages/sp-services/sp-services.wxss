page { background: #f5f5f5; padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.sp-services-page { min-height: 100vh; }
.page-header { padding: 24rpx; background: #fff; }
.search-box { display: flex; align-items: center; background: #f5f5f5; border-radius: 32rpx; padding: 0 24rpx; height: 72rpx; }
.search-input { flex: 1; font-size: 28rpx; }
.clear-btn { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 32rpx; color: #999; }
.summary-bar { padding: 16rpx 24rpx; background: #fef9f0; font-size: 24rpx; color: #6b4f2a; }
.loading-box, .empty-box { text-align: center; padding: 120rpx 0; color: #999; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; }
.service-list { padding: 24rpx; }
.service-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.service-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 12rpx; }
.service-meta { display: flex; gap: 20rpx; margin-bottom: 12rpx; }
.service-category { font-size: 24rpx; color: #6b4f2a; background: #fef3e2; padding: 4rpx 12rpx; border-radius: 4rpx; }
.service-duration { font-size: 24rpx; color: #999; }
.service-price { font-size: 32rpx; color: #e74c3c; font-weight: 600; margin-bottom: 12rpx; }
.service-actions { display: flex; justify-content: space-between; align-items: center; }
.shelf-switch { display: flex; align-items: center; gap: 12rpx; }
.shelf-label { font-size: 24rpx; color: #666; }
.edit-btn { padding: 8rpx 24rpx; background: #6b4f2a; color: #fff; font-size: 24rpx; border-radius: 8rpx; }
.add-btn-wrapper { padding: 24rpx; position: fixed; bottom: calc(120rpx + env(safe-area-inset-bottom)); left: 0; right: 0; }
.add-btn { width: 100%; height: 88rpx; line-height: 88rpx; background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%); color: #fff; font-size: 32rpx; font-weight: 600; border-radius: 44rpx; border: none; }
.sp-tabbar { position: fixed; bottom: 0; left: 0; right: 0; height: calc(100rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: #fff; display: flex; justify-content: space-around; align-items: center; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); }
.sp-tabbar-item { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #999; }
.sp-tabbar-on { color: #6b4f2a; }
.sp-tabbar-icon { width: 40rpx; height: 40rpx; margin-bottom: 4rpx; }
