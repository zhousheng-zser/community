<view class="portal-page">
  <view class="portal-top merchant-gradient" style="padding-bottom: 28rpx;">
    <text class="portal-title">服务项目管理</text>
    <text class="portal-sub" wx:if="{{shelfMode === 'up'}}">待上架：已下架服务，打开开关即可上架</text>
    <text class="portal-sub" wx:elif="{{shelfMode === 'down'}}">在售服务：关闭开关即可下架</text>
    <text class="portal-sub" wx:else>搜索 · 排序 · 上下架管理</text>
  </view>

  <view class="svc-shelf-banner" wx:if="{{shelfMode}}">
    <text class="svc-shelf-banner-txt">
      {{shelfMode === 'up' ? '以下仅展示已下架服务，可在右侧开关上架' : '以下仅展示在售服务，可在右侧开关下架'}}
    </text>
    <text class="svc-shelf-clear" bindtap="clearShelfMode">查看全部</text>
  </view>

  <view class="goods-banner" wx:if="{{summaryText}}">
    <text class="goods-banner-icon">i</text>
    <text class="goods-banner-txt">{{summaryText}}</text>
  </view>

  <view class="mg-toolbar">
    <view class="mg-create-row">
      <button class="create-btn" size="mini" bindtap="goAdd">新增服务并上架</button>
    </view>
    <view class="search-bar mg-search">
      <text class="search-icon">⌕</text>
      <input class="search-input" type="text" placeholder="搜索服务名称或分类" value="{{keyword}}" bindinput="onSearchInput" />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">清除</text>
    </view>
    <view class="mg-filters">
      <view class="chip {{sortMode === 'sales' ? 'on' : ''}}" data-mode="sales" bindtap="setSort">按预约量</view>
      <view class="chip {{sortMode === 'price' ? 'on' : ''}}" data-mode="price" bindtap="setSort">按价格</view>
    </view>
  </view>

  <view class="portal-card svc-list-wrap">
    <view class="card-title">服务列表</view>
    <block wx:if="{{loading}}">
      <view class="loading-box">加载中…</view>
    </block>
    <block wx:elif="{{list.length}}">
      <block wx:for="{{list}}" wx:key="id">
        <view class="goods-card">
          <image class="goods-thumb" src="{{item.hasImage ? item.mainImage : '/img/join_services/service_provider.png'}}" mode="aspectFill"></image>
          <view class="goods-card-main">
            <view class="goods-card-head">
              <text class="goods-card-title">{{item.title}}</text>
              <text class="goods-badge {{item.onShelf ? 'on' : 'off'}}">{{item.onShelf ? '在售' : '已下架'}}</text>
            </view>
            <view class="goods-price-desc">
              <text class="goods-price-tag">{{item.priceText}}/{{item.unit}}</text>
              <text class="goods-desc-snippet" wx:if="{{item.descShort}}">{{item.descShort}}</text>
            </view>
            <view class="goods-metrics">
              <view class="metric">
                <text class="metric-val">{{item.sales}}</text>
                <text class="metric-lab">预约次数</text>
              </view>
              <view class="metric">
                <text class="metric-val" style="color:#6b4f2a;">{{item.category}}</text>
                <text class="metric-lab">分类</text>
              </view>
            </view>
            <view class="goods-actions-row">
              <button class="edit-mini" size="mini" data-id="{{item.id}}" bindtap="goEdit">编辑资料</button>
            </view>
          </view>
          <view class="goods-switch-wrap">
            <switch checked="{{item.onShelf}}" data-id="{{item.id}}" data-on="{{item.onShelf}}" bindchange="onShelfChange" color="#9a7340" />
          </view>
        </view>
      </block>
    </block>
    <view class="empty-wrap" wx:else>
      <image class="empty-icon" src="/img/join_services/service_provider.png" mode="aspectFit"></image>
      <view class="empty-title">暂无服务项目</view>
      <view class="empty-tip">{{emptyTip}}</view>
      <button class="create-btn empty-create-btn" size="mini" bindtap="goAdd">去新增服务</button>
    </view>
  </view>

  <view class="portal-tabbar pt-bar-4">
    <view class="pt-item" bindtap="goHome">
      <image class="pt-ico" src="/img/home-0.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="pt-item" bindtap="goOrders">
      <image class="pt-ico" src="/img/order-0.png" mode="aspectFit"></image>
      <text>订单</text>
    </view>
    <view class="pt-item pt-on">
      <image class="pt-ico" src="/img/join_services/service_provider.png" mode="aspectFit"></image>
      <text>服务</text>
    </view>
    <view class="pt-item" bindtap="goMine">
      <image class="pt-ico" src="/img/user-0.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
