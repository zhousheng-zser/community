.qual-page { background: #f5f5f5; min-height: 100vh; padding-bottom: 60rpx; }
.loading-tip { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
.card { background: #fff; margin: 20rpx 0 0; padding: 32rpx; }
.card-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 24rpx; border-left: 6rpx solid #07c160; padding-left: 16rpx; }
.info-row { display: flex; flex-direction: row; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.info-row:last-of-type { border-bottom: none; }
.info-label { font-size: 28rpx; color: #666; width: 160rpx; flex-shrink: 0; }
.info-value { font-size: 28rpx; color: #333; flex: 1; }
.info-value.active { color: #07c160; }
.info-value.pending { color: #f39c12; }
.info-value.rejected { color: #e74c3c; }
.edit-btn { margin-top: 24rpx; background: #f0f9f0; color: #07c160; border: 1rpx solid #b7e4c7; border-radius: 12rpx; font-size: 28rpx; height: 72rpx; line-height: 72rpx; }
.cert-row { margin-bottom: 28rpx; }
.cert-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 12rpx; }
.cert-img { width: 240rpx; height: 160rpx; border-radius: 12rpx; object-fit: cover; }
.img-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.thumb { width: 160rpx; height: 120rpx; border-radius: 10rpx; }
.no-cert { text-align: center; color: #bbb; font-size: 26rpx; padding: 40rpx 0; }
.rejoin-btn { background: #e74c3c; color: #fff; border-radius: 12rpx; font-size: 30rpx; height: 80rpx; line-height: 80rpx; }
