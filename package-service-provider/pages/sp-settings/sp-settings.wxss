.settings-page { background: #f5f5f5; min-height: 100vh; box-sizing: border-box; padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.loading-tip { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }
.section { background: #fff; margin: 20rpx 0 0; padding: 28rpx 32rpx; }
.section-label { font-size: 28rpx; color: #333; font-weight: 500; margin-bottom: 16rpx; }
.section-label.required::before { content: '*'; color: #e74c3c; margin-right: 6rpx; }
.field-input { width: 100%; min-height: 88rpx; border: 1rpx solid #e0e0e0; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; line-height: 1.4; color: #333; box-sizing: border-box; background: #fafafa; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.08); z-index: 20; }
.save-btn { display: block; width: 100%; background: #07c160; color: #fff; border-radius: 16rpx; font-size: 32rpx; font-weight: 600; height: 88rpx; line-height: 88rpx; }
.save-btn[disabled] { background: #b2dfca; }
