<view class="sp-orders-page">
  <view class="sp-tabs">
    <view class="sp-tab-item {{activeTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
    <view class="sp-tab-item {{activeTab === 'pending_accept' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending_accept">待接单</view>
    <view class="sp-tab-item {{activeTab === 'dispatching' ? 'active' : ''}}" bindtap="switchTab" data-tab="dispatching">派单中</view>
    <view class="sp-tab-item {{activeTab === 'in_progress' ? 'active' : ''}}" bindtap="switchTab" data-tab="in_progress">服务中</view>
    <view class="sp-tab-item {{activeTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-tab="completed">已完成</view>
  </view>

  <view class="sp-order-list" wx:if="{{orders.length > 0}}">
    <view class="sp-order-card" wx:for="{{orders}}" wx:key="id">
      <view class="sp-order-header" bindtap="viewOrderDetail" data-id="{{item.id}}">
        <text class="sp-order-no">{{item.orderNo}}</text>
        <text class="sp-order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>
      <view class="sp-order-body" bindtap="viewOrderDetail" data-id="{{item.id}}">
        <text class="sp-order-title">{{item.serviceTitle}}</text>
        <view class="sp-order-row">
          <text class="sp-order-label">预约时间</text>
          <text class="sp-order-value">{{item.bookTime || '—'}}</text>
        </view>
        <view class="sp-order-row">
          <text class="sp-order-label">客户</text>
          <text class="sp-order-value">{{item.contactName || '—'}}</text>
        </view>
        <view class="sp-order-row">
          <text class="sp-order-label">技工</text>
          <text class="sp-order-value">{{item.workerName || '待派单'}}</text>
        </view>
        <view class="sp-order-row">
          <text class="sp-order-label">金额</text>
          <text class="sp-order-value sp-order-amount">¥{{item.amount}}</text>
        </view>
      </view>
      <!-- 操作按钮区 -->
      <view class="sp-order-actions" catchtap="noop">
        <block wx:if="{{item.status === 'pending_accept'}}">
          <view class="sp-act sp-act--primary" data-id="{{item.id}}" bindtap="acceptOrder">接单</view>
          <view class="sp-act sp-act--danger" data-id="{{item.id}}" bindtap="rejectOrder">拒单</view>
        </block>
        <block wx:elif="{{item.status === 'paid_pending_dispatch' || item.status === 'dispatched'}}">
          <view class="sp-act sp-act--primary" data-id="{{item.id}}" bindtap="checkIn">到达打卡</view>
        </block>
        <block wx:elif="{{item.status === 'in_service'}}">
          <view class="sp-act sp-act--primary" data-id="{{item.id}}" bindtap="completeWithEvidence">完成服务（拍照）</view>
        </block>
        <block wx:elif="{{item.status === 'pending_user_confirm'}}">
          <text class="sp-act-hint">等待用户确认完成</text>
        </block>
      </view>
    </view>
  </view>

  <view class="sp-empty" wx:elif="{{!loading}}">
    <text>暂无订单数据</text>
  </view>

  <view class="sp-loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view class="sp-tabbar">
    <view class="sp-tabbar-item" bindtap="goHome">
      <image class="sp-tabbar-icon" src="/img/home-0.png" mode="aspectFit" />
      <text>首页</text>
    </view>
    <view class="sp-tabbar-item sp-tabbar-on">
      <image class="sp-tabbar-icon" src="/img/order-0.png" mode="aspectFit" />
      <text>订单</text>
    </view>
    <view class="sp-tabbar-item" bindtap="goDispatch">
      <image class="sp-tabbar-icon" src="/img/dispatch.png" mode="aspectFit" />
      <text>派单</text>
    </view>
    <view class="sp-tabbar-item" bindtap="goServices">
      <image class="sp-tabbar-icon" src="/img/service.png" mode="aspectFit" />
      <text>服务</text>
    </view>
    <view class="sp-tabbar-item" bindtap="goMine">
      <image class="sp-tabbar-icon" src="/img/user-0.png" mode="aspectFit" />
      <text>我的</text>
    </view>
  </view>
</view>
