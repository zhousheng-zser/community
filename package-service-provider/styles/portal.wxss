/* 商家端 · 工作台通用样式 */

page {
  background: #f5f0e8;
}

.portal-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ede6d8 0%, #f5f0e8 16%, #f5f0e8 100%);
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.portal-top {
  padding: 36rpx 32rpx 44rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.portal-top::after {
  content: '';
  position: absolute;
  right: -50rpx;
  top: -30rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.merchant-gradient {
  background: linear-gradient(135deg, #6b4f2a 0%, #8b6914 42%, #c4a574 100%);
  box-shadow: 0 12rpx 40rpx rgba(90, 70, 35, 0.38);
}

.portal-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.portal-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  opacity: 0.95;
  position: relative;
  z-index: 1;
  line-height: 1.45;
}

.portal-banner {
  margin: 20rpx 28rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.55;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.banner-warn {
  background: linear-gradient(180deg, #fffbeb 0%, #fef3c7 100%);
  color: #92400e;
  border: 1rpx solid #fcd34d;
}

.banner-ok {
  background: linear-gradient(180deg, #faf6f0 0%, #f0e8d8 100%);
  color: #7c5c1a;
  border: 1rpx solid #dcc9a8;
}

.portal-card {
  margin: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 8rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  padding: 24rpx 20rpx 12rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #8b6914, #c4a574);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

/* 经营中心：通栏列表 + 大图标（与技工端常用功能一致） */
.grid-2 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 16rpx 20rpx;
}

.grid-btn {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 24rpx 28rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #faf8f4 0%, #f5efe6 100%);
  text-align: left;
  border: 1rpx solid #ebe0d0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.grid-btn:active {
  transform: scale(0.99);
  opacity: 0.96;
}

.grid-btn-icon {
  width: 120rpx;
  min-width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f0e4d4 0%, #dcc9a8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.grid-btn-icon image {
  width: 76rpx;
  height: 76rpx;
}

.grid-btn-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.grid-btn-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.grid-btn-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #78716c;
  line-height: 1.4;
}

.grid-btn-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #d6d3d1;
  font-weight: 300;
  line-height: 1;
}

.back-user {
  margin: 8rpx 28rpx 8rpx;
  padding: 24rpx 28rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: #8b6914;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(139, 105, 20, 0.14);
  border: 1rpx solid #e0d0b8;
}

.back-user:active {
  opacity: 0.92;
}

.portal-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e8ecf1;
  z-index: 100;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

/* 四栏：首页 | 客服与售后 | 订单 | 我的 */
.portal-tabbar.pt-bar-4 {
  height: 118rpx;
}

.portal-tabbar.pt-bar-4 .pt-item {
  font-size: 19rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.portal-tabbar.pt-bar-4 .pt-ico {
  width: 44rpx;
  height: 44rpx;
}

.pt-text-nowrap {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.pt-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.pt-item.pt-on {
  color: #8b6914;
  font-weight: 700;
}

.pt-ico {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.m-order-card {
  margin: 0 16rpx 20rpx;
  padding: 24rpx;
  background: linear-gradient(180deg, #ffffff 0%, #faf8f4 100%);
  border-radius: 20rpx;
  border: 1rpx solid #ebe0d0;
  box-shadow: 0 4rpx 16rpx rgba(90, 70, 35, 0.08);
}

.m-order-card:active {
  background: #f5efe6;
}

.m-order-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.m-order-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.4;
}

.m-pill {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f5ebe0;
  color: #8b6914;
  font-weight: 600;
}

.m-order-meta {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e8ecf1;
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.m-order-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
}

.empty-wrap {
  padding: 56rpx 40rpx 64rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #78716c;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #a8a29e;
  line-height: 1.55;
}

.loading-box {
  padding: 80rpx;
  text-align: center;
  color: #a8a29e;
  font-size: 28rpx;
}

.mine-block {
  padding: 0 8rpx 12rpx;
}

.mine-row {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  margin: 0 8rpx 12rpx;
  background: #faf8f4;
  border-radius: 16rpx;
  border: 1rpx solid #ebe0d0;
}

.mine-row:active {
  background: #f5efe6;
}

.mine-label {
  flex: 1;
  font-size: 28rpx;
  color: #44403c;
  font-weight: 500;
}

.mine-arrow {
  color: #d6d3d1;
  font-size: 32rpx;
}
