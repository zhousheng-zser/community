<view class="portal-page">
  <view class="portal-top worker-gradient" style="padding-bottom: 24rpx;">
    <text class="portal-title">技工订单</text>
    <text class="portal-sub">搜索 · 分状态筛选 · 进详情履约</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      type="text"
      placeholder="搜索标题、订单号、状态"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <text class="search-clear" wx:if="{{keyword}}" bindtap="clearSearch">清除</text>
  </view>

  <scroll-view class="order-tabs" scroll-x="true" enable-flex="true" show-scrollbar="{{false}}">
    <view
      class="order-tab {{tabKey === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </scroll-view>

  <view class="portal-card order-list-card">
    <view class="card-title">订单列表</view>
    <block wx:if="{{loading}}">
      <view class="loading-box">加载中…</view>
    </block>
    <block wx:elif="{{list.length}}">
      <block wx:for="{{list}}" wx:key="id">
        <view class="order-card" data-id="{{item.id}}" bindtap="openDetail">
          <view class="order-card-top">
            <text class="order-card-title">{{item.title}}</text>
            <view class="status-pill pill--{{item.bucket}}">{{item.statusText}}</view>
          </view>
          <view class="order-card-meta">
            <text>{{item.time || '—'}}</text>
            <text class="order-card-arrow">›</text>
          </view>
        </view>
      </block>
    </block>
    <view class="empty-wrap" wx:else>
      <image class="empty-icon" src="/img/my_orders/service_order.png" mode="aspectFit"></image>
      <view class="empty-title">暂无订单</view>
      <view class="empty-tip">{{emptyTip}}</view>
    </view>
  </view>

  <view class="portal-tabbar">
    <view class="pt-item" bindtap="goHome">
      <image class="pt-ico" src="/img/home-0.png" mode="aspectFit"></image>
      <text>首页</text>
    </view>
    <view class="pt-item pt-on">
      <image class="pt-ico" src="/img/order-1.png" mode="aspectFit"></image>
      <text>订单</text>
    </view>
    <view class="pt-item" bindtap="goMine">
      <image class="pt-ico" src="/img/user-0.png" mode="aspectFit"></image>
      <text>我的</text>
    </view>
  </view>
</view>
