@import "../../styles/portal.wxss";

.hero-worker {
  padding-top: 28rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.hero-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.hero-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.2);
  display: block;
}

.hero-cover-strip {
  position: relative;
  z-index: 1;
  margin-top: 24rpx;
  height: 128rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.12);
}

.hero-cover-img {
  width: 100%;
  height: 100%;
}

.cover-edit-badge {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.42);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.hero-text {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.hero-greet {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 8rpx !important;
  opacity: 0.95 !important;
}

.hero-title {
  font-size: 36rpx !important;
  position: relative;
  z-index: 1;
}

.stat-board {
  display: flex;
  margin: 16rpx 28rpx 0;
  padding: 28rpx 12rpx;
  background: linear-gradient(180deg, #faf6f0 0%, #f0e8d8 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 36rpx rgba(90, 70, 35, 0.1);
  border: 1rpx solid #dcc9a8;
}

.stat-cell {
  flex: 1;
  text-align: center;
  position: relative;
}

.stat-cell:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1rpx;
  background: #e8ecf1;
}

.stat-tap:active {
  opacity: 0.75;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #8b6914;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.stat-hint {
  margin: 16rpx 32rpx 0;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  color: #b91c1c;
  background: #fef2f2;
  border-radius: 12rpx;
  border: 1rpx solid #fecaca;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.demo-order-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 28rpx 0;
  padding: 22rpx 28rpx;
  background: #faf6f0;
  border-radius: 16rpx;
  border: 1rpx solid #dcc9a8;
}

.demo-order-row:active {
  opacity: 0.88;
}

.demo-order-label {
  font-size: 28rpx;
  color: #7c5c1a;
  font-weight: 600;
}

.demo-order-go {
  font-size: 26rpx;
  color: #8b6914;
  font-weight: 600;
}

.income-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 28rpx 0;
  padding: 28rpx 32rpx;
  background: linear-gradient(90deg, #ffffff 0%, #faf6f0 100%);
  border-radius: 20rpx;
  border: 1rpx solid #dcc9a8;
  box-shadow: 0 6rpx 24rpx rgba(90, 70, 35, 0.1);
}

.income-strip:active {
  opacity: 0.92;
}

.income-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.income-val {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #8b6914;
  font-variant-numeric: tabular-nums;
}

.income-go {
  font-size: 26rpx;
  color: #8b6914;
  font-weight: 600;
}

.hint-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ef4444;
  flex-shrink: 0;
}

