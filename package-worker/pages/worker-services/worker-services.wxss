.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
}
.page-header {
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
}
.page-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.toolbar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}
.btn-primary {
  background: #000000;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
}
.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.form-row {
  margin-bottom: 20rpx;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}
.form-input,
.form-textarea {
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.form-textarea {
  height: 160rpx;
}
.form-actions {
  display: flex;
  justify-content: flex-end;
}
.btn-save {
  background: #000000;
  color: #fff;
  padding: 16rpx 48rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.service-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.service-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.service-info {
  flex: 1;
}
.service-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
}
.service-price {
  font-size: 28rpx;
  color: #e74c3c;
  margin-top: 8rpx;
  display: block;
}
.service-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.service-actions {
  display: flex;
  gap: 24rpx;
  margin-left: 16rpx;
}
.action-edit {
  color: #FF7A00;
  font-size: 26rpx;
}
.action-delete {
  color: #e74c3c;
  font-size: 26rpx;
}
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

