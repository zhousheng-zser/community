@import "../../styles/portal.wxss";

.wm-profile {
  margin: 0 0 16rpx;
  padding: 48rpx 32rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(90, 70, 35, 0.28);
}

.wm-avatar-wrap {
  position: relative;
  margin-bottom: 20rpx;
}

.wm-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 70rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.45);
  display: block;
}

.wm-avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.wm-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.wm-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.wm-switch-card .switch-row {
  padding: 8rpx 16rpx 20rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.switch-info {
  flex: 1;
  min-width: 0;
}

.switch-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.switch-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.45;
}
