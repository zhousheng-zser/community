@import "../../styles/portal.wxss";

page {
  background: #f5f0e8;
  height: 100%;
}

.detail-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f0e8;
}

.mock-banner {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #92400e;
  background: #fef3c7;
  border-bottom: 1rpx solid #fde68a;
  text-align: center;
}

.detail-scroll {
  flex: 1;
  height: 0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail-hero {
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(90, 70, 35, 0.28);
}

.detail-hero-inner {
  position: relative;
  z-index: 1;
}

.detail-pill {
  display: inline-block;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.detail-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.4;
}

.detail-no-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.detail-hero-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.detail-copy {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.detail-amount {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.detail-sheet {
  margin: -24rpx 24rpx 0;
  position: relative;
  z-index: 2;
}

.sheet-section {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid #f1f5f9;
}

.sheet-head {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.sheet-icon {
  font-size: 22rpx;
  color: #8b6914;
  margin-right: 10rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.sheet-body {
  padding: 20rpx 28rpx 28rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8fafc;
  font-size: 26rpx;
}

.kv:last-of-type {
  border-bottom: none;
}

.kv .k {
  color: #94a3b8;
  flex-shrink: 0;
  width: 160rpx;
}

.kv .v {
  flex: 1;
  text-align: right;
  color: #334155;
  font-weight: 500;
  word-break: break-all;
}

.row-phone {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.link-btn {
  margin: 0;
  font-size: 22rpx;
  padding: 0 16rpx;
  line-height: 48rpx;
  background: #f5ebe0;
  color: #8b6914;
}

.addr-block {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.addr-label {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 8rpx;
}

.addr-text {
  font-size: 28rpx;
  color: #1e293b;
  line-height: 1.5;
}

.btn-row-2 {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-row-3 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sheet-btn {
  margin: 0;
  font-size: 28rpx;
  border-radius: 16rpx;
  line-height: 88rpx;
  padding: 0;
}

.sheet-btn.block {
  width: 100%;
}

.sheet-btn.primary {
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  color: #fff;
}

.sheet-btn.ghost {
  background: #faf8f4;
  color: #8b6914;
  border: 1rpx solid #dcc9a8;
}

.addon-btn {
  margin-top: 24rpx;
  width: 100%;
  font-size: 26rpx;
  line-height: 80rpx;
  background: linear-gradient(180deg, #fffbeb 0%, #fef3c7 100%);
  color: #b45309;
  border: 1rpx solid #fcd34d;
  border-radius: 16rpx;
}

.photo-strip {
  margin-top: 20rpx;
}

.photo-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin: 12rpx 0 8rpx;
}

.photo-grid-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ph2 {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #e8ecf1;
}

.call-big {
  margin: 20rpx 0 8rpx;
  width: 100%;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #fff;
  border: none;
}

.call-big::after {
  border: none;
}

.chat-customer-btn {
  margin-top: 16rpx;
}

.hint-txt {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.sheet-serve .serve-hint {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #faf8f4;
  border-radius: 12rpx;
  border-left: 6rpx solid #8b6914;
}

.serve-item {
  margin-bottom: 32rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.serve-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
}

.serve-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.serve-item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.serve-item-tag {
  font-size: 22rpx;
  color: #16a34a;
  font-weight: 600;
}

.serve-item-desc {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  line-height: 1.45;
}

.detail-spacer {
  height: 32rpx;
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e8ecf1;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 50;
}

.safe-bottom {
  box-sizing: border-box;
}

.foot-btn {
  flex: 1;
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  line-height: 92rpx;
  padding: 0;
}

.foot-btn.full {
  flex: 1;
}

.foot-btn.primary {
  background: linear-gradient(135deg, #6b4f2a 0%, #9a7340 100%);
  color: #fff;
}

.foot-btn.danger {
  background: #fff;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}
