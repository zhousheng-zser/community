page {
  background: #f5f5f5;
  min-height: 100vh;
}

.rider-mine-page {
  padding: 32rpx 24rpx 48rpx;
}

.rider-mine-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.rider-mine-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.rider-mine-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.rider-mine-section {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.rider-mine-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.rider-mine-cell:last-child {
  border-bottom: none;
}

.rider-mine-cell-label {
  font-size: 30rpx;
  color: #333;
}

.rider-mine-cell-arrow {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}
