page {
  background: #f5f5f5;
  min-height: 100vh;
}

.rider-home-page {
  padding: 32rpx 24rpx 48rpx;
}

.rider-home-header {
  margin-bottom: 40rpx;
}

.rider-home-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.rider-home-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.rider-home-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.rider-home-card-main {
  flex: 1;
  min-width: 0;
}

.rider-home-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.rider-home-card-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.rider-home-card-arrow {
  font-size: 44rpx;
  color: #ccc;
  line-height: 1;
  margin-left: 16rpx;
}
