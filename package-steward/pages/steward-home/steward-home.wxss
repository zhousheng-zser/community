@import "../../../package-worker/styles/portal.wxss";

.steward-gradient {
  background: linear-gradient(135deg, #1a5c45 0%, #2d8f6a 42%, #5cb896 100%);
  box-shadow: 0 12rpx 40rpx rgba(26, 92, 69, 0.35);
}

.hero-steward {
  padding-top: 28rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.hero-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.hero-text {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.hero-greet {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 8rpx !important;
  opacity: 0.95 !important;
}

.community-tag {
  margin: 20rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.community-tag .label {
  color: #888;
  margin-right: 8rpx;
}

.hotline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.hotline-num {
  color: #1a6b4f;
  font-weight: 600;
  font-size: 30rpx;
}
