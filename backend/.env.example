PORT=3000
# MySQL（与 Sequelize 一致）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=community
DB_USER=root
DB_PASSWORD=

# 开发时可为 true，生产请用迁移 SQL
DB_SYNC_JD=false
# 拼多多惠民卡表 pdd_benefit_goods
DB_SYNC_PDD=false
# 惠民卡联盟顶栏配置表 benefit_alliance_config
DB_SYNC_BENEFIT=false

# 管理后台登录：POST /api/v1/auth/admin/login（推荐，避开误套在 /admin 上的 JWT）；兼容 /api/v1/admin/login
# 测试免密：设为 1 时只校验 ADMIN_USERNAME，不校验密码（正式环境务必删除或改为 0）
# ADMIN_TEST_BYPASS=1
# 说明：非 production 且未配置时，开发默认 用户名 admin / 密码 admin123 / 临时 JWT 密钥（见控制台警告）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
# 至少 8 位随机串，生产务必更换
ADMIN_JWT_SECRET=change_me_random_secret_key_32chars
# 可选，默认 12h
# ADMIN_JWT_EXPIRES=12h
