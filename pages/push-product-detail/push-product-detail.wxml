<view class="pp-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈</text>
    <text>•••</text>
  </view>

  <image class="cover" src="{{product.image}}" mode="aspectFill"></image>

  <view class="info-card">
    <text class="price">￥{{product.price}}</text>
    <view class="calc">
      <text>到手价 ￥{{product.price}}</text>
      <text>支付价 ￥{{product.pay}}</text>
      <text>预计每单返 ￥{{product.rebate}}</text>
    </view>
    <text class="name">{{product.name}}</text>
    <view class="shop-row">
      <text>{{product.shop}}</text>
      <text class="btn" bindtap="goShopAll">店铺全部商品</text>
    </view>
  </view>

  <view class="section-title">商品详情</view>
  <block wx:if="{{product.detail_images && product.detail_images.length}}">
    <image wx:for="{{product.detail_images}}" wx:key="*this" class="detail-img" src="{{item}}" mode="widthFix"></image>
  </block>
  <block wx:else>
    <image class="detail-img" src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=600&q=80" mode="widthFix"></image>
  </block>

  <view class="bottom-bar">
    <text class="home" bindtap="goHome">首页</text>
    <text class="share">￥{{product.rebate}} 分享每单赚</text>
    <text class="buy" bindtap="handleBuyClick">购买每单返</text>
  </view>
</view>

<!-- 微信小店商品组件（浮层） -->
<view class="overlay" wx:if="{{showStoreProduct}}"></view>
<view class="store-product-wrapper" wx:if="{{showStoreProduct}}">
  <store-product
    appid="{{shopAppId}}"
    product-id="{{productId}}"
    custom-style="{{customStyle}}"
    bind:success="onStoreProductSuccess"
    bind:fail="onStoreProductFail"
  />
</view>

