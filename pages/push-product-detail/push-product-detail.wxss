page {
  background: #f2f2f2;
}

.pp-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.top-nav {
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 18rpx 12rpx;
  font-size: 28rpx;
}

.icons {
  display: flex;
  gap: 24rpx;
}

.cover {
  width: 100%;
  height: 360rpx;
}

.info-card {
  margin: 14rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
}

.price {
  color: #e86d47;
  font-size: 58rpx;
}

.calc {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.name {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.shop-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shop-row .btn {
  background: #f4f4f4;
  border-radius: 22rpx;
  padding: 8rpx 16rpx;
  color: #777;
}

.section-title {
  text-align: center;
  font-size: 36rpx;
  margin: 12rpx 0;
}

.detail-img {
  width: 100%;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx;
  background: #fff;
  display: flex;
  gap: 10rpx;
}

.bottom-bar text {
  border-radius: 36rpx;
  text-align: center;
  line-height: 76rpx;
  font-size: 24rpx;
}

.home {
  width: 110rpx;
  background: #fff;
}

.share {
  flex: 1;
  background: #fff0ef;
  color: #ef7b67;
}

.buy {
  flex: 1;
  background: #ff5e45;
  color: #fff;
}

/* ===== 购买弹出面板 ===== */
.panel-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 300;
}

.buy-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 301;
  padding: 32rpx 32rpx 48rpx;
}

.bp-close {
  position: absolute; top: 28rpx; right: 32rpx;
  font-size: 36rpx; color: #aaa; padding: 8rpx;
}

.bp-top {
  display: flex;
  gap: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 24rpx;
}

.bp-img {
  width: 140rpx; height: 140rpx;
  border-radius: 12rpx; flex-shrink: 0;
}

.bp-top-info { display: flex; flex-direction: column; justify-content: center; }

.bp-price { font-size: 40rpx; font-weight: 700; color: #e86d47; }

.bp-selected { font-size: 24rpx; color: #888; margin-top: 12rpx; }

.bp-section { margin-bottom: 24rpx; }

.bp-sec-title { font-size: 28rpx; color: #333; display: block; margin-bottom: 16rpx; }

.bp-tags { display: flex; flex-wrap: wrap; gap: 16rpx; }

.bp-tag {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 26rpx; color: #666;
}

.bp-tag.active {
  border-color: #f5c87a;
  background: #fff9ee;
  color: #d4820a;
}

.bp-qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.bp-qty-label { font-size: 28rpx; color: #333; }

.bp-qty-ctrl { display: flex; align-items: center; gap: 24rpx; }

.bp-qty-btn {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid #ddd;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: #555;
}

.bp-qty-num { font-size: 32rpx; color: #222; min-width: 40rpx; text-align: center; }

.bp-submit-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: #e84040;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
