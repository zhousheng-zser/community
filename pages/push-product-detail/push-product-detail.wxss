page {
  background: #f2f2f2;
}

.pp-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.top-nav {
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 18rpx 12rpx;
  font-size: 28rpx;
}

.icons {
  display: flex;
  gap: 24rpx;
}

.cover {
  width: 100%;
  height: 360rpx;
}

.info-card {
  margin: 14rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
}

.price {
  color: #e86d47;
  font-size: 58rpx;
}

.calc {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.name {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.shop-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shop-row .btn {
  background: #f4f4f4;
  border-radius: 22rpx;
  padding: 8rpx 16rpx;
  color: #777;
}

.section-title {
  text-align: center;
  font-size: 36rpx;
  margin: 12rpx 0;
}

.detail-img {
  width: 100%;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx;
  background: #fff;
  display: flex;
  gap: 10rpx;
}

.bottom-bar text {
  border-radius: 36rpx;
  text-align: center;
  line-height: 76rpx;
  font-size: 24rpx;
}

.home {
  width: 110rpx;
  background: #fff;
}

.share {
  flex: 1;
  background: #fff0ef;
  color: #ef7b67;
}

.buy {
  flex: 1;
  background: #ff5e45;
  color: #fff;
}
