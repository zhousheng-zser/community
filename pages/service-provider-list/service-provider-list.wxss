.spl-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}
.spl-header {
  background: #fff;
  padding: 32rpx 28rpx 20rpx;
  margin-bottom: 16rpx;
}
.spl-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.spl-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}
.spl-loading, .spl-empty {
  padding: 100rpx 0;
  text-align: center;
  color: #aaa;
  font-size: 28rpx;
}
.spl-list {
  padding: 0 20rpx;
}
.spl-card {
  display: flex;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.spl-cover {
  width: 200rpx;
  height: 180rpx;
  flex-shrink: 0;
}
.spl-info {
  flex: 1;
  padding: 20rpx 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.spl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.spl-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.spl-action {
  margin-top: 14rpx;
}
.spl-btn {
  font-size: 24rpx;
  color: #ff6b35;
  font-weight: 500;
}
