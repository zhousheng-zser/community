<!--index.wxml-->
<import src="../../tpl/liorder/liorder.wxml" />
<import src="../../tpl/notask/notask.wxml" />
<view class="home-page" style="--sticky-top: {{navTopPadding + 46}}px;">
  <view class="top-wrap" style="padding-top: {{navTopPadding}}px;">
    <view class="top-tabs">
      <view class="top-tab {{activeTab === item.text ? 'active' : ''}}" wx:for="{{topTabs}}" wx:key="text" bindtap="switchTopTab" data-tab="{{item.text}}">{{item.text}}</view>
    </view>
    <view class="search-row">
      <view class="location-pill" bindtap="handleLocationTap">
        <text class="loc-icon">📍</text>
        <text class="loc-text">{{currentCity}}</text>
      </view>
      <view class="search-input">
        <icon type="search" size="13" color="#999" />
        <input
          class="search-field"
          placeholder="{{activeTab === '本地集市' ? '搜索商家、商品' : activeTab === '惠民卡' ? '请输入商品名称或领券活动' : '搜索上门服务、技工、商家'}}"
          value="{{homeSearchKeyword}}"
          bindinput="onHomeSearchInput"
          confirm-type="search"
        />
      </view>
      <view class="search-btn">搜索</view>
    </view>
  </view>

  <view wx:if="{{activeTab === '本地好物'}}" class="jiatui-wrapper">
    <!-- 模块一：顶级海报轮播区 -->
    <view class="jt-hero">
      <swiper class="jt-hero-swiper" autoplay="true" indicator-dots="true" indicator-active-color="#fff" circular="true">
        <swiper-item wx:for="{{pushHeroBanners}}" wx:key="id">
          <view class="slide-wrap">
            <image src="{{item.image}}" mode="aspectFill" class="fs-hero-img"></image>
            <view class="slide-content">
              <image class="jt-hero-icon" src="/img/index/menuicon1.png" mode="aspectFit"></image>
              <text class="jt-hero-title">品牌好物</text>
              <text class="jt-hero-sub">严选之品，生活之味</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 模块二：五大金刚区 -->
    <view class="jt-categories">
      <navigator class="jt-cate-item" wx:for="{{pushCategories}}" wx:key="name" url="{{item.url}}">
        <view class="jt-cate-emoji-wrap">
          <image src="{{item.icon}}" mode="aspectFill" style="width: 100%; height: 100%; border-radius: 50%;"></image>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>

    <!-- 模块三：三花聚顶导购窗 -->
    <view class="jt-promo-grid">
      <navigator class="jt-promo-left" url="../push-channel/push-channel?title=品牌好货">
        <image src="{{pushPromoCards.left.image}}" mode="aspectFill"></image>
        <text class="tag">{{pushPromoCards.left.title}}</text>
      </navigator>
      <navigator class="jt-promo-mid" url="../push-channel/push-channel?title=寻找九州好物">
        <text class="title">寻找九州好物</text>
        <text class="sub">溯源地道，严选品质</text>
      </navigator>
      <navigator class="jt-promo-right" url="../push-channel/push-channel?title=秋冬好物">
        <image src="{{pushPromoCards.right.image}}" mode="aspectFill"></image>
        <text class="tag">{{pushPromoCards.right.title}}</text>
      </navigator>
    </view>

    <!-- 模块四：上新与热卖榜 -->
    <view class="jt-sales-row">
      <!-- 每日上新 -->
      <view class="jt-daily-news">
        <navigator class="head" url="/pages/push-daily-news/push-daily-news">
          <text class="title">每日上新</text>
          <image class="head-icon" src="/img/index/ticon1.png"></image>
        </navigator>
        <view class="grid">
          <navigator class="news-item" wx:for="{{pushDailyNews}}" wx:if="{{index < 4}}" wx:key="id" url="../push-product-detail/push-product-detail?id={{item.id}}">
            <image src="{{item.image}}" mode="aspectFill"></image>
            <view class="rebate-tag">返佣金￥{{item.comm}}</view>
            <view class="price-row">
              <text class="yen">￥</text>
              <text class="num">{{item.price}}</text>
            </view>
          </navigator>
        </view>
      </view>

      <!-- 热卖TOP榜 -->
      <view class="jt-top-sales">
        <navigator class="head" url="/pages/push-top-sales/push-top-sales">
          <text class="title">热卖TOP榜</text>
          <image class="head-icon" src="/img/index/ticon2.png"></image>
        </navigator>
        <view class="list">
          <navigator class="top-item" wx:for="{{pushTopSales}}" wx:if="{{index < 3}}" wx:key="rank" url="../push-product-detail/push-product-detail?id={{item.id}}">
            <view class="rank-badge">
              <text class="top">TOP</text>
              <text class="num">{{item.rank}}</text>
            </view>
            <image src="{{item.image}}" mode="aspectFill"></image>
            <view class="info">
              <text class="name">{{item.name}}</text>
              <view class="rebate-tag-inline">
                <text class="yen">￥</text>返￥{{item.comm}}
              </view>
            </view>
          </navigator>
        </view>
      </view>
    </view>

    <!-- 模块八：周期性主推与热卖排行 (Periodic Rankings) -->
    <view class="jt-feed-section">
      <!-- 独立的周期性榜单容器 -->
      <view class="jt-periodic-module">
        <view class="feed-tabs">
          <text class="tab {{index === activePeriodicTabIndex ? 'active' : ''}}" bindtap="switchPeriodicTab" data-idx="{{index}}" wx:for="{{pushPeriodicTabs}}" wx:key="*this">{{item}}</text>
        </view>
        
        <!-- 模块八短列表：基于 periodic items -->
        <view class="feed-goods-list">
          <navigator url="/pages/push-product-detail/push-product-detail?id={{item.id}}" class="f-card" wx:for="{{pushPeriodicGoods}}" wx:key="id">
            <image src="{{item.image}}" mode="aspectFill"></image>
            <view class="f-info">
              <text class="f-title">{{item.title}}</text>
              <view class="f-price">
                <text class="yen">￥</text>{{item.price}}
                <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
              </view>
              <view class="f-action">
                <text class="share">分享赚/购买返￥{{item.comm}}</text>
                <view class="btn">去购买</view>
              </view>
            </view>
          </navigator>
        </view>
        
        <!-- 模块八：查看更多按钮 -->
        <navigator url="/pages/push-periodic-list/push-periodic-list?type={{pushPeriodicTabs[activePeriodicTabIndex]}}" class="view-more-line">
          查看更多 >
        </navigator>
      </view>
      
      <!-- 独立的底部分类 Feed 模块 -->
      <view class="jt-subfeed-module">
        <scroll-view class="sub-tabs-scroll" scroll-x="{{true}}">
        <view class="sub-tabs">
          <view wx:for="{{pushFeedTabs}}" wx:key="*this"
                class="tab-item {{item === activeFeedTab ? 'active' : ''}}"
                bindtap="switchFeedTab" data-name="{{item}}">{{item}}</view>
        </view>
      </scroll-view>

      <view class="feed-goods-list">
        <navigator url="/pages/push-product-detail/push-product-detail?id={{item.id}}" class="f-card" wx:for="{{pushFeedGoods}}" wx:key="id">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <view class="f-info">
            <text class="f-title">{{item.title}}</text>
            <view class="f-price">
              <text class="yen">￥</text>{{item.price}}
              <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
            </view>
            <view class="f-action">
              <text class="share">分享赚/购买返￥{{item.comm}}</text>
              <view class="btn">去购买</view>
            </view>
          </view>
        </navigator>
      </view>

        <view class="feed-more" wx:if="{{isLoadingMore}}">
          正在加载更多宝贝...
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{activeTab === '惠民卡'}}" class="benefit-card-page">
    <scroll-view class="benefit-alliance-tabs-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="benefit-alliance-tabs-row">
        <view
          wx:for="{{benefitAllianceTabs}}"
          wx:key="key"
          class="benefit-alliance-tab {{activeBenefitAlliance === item.key ? 'active' : ''}}"
          bindtap="switchBenefitAllianceTab"
          data-key="{{item.key}}"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <block wx:if="{{activeBenefitAlliance === 'jd'}}">
      <view class="card benefit-hero-banner">
        <image src="{{jdBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
        <view class="benefit-hero-mask">
          <text class="benefit-hero-title">惠民卡 · 京东联盟</text>
          <text class="benefit-hero-sub">京挑客 · 跳转京东联盟小程序购买</text>
        </view>
      </view>
      <view class="card section-card">
        <view class="section-head">
          <text class="title">京东联盟精选</text>
        </view>
        <view class="fuka-goods-grid">
          <view class="fuka-goods-item" wx:for="{{jdGoods}}" wx:key="id" bindtap="goToJDMiniprogram" data-sku-id="{{item.skuId}}" data-spread-url="{{item.spreadUrl}}">
            <view class="fuka-goods-img-wrap">
              <image src="{{item.image}}" mode="aspectFill"></image>
              <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
            </view>
            <text class="name">{{item.title}}</text>
            <text class="price">￥{{item.price}}</text>
          </view>
        </view>
      </view>
      <view class="card fuka-open-card benefit-cta-jd" bindtap="goToJDMiniprogram" data-sku-id="100010713464" data-spread-url="https://u.jd.com/cGYRLnW">
        <view class="left">
          <text class="title">去京东领券购买</text>
          <text class="sub">京东联盟推广链接跳转</text>
        </view>
        <text class="go">GO ></text>
      </view>
    </block>

    <block wx:elif="{{activeBenefitAlliance === 'pdd'}}">
      <view class="card benefit-hero-banner">
        <image src="{{pddBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
        <view class="benefit-hero-mask benefit-hero-mask-pdd">
          <text class="benefit-hero-title">惠民卡 · 拼多多</text>
          <text class="benefit-hero-sub">多多进宝 · 小程序直达或复制推广链接</text>
        </view>
      </view>
      <view class="card section-card">
        <view class="section-head">
          <text class="title">拼多多精选</text>
        </view>
        <view class="fuka-goods-grid">
          <view
            class="fuka-goods-item"
            wx:for="{{pddGoods}}"
            wx:key="id"
            bindtap="goToPddBenefit"
            data-goods-id="{{item.goodsId}}"
            data-spread-url="{{item.spreadUrl}}"
            data-mini-path="{{item.miniPath}}"
          >
            <view class="fuka-goods-img-wrap">
              <image src="{{item.image}}" mode="aspectFill"></image>
              <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
            </view>
            <text class="name">{{item.title}}</text>
            <text class="price">￥{{item.price}}</text>
          </view>
        </view>
      </view>
      <view
        class="card fuka-open-card benefit-cta-pdd"
        bindtap="goToPddBenefit"
        data-goods-id="{{pddEntry.goodsId}}"
        data-spread-url="{{pddEntry.spreadUrl}}"
        data-mini-path="{{pddEntry.miniPath}}"
      >
        <view class="left">
          <text class="title">拼多多特价频道</text>
          <text class="sub">复制推广链接或直达拼多多小程序（需配置路径）</text>
        </view>
        <text class="go">GO ></text>
      </view>
    </block>

    <block wx:elif="{{activeBenefitAlliance === 'taobao'}}">
      <view class="card benefit-hero-banner">
        <image src="{{taobaoBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
        <view class="benefit-hero-mask benefit-hero-mask-tb">
          <text class="benefit-hero-title">惠民卡 · 淘宝联盟</text>
          <text class="benefit-hero-sub">淘宝客 · 复制推广链接到淘宝或浏览器打开</text>
        </view>
      </view>
      <view class="card section-card">
        <view class="section-head">
          <text class="title">淘宝联盟精选</text>
        </view>
        <view class="fuka-goods-grid">
          <view
            class="fuka-goods-item"
            wx:for="{{taobaoGoods}}"
            wx:key="id"
            bindtap="goToTaobaoBenefit"
            data-item-id="{{item.itemId}}"
            data-promotion-url="{{item.promotionUrl}}"
          >
            <view class="fuka-goods-img-wrap">
              <image src="{{item.image}}" mode="aspectFill"></image>
              <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
            </view>
            <text class="name">{{item.title}}</text>
            <text class="price">￥{{item.price}}</text>
          </view>
        </view>
      </view>
      <view
        class="card fuka-open-card benefit-cta-tb"
        bindtap="goToTaobaoBenefit"
        data-item-id="{{taobaoEntry.itemId}}"
        data-promotion-url="{{taobaoEntry.promotionUrl}}"
      >
        <view class="left">
          <text class="title">淘宝联盟活动入口</text>
          <text class="sub">复制官方推广链接（可接后端转链接口）</text>
        </view>
        <text class="go">GO ></text>
      </view>
    </block>
  </view>

  <view wx:elif="{{activeTab === '本地集市'}}">
    <view class="card market-top-cats">
      <view class="market-top-item {{activeMarketCat === item.code ? 'active' : ''}}" wx:for="{{marketTopCats}}" wx:key="code" bindtap="switchMarketCategory" data-code="{{item.code}}">
        <view class="market-emoji-wrap" style="border: {{activeMarketCat === item.code ? '4rpx solid #ff4d4f' : '4rpx solid transparent'}};">
          <image src="{{item.icon}}" mode="aspectFill" style="width: 100%; height: 100%; border-radius: 50%;"></image>
        </view>
        <text style="color: {{activeMarketCat === item.code ? '#ff4d4f' : '#333'}}; font-weight: {{activeMarketCat === item.code ? 'bold' : 'normal'}};">{{item.name}}</text>
      </view>
    </view>

    <view class="market-title-row">
      <text class="near">附近商家</text>
    </view>

    <view class="card market-filter-row">
      <text
        class="market-filter {{activeMarketSort === item.key ? 'active' : ''}}"
        wx:for="{{marketFilters}}"
        wx:key="key"
        bindtap="switchMarketSort"
        data-key="{{item.key}}"
      >{{item.label}}</text>
    </view>

    <view class="market-empty" wx:if="{{marketShops.length === 0}}">
      <text class="market-empty-text">附近暂无商家</text>
    </view>
    <view class="market-shop-list">
      <view class="card market-shop-card" wx:for="{{marketShops}}" wx:key="id" bindtap="goMarketShop" data-id="{{item.id}}">
        <image wx:if="{{item.coverUrl}}" class="shop-list-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="shop-card-body">
        <view class="shop-head">
          <text class="name">{{item.name}}</text>
          <text class="badge">{{item.badge}}</text>
        </view>
        <view class="shop-rating-row" wx:if="{{item.ratingText}}">
          <text class="rating-text">{{item.ratingText}}</text>
        </view>
        <view class="shop-meta">
          <text>{{item.delivery}}</text>
          <text class="distance" wx:if="{{item.distanceLabel}}">{{item.distanceLabel}}</text>
          <text class="sold">{{item.sold}}</text>
        </view>
        <scroll-view class="shop-goods-scroll" scroll-x="{{true}}">
          <view class="shop-goods-row">
            <view class="shop-goods-item" wx:for="{{item.goods}}" wx:key="id" catchtap="goMarketGoods" data-id="{{item.id}}">
              <image src="{{item.image}}" mode="aspectFill"></image>
              <text class="g-name">{{item.name}}</text>
              <text class="g-price">￥{{item.price}}</text>
            </view>
          </view>
        </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
  <view class="card panel-grid">
    <view class="service-grid">
      <navigator class="service-item" wx:for="{{categoryList}}" wx:key="name" url="{{item.url}}">
        <view class="svc-icon-wrap" style="background:{{item.bgColor}}">
          <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit" style="width: 100%; height: 100%;"></image>
          <text wx:else class="svc-emoji">{{item.emoji}}</text>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>
    <view class="quick-nav">
      <navigator class="quick-item" wx:for="{{quickActions}}" wx:key="name" url="../classify/classify">
        <view class="quick-icon-wrap" style="background:{{item.bgColor}}">
          <text class="quick-emoji">{{item.emoji}}</text>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>
  </view>

  <swiper class="promo-swiper card" autoplay="{{true}}" indicator-dots="{{true}}" circular="{{true}}">
    <swiper-item wx:for="{{banner}}" wx:key="imageUrl">
      <image src="{{item.imageUrl}}" class="slide-image" mode="aspectFill" />
    </swiper-item>
  </swiper>

  <view class="card section-card">
    <view class="section-head neighborhood-head">
      <view class="title-wrap">
        <text class="title">邻里帮帮</text>
        <text class="assist-tag">解决身边琐事小烦恼</text>
      </view>
      <text class="more">查看更多 ></text>
    </view>
    <view class="knowledge-row neighborhood-services">
      <navigator class="knowledge-item" wx:for="{{knowledgeList}}" wx:key="name" url="{{item.url}}">
        <view class="know-icon-wrap" style="background:{{item.bgColor}}">
          <text class="know-emoji">{{item.emoji}}</text>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head hot">
      <text class="title">小区热卖榜</text>
      <text class="more">查看更多 ></text>
    </view>
    <scroll-view class="hot-scroll" scroll-x="{{true}}">
      <view class="hot-wrap">
        <navigator class="hot-item" wx:for="{{hotList}}" wx:key="name" url="../service/service?id={{item.id}}">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <text class="hot-rank">{{item.rank}}</text>
          <text class="hot-name">{{item.name}}</text>
          <text class="hot-price">￥{{item.price}}/次</text>
        </navigator>
      </view>
    </scroll-view>
    <view class="hot-filter-row">
      <view class="hot-filter" wx:for="{{hotFilters}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head">
      <text class="title">直约服务商</text>
      <navigator class="more" url="../merchant-detail/merchant-detail">查看全部 ></navigator>
    </view>
    <view class="merchant-list">
      <navigator class="merchant-item" wx:for="{{merchantList}}" wx:key="id" url="{{item.url}}">
        <image src="{{item.image}}" mode="aspectFill"></image>
        <view class="merchant-text">
          <text class="name">{{item.name}}</text>
          <text class="sub">{{item.sub}}</text>
        </view>
      </navigator>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head">
      <text class="title">直约技工</text>
      <navigator class="more" url="../classify/classify">查看全部 ></navigator>
    </view>
    <scroll-view class="worker-scroll" scroll-x="{{true}}">
      <view class="worker-row">
        <navigator class="worker-item" wx:for="{{workerList}}" wx:key="id" url="../worker-detail/worker-detail?id={{item.id}}">
          <image src="{{item.avatar}}" mode="aspectFill"></image>
          <text class="name">{{item.name}}</text>
          <text class="sub">{{item.orders}}</text>
        </navigator>
      </view>
    </scroll-view>
  </view>

  <view class="card section-card">
    <view class="section-head">
      <text class="title">管家精选</text>
    </view>
    <view class="market-grid">
      <navigator class="market-item" wx:for="{{marketList}}" wx:key="name" url="../goods-detail/goods-detail?id={{item.id}}">
        <image src="{{item.image}}" mode="aspectFill"></image>
        <text class="name">{{item.name}}</text>
        <text class="price">￥{{item.price}}/瓶</text>
      </navigator>
    </view>
  </view>
  </view>

  <view class="fake-tabbar-space"></view>

  <view class="modal" wx:if="{{showGetTelModal}}">
    系统需要获取您的手机号码以方便客户与您联系
    <button open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">同意获取手机号码 </button>
  </view>
</view>
