<!--index.wxml-->
<import src="../../tpl/liorder/liorder.wxml" />
<import src="../../tpl/notask/notask.wxml" />
<view class="home-page" style="--sticky-top: {{navTopPadding + 46}}px;">
  <view class="top-wrap" style="padding-top: {{navTopPadding}}px;">
    <view class="top-tabs">
      <view class="top-tab {{activeTab === item.text ? 'active' : ''}}" wx:for="{{topTabs}}" wx:key="text" bindtap="switchTopTab" data-tab="{{item.text}}">{{item.text}}</view>
    </view>
    <view class="search-row">
      <view class="location-pill" bindtap="handleLocationTap">
        <text class="loc-icon">📍</text>
        <text class="loc-text">{{currentCity}}</text>
      </view>
      <view class="search-input" bindtap="goSearch">
        <icon type="search" size="13" color="#999" />
        <input
          class="search-field"
          disabled="true"
          placeholder="{{activeTab === '本地集市' ? '搜索商家、商品' : activeTab === '惠民卡' ? '请输入商品名称或领券活动' : '搜索上门服务、技工、商家'}}"
          value="{{homeSearchKeyword}}"
        />
      </view>
      <view class="search-btn" bindtap="goSearch">搜索</view>
    </view>
  </view>

  <view wx:if="{{activeTab === '本地商城'}}" class="jiatui-wrapper">
    <!-- 模块一：顶级海报轮播区 -->
    <view class="jt-hero">
      <swiper class="jt-hero-swiper" autoplay="true" indicator-dots="true" indicator-active-color="#fff" circular="true">
        <swiper-item wx:for="{{pushHeroBanners}}" wx:key="id">
          <navigator url="{{item.url}}" class="slide-wrap" hover-class="none">
            <image src="{{item.image}}" mode="aspectFill" class="fs-hero-img"></image>
            <view class="slide-content">
              <text class="jt-hero-title">{{item.title}}</text>
              <text class="jt-hero-sub">{{item.sub}}</text>
            </view>
          </navigator>
        </swiper-item>
      </swiper>
    </view>

    <!-- 模块二：五大金刚区 -->
    <view class="jt-categories">
      <navigator class="jt-cate-item" wx:for="{{pushCategories}}" wx:key="name" url="{{item.url}}">
        <view class="jt-cate-emoji-wrap">
          <image src="{{item.icon}}" mode="aspectFill" style="width: 100%; height: 100%; border-radius: 50%;"></image>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>

    <!-- 模块三：三花聚顶导购窗 -->
    <view class="jt-promo-grid">
      <navigator class="jt-promo-left" url="/package-push/pages/push-channel/push-channel?title=品牌好货">
        <image src="{{pushPromoCards.left.image}}" mode="aspectFill"></image>
        <text class="tag">{{pushPromoCards.left.title}}</text>
      </navigator>
      <navigator class="jt-promo-mid" url="/package-push/pages/push-channel/push-channel?title=寻找九州好物">
        <text class="title">寻找九州好物</text>
        <text class="sub">溯源地道，严选品质</text>
      </navigator>
      <navigator class="jt-promo-right" url="/package-push/pages/push-channel/push-channel?title=秋冬好物">
        <image src="{{pushPromoCards.right.image}}" mode="aspectFill"></image>
        <text class="tag">{{pushPromoCards.right.title}}</text>
      </navigator>
    </view>

    <!-- 模块四：上新与热卖榜 -->
    <view class="jt-sales-row">
      <!-- 每日上新 -->
      <view class="jt-daily-news">
        <navigator class="head" url="/package-push/pages/push-daily-news/push-daily-news">
          <text class="title">每日上新</text>
          <image class="head-icon" src="/img/index/ticon1.png"></image>
        </navigator>
        <view class="grid">
          <navigator class="news-item" wx:for="{{pushDailyNews}}" wx:if="{{index < 4}}" wx:key="id" url="{{item.detailUrl}}">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
            <view class="rebate-tag">返佣金￥{{item.comm}}</view>
            <view class="price-row">
              <text class="yen">￥</text>
              <text class="num">{{item.price}}</text>
            </view>
          </navigator>
        </view>
      </view>

      <!-- 热卖TOP榜 -->
      <view class="jt-top-sales">
        <navigator class="head" url="/package-push/pages/push-top-sales/push-top-sales">
          <text class="title">热卖TOP榜</text>
          <image class="head-icon" src="/img/index/ticon2.png"></image>
        </navigator>
        <view class="list">
          <navigator class="top-item" wx:for="{{pushTopSales}}" wx:if="{{index < 3}}" wx:key="rank" url="{{item.detailUrl}}">
            <view class="rank-badge">
              <text class="top">TOP</text>
              <text class="num">{{item.rank}}</text>
            </view>
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
            <view class="info">
              <text class="name">{{item.name}}</text>
              <view class="rebate-tag-inline">
                <text class="yen">￥</text>返￥{{item.comm}}
              </view>
            </view>
          </navigator>
        </view>
      </view>
    </view>

    <!-- 模块八：周期性主推与热卖排行 (Periodic Rankings) -->
    <view class="jt-feed-section">
      <!-- 独立的周期性榜单容器 -->
      <view class="jt-periodic-module">
        <view class="feed-tabs">
          <text class="tab {{index === activePeriodicTabIndex ? 'active' : ''}}" bindtap="switchPeriodicTab" data-idx="{{index}}" wx:for="{{pushPeriodicTabs}}" wx:key="*this">{{item}}</text>
        </view>
        
        <!-- 模块八短列表：基于 periodic items -->
        <view class="feed-goods-list">
          <navigator url="{{item.detailUrl}}" class="f-card" wx:for="{{pushPeriodicGoods}}" wx:key="id">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
            <view class="f-info">
              <text class="f-title">{{item.title}}</text>
              <view class="f-price">
                <text class="yen">￥</text>{{item.price}}
                <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
              </view>
              <view class="f-action">
                <text class="share">分享赚/购买返￥{{item.comm}}</text>
                <view class="btn">去购买</view>
              </view>
            </view>
          </navigator>
        </view>
        
        <!-- 模块八：查看更多按钮 -->
        <navigator url="/package-push/pages/push-periodic-list/push-periodic-list?type={{pushPeriodicTabs[activePeriodicTabIndex]}}" class="view-more-line">
          查看更多 >
        </navigator>
      </view>
      
      <!-- 独立的底部分类 Feed 模块 -->
      <view class="jt-subfeed-module">
        <scroll-view class="sub-tabs-scroll" scroll-x="{{true}}">
        <view class="sub-tabs">
          <view wx:for="{{pushFeedTabs}}" wx:key="*this"
                class="tab-item {{item === activeFeedTab ? 'active' : ''}}"
                bindtap="switchFeedTab" data-name="{{item}}">{{item}}</view>
        </view>
      </scroll-view>

      <view class="feed-goods-list">
        <navigator url="{{item.detailUrl}}" class="f-card" wx:for="{{pushFeedGoods}}" wx:key="id">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
          <view class="f-info">
            <text class="f-title">{{item.title}}</text>
            <view class="f-price">
              <text class="yen">￥</text>{{item.price}}
              <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
            </view>
            <view class="f-action">
              <text class="share">分享赚/购买返￥{{item.comm}}</text>
              <view class="btn">去购买</view>
            </view>
          </view>
        </navigator>
      </view>

        <view class="feed-more" wx:if="{{isLoadingMore}}">
          正在加载更多宝贝...
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{activeTab === '惠民卡'}}" class="benefit-card-page">
    <scroll-view scroll-y="{{true}}" class="benefit-scroll">
      <!-- ===== 京东联盟 ===== -->
      <view class="benefit-section">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{jdBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{jdHeroTitle || '惠民卡 · 京东联盟'}}</text>
            <text class="benefit-hero-sub">{{jdHeroSubtitle || '京挑客 · 与流量联盟/京东联盟.md 推广链、标题一致'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">京东联盟精选</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{jdGoods}}" wx:key="id" bindtap="goToJDMiniprogram" data-sku-id="{{item.skuId}}" data-spread-url="{{item.spreadUrl}}">
              <view class="fuka-goods-img-wrap">
                <image src="{{item.image}}" mode="aspectFill"></image>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <text class="price" wx:if="{{item.price}}">￥{{item.price}}</text>
              <text class="price jd-price-hint" wx:else>领券价见京东</text>
            </view>
          </view>
        </view>
        <view class="card fuka-open-card benefit-cta-jd" bindtap="goToJDMiniprogram" data-sku-id="{{jdEntry.skuId}}" data-spread-url="{{jdEntry.spreadUrl}}">
          <view class="left">
            <text class="title">去京东领券购买</text>
            <text class="sub">与列表首条同款推广链（京东联盟小程序）</text>
          </view>
          <text class="go">GO ></text>
        </view>
      </view>

      <!-- ===== 拼多多 ===== -->
      <view class="benefit-section">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{pddBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light benefit-hero-mask-pdd">
            <text class="benefit-hero-title">{{pddHeroTitle || '惠民卡 · 拼多多'}}</text>
            <text class="benefit-hero-sub">{{pddHeroSubtitle || '多多进宝 · 券后价与 p.pinduoduo 推广链（与流量联盟文档对齐）'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">拼多多精选</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{pddGoods}}" wx:key="id" bindtap="goToPddBenefit" data-goods-id="{{item.goodsId}}" data-spread-url="{{item.spreadUrl}}" data-mini-path="{{item.miniPath}}">
              <view class="fuka-goods-img-wrap">
                <image src="{{item.image}}" mode="aspectFill"></image>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <view class="pdd-price-block" wx:if="{{item.couponPrice}}">
                <text class="price pdd-coupon">券后￥{{item.couponPrice}}</text>
                <text class="price pdd-orig">￥{{item.price}}</text>
              </view>
              <text class="price" wx:else>￥{{item.price}}</text>
            </view>
          </view>
        </view>
        <view class="card fuka-open-card benefit-cta-pdd" bindtap="goToPddBenefit" data-goods-id="{{pddEntry.goodsId}}" data-spread-url="{{pddEntry.spreadUrl}}" data-mini-path="{{pddEntry.miniPath}}">
          <view class="left">
            <text class="title">拼多多进宝精选</text>
            <text class="sub">打开小程序或复制推广链接（与列表同款素材）</text>
          </view>
          <text class="go">GO ></text>
        </view>
      </view>

      <!-- ===== 美团 ===== -->
      <view class="benefit-section" wx:if="{{mtGoods.length > 0}}">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{mtBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{mtHeroTitle || '惠民卡 · 美团联盟'}}</text>
            <text class="benefit-hero-sub">{{mtHeroSubtitle || '外卖红包 · 到店优惠 · 团购返利'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">美团精选</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{mtGoods}}" wx:key="id" bindtap="handleCopyBenefitLink" data-url="{{item.spreadUrl}}">
              <view class="fuka-goods-img-wrap">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else style="height:210rpx;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border-radius:12rpx;">
                  <text style="color:#999;font-size:24rpx;">美团活动</text>
                </view>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <view class="pdd-price-block" wx:if="{{item.couponPrice}}">
                <text class="price pdd-coupon">券后￥{{item.couponPrice}}</text>
                <text class="price pdd-orig">￥{{item.price}}</text>
              </view>
              <text class="price" wx:elif="{{item.price}}">￥{{item.price}}</text>
              <text class="price jd-price-hint" wx:else>{{item.subtitle || '点击复制推广链接'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 淘宝 ===== -->
      <view class="benefit-section" wx:if="{{tbGoods.length > 0}}">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{tbBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{tbHeroTitle || '惠民卡 · 淘宝联盟'}}</text>
            <text class="benefit-hero-sub">{{tbHeroSubtitle || '淘口令 · 优惠券 · 返利推广'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">淘宝精选</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{tbGoods}}" wx:key="id" bindtap="handleCopyBenefitLink" data-url="{{item.spreadUrl}}">
              <view class="fuka-goods-img-wrap">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else style="height:210rpx;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border-radius:12rpx;">
                  <text style="color:#999;font-size:24rpx;">淘宝好物</text>
                </view>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <view class="pdd-price-block" wx:if="{{item.couponPrice}}">
                <text class="price pdd-coupon">券后￥{{item.couponPrice}}</text>
                <text class="price pdd-orig">￥{{item.price}}</text>
              </view>
              <text class="price" wx:elif="{{item.price}}">￥{{item.price}}</text>
              <text class="price jd-price-hint" wx:else>{{item.subtitle || '点击复制淘口令'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 闪购 ===== -->
      <view class="benefit-section" wx:if="{{sgGoods.length > 0}}">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{sgBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{sgHeroTitle || '惠民卡 · 闪购专区'}}</text>
            <text class="benefit-hero-sub">{{sgHeroSubtitle || '饿了么红包 · 淘宝闪购 · 超低价爆品'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">闪购精选</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{sgGoods}}" wx:key="id" bindtap="handleCopyBenefitLink" data-url="{{item.spreadUrl}}">
              <view class="fuka-goods-img-wrap">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else style="height:210rpx;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border-radius:12rpx;">
                  <text style="color:#999;font-size:24rpx;">闪购活动</text>
                </view>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <view class="pdd-price-block" wx:if="{{item.couponPrice}}">
                <text class="price pdd-coupon">券后￥{{item.couponPrice}}</text>
                <text class="price pdd-orig">￥{{item.price}}</text>
              </view>
              <text class="price" wx:elif="{{item.price}}">￥{{item.price}}</text>
              <text class="price jd-price-hint" wx:else>{{item.subtitle || '点击复制推广链接'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 社群 ===== -->
      <view class="benefit-section" wx:if="{{sqGoods.length > 0}}">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{sqBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{sqHeroTitle || '惠民卡 · 社群福利'}}</text>
            <text class="benefit-hero-sub">{{sqHeroSubtitle || '社群专享 · 9.9元吃饱喝足'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">社群专享</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{sqGoods}}" wx:key="id" bindtap="handleCopyBenefitLink" data-url="{{item.spreadUrl}}">
              <view class="fuka-goods-img-wrap">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else style="height:210rpx;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border-radius:12rpx;">
                  <text style="color:#999;font-size:24rpx;">社群福利</text>
                </view>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <view class="pdd-price-block" wx:if="{{item.couponPrice}}">
                <text class="price pdd-coupon">券后￥{{item.couponPrice}}</text>
                <text class="price pdd-orig">￥{{item.price}}</text>
              </view>
              <text class="price" wx:elif="{{item.price}}">￥{{item.price}}</text>
              <text class="price jd-price-hint" wx:else>{{item.subtitle || '点击复制推广链接'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 推销 ===== -->
      <view class="benefit-section" wx:if="{{txGoods.length > 0}}">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{txBanner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{txHeroTitle || '惠民卡 · 精选推销'}}</text>
            <text class="benefit-hero-sub">{{txHeroSubtitle || '一元外卖 · 夏日山海 · 会员权益'}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">精选推销</text>
          </view>
          <view class="fuka-goods-grid">
            <view class="fuka-goods-item" wx:for="{{txGoods}}" wx:key="id" bindtap="handleCopyBenefitLink" data-url="{{item.spreadUrl}}">
              <view class="fuka-goods-img-wrap">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
                <view wx:else style="height:210rpx;background:#f5f5f5;display:flex;align-items:center;justify-content:center;border-radius:12rpx;">
                  <text style="color:#999;font-size:24rpx;">精选活动</text>
                </view>
                <text class="comm" wx:if="{{item.rebateAmount}}">返￥{{item.rebateAmount}}</text>
              </view>
              <text class="name">{{item.title}}</text>
              <view class="pdd-price-block" wx:if="{{item.couponPrice}}">
                <text class="price pdd-coupon">券后￥{{item.couponPrice}}</text>
                <text class="price pdd-orig">￥{{item.price}}</text>
              </view>
              <text class="price" wx:elif="{{item.price}}">￥{{item.price}}</text>
              <text class="price jd-price-hint" wx:else>{{item.subtitle || '点击复制推广链接'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 大牌餐饮（肯德基 / 星巴克 / 百果园 · 版式对齐京东联盟） ===== -->
      <view class="benefit-section" wx:for="{{benefitBrandList}}" wx:key="key">
        <view class="card benefit-hero-banner benefit-hero-banner--alliance">
          <image src="{{item.banner}}" mode="aspectFill" class="benefit-hero-img"></image>
          <view class="benefit-hero-mask benefit-hero-mask--light">
            <text class="benefit-hero-title">{{item.heroTitle}}</text>
            <text class="benefit-hero-sub">{{item.heroSub}}</text>
          </view>
        </view>
        <view class="card section-card">
          <view class="section-head">
            <text class="title">{{item.listTitle}}</text>
          </view>
          <view class="fuka-goods-grid">
            <view
              class="fuka-goods-item"
              bindtap="onBenefitBrandTap"
              data-keyword="{{item.keyword}}"
              data-miniappid="{{item.miniAppId}}"
              data-minipath="{{item.miniPath}}"
            >
              <view class="fuka-goods-img-wrap">
                <image src="{{item.cardImage}}" mode="aspectFill"></image>
              </view>
              <text class="name">{{item.cardTitle}}</text>
              <text class="price jd-price-hint">{{item.priceHint}}</text>
            </view>
          </view>
        </view>
        <view
          class="card fuka-open-card benefit-cta-jd"
          wx:if="{{item.miniAppId}}"
          bindtap="onBenefitBrandTap"
          data-keyword="{{item.keyword}}"
          data-miniappid="{{item.miniAppId}}"
          data-minipath="{{item.miniPath}}"
        >
          <view class="left">
            <text class="title">{{item.ctaTitle}}</text>
            <text class="sub">{{item.ctaSub}}</text>
          </view>
          <text class="go">GO ></text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:elif="{{activeTab === '本地集市'}}">
    <view class="card market-top-cats">
      <view class="market-top-item {{activeMarketCat === item.code ? 'active' : ''}}" wx:for="{{marketTopCats}}" wx:key="code" bindtap="switchMarketCategory" data-code="{{item.code}}">
        <view class="market-emoji-wrap" style="border: {{activeMarketCat === item.code ? '4rpx solid #FF7700' : '4rpx solid transparent'}};">
          <image src="{{item.icon}}" mode="aspectFill" style="width: 100%; height: 100%; border-radius: 50%;"></image>
        </view>
        <text style="color: {{activeMarketCat === item.code ? '#FF7700' : '#333'}}; font-weight: {{activeMarketCat === item.code ? 'bold' : 'normal'}};">{{item.name}}</text>
      </view>
    </view>

    <view class="market-title-row">
      <text class="near">附近商家</text>
    </view>

    <view class="card market-filter-row">
      <text
        class="market-filter {{activeMarketSort === item.key ? 'active' : ''}}"
        wx:for="{{marketFilters}}"
        wx:key="key"
        bindtap="switchMarketSort"
        data-key="{{item.key}}"
      >{{item.label}}</text>
    </view>

    <view class="market-empty" wx:if="{{marketShops.length === 0}}">
      <text class="market-empty-text">附近暂无商家</text>
    </view>
    <view class="market-shop-list">
      <view class="card market-shop-card" wx:for="{{marketShops}}" wx:for-item="shop" wx:key="id" bindtap="goMarketShop" data-id="{{shop.id}}">
        <image wx:if="{{shop.coverUrl}}" class="shop-list-cover" src="{{shop.coverUrl}}" mode="aspectFill" />
        <view class="shop-card-body">
        <view class="shop-head">
          <text class="name">{{shop.name}}</text>
          <text class="badge">{{shop.badge}}</text>
        </view>
        <view class="shop-rating-row" wx:if="{{shop.ratingText}}">
          <text class="rating-text">{{shop.ratingText}}</text>
        </view>
        <view class="shop-meta">
          <text>{{shop.delivery}}</text>
          <text class="distance" wx:if="{{shop.distanceLabel}}">{{shop.distanceLabel}}</text>
          <text class="sold">{{shop.sold}}</text>
        </view>
        <scroll-view class="shop-goods-scroll" scroll-x="{{true}}">
          <view class="shop-goods-row">
            <view class="shop-goods-item" wx:for="{{shop.goods}}" wx:key="id" catchtap="goMarketGoods" data-id="{{item.id}}" data-shop-id="{{shop.id}}" data-image="{{item.image}}" data-name="{{item.name}}" data-price="{{item.price}}">
              <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
              <text class="g-name">{{item.name}}</text>
              <text class="g-price">&#165;{{item.price}}</text>
            </view>
          </view>
        </scroll-view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else>
  <view class="card panel-grid">
    <view class="service-grid">
      <view
        class="service-item home-cat-cell"
        wx:for="{{categoryList}}"
        wx:key="groupKey"
        catchtap="onTapHomeCategory"
        data-url="{{item.url}}"
        data-unsupported="{{item.unsupported}}"
      >
        <view class="svc-icon-wrap svc-home-cat {{item.unsupported ? 'svc-home-cat-off' : ''}}" style="{{item.icon ? '' : 'background:' + item.bgColor + ';'}}">
          <image wx:if="{{item.icon}}" class="svc-icon-img" src="{{item.icon}}" mode="aspectFill" />
          <text wx:else class="svc-emoji">{{item.emoji}}</text>
        </view>
        <text class="svc-home-cat-label">{{item.name}}</text>
        <text class="svc-home-cat-status-off" wx:if="{{item.saleStatusText}}">{{item.saleStatusText}}</text>
      </view>
    </view>
    <view class="quick-nav">
      <navigator class="quick-item" wx:for="{{quickActions}}" wx:key="name" url="{{item.url || '../classify/classify'}}">
        <view class="quick-icon-wrap" style="background:{{item.icon ? 'transparent' : item.bgColor}}">
          <image wx:if="{{item.icon}}" class="quick-icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text wx:else class="quick-emoji">{{item.emoji}}</text>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>
  </view>

  <view class="card section-card" wx:if="{{thirdPartyMiniPrograms.length > 0}}">
    <view class="section-head">
      <text class="title">便民服务</text>
    </view>
    <view class="mini-program-grid">
      <view class="mini-program-item" wx:for="{{thirdPartyMiniPrograms}}" wx:key="name" bindtap="jumpToMiniProgram" data-idx="{{index}}">
        <image class="mini-program-icon" src="{{item.icon}}" mode="aspectFit"></image>
        <text class="mini-program-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head neighborhood-head">
      <view class="title-wrap">
        <text class="title">邻里帮帮</text>
        <text class="assist-tag">解决身边琐事小烦恼</text>
      </view>
      <text class="more" bindtap="goNeighborCommunity">查看更多 ></text>
    </view>
    <scroll-view class="assist-marquee" scroll-x="{{true}}" show-scrollbar="{{false}}" wx:if="{{assistMarqueeList.length}}">
      <view class="assist-marquee-inner">
        <view
          class="marquee-chip"
          wx:for="{{assistMarqueeList}}"
          wx:key="id"
          bindtap="goAssistFromMarquee"
          data-id="{{item.id}}"
        >{{item.text}}</view>
      </view>
    </scroll-view>
    <view class="knowledge-row neighborhood-services">
      <navigator class="knowledge-item" wx:for="{{knowledgeList}}" wx:key="name" url="{{item.url}}">
        <view class="know-icon-wrap" style="background:{{item.icon ? '#ffffff' : item.bgColor}}">
          <image wx:if="{{item.icon}}" class="know-icon-img" src="{{item.icon}}" mode="aspectFit" />
          <text wx:else class="know-emoji">{{item.emoji}}</text>
        </view>
        <text>{{item.name}}</text>
      </navigator>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head hot">
      <text class="title">小区热卖榜</text>
      <text class="more">查看更多 ></text>
    </view>
    <scroll-view class="hot-scroll" scroll-x="{{true}}">
      <view class="hot-wrap">
        <navigator class="hot-item" wx:for="{{hotList}}" wx:key="id" url="{{item.itemType === 'shop' ? '../market-shop/market-shop?id=' + item.id : '../service/service?id=' + item.id}}">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <text class="hot-rank">{{item.rank}}</text>
          <text class="hot-name">{{item.name}}</text>
          <text class="hot-price">￥{{item.price}}/次</text>
        </navigator>
      </view>
    </scroll-view>
    <view class="hot-filter-row">
      <view class="hot-filter" wx:for="{{hotFilters}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head">
      <text class="title">直约服务商</text>
      <view class="section-head-actions">
        <view class="portal-entry-btn" bindtap="goServiceProviderPortal">进入工作台</view>
        <navigator class="more" url="../classify/classify">全部 ></navigator>
      </view>
    </view>
    <view class="merchant-list">
      <navigator class="merchant-item" wx:for="{{merchantList}}" wx:key="id" url="{{item.url}}">
        <image src="{{item.image}}" mode="aspectFill"></image>
        <view class="merchant-text">
          <text class="name">{{item.name}}</text>
          <text class="sub">{{item.sub}}</text>
        </view>
      </navigator>
    </view>
  </view>

  <view class="card section-card">
    <view class="section-head">
      <text class="title">直约技工</text>
      <navigator class="more" url="../classify/classify">查看全部 ></navigator>
    </view>
    <scroll-view class="worker-scroll" scroll-x="{{true}}">
      <view class="worker-row">
        <navigator class="worker-item worker-item--rich" wx:for="{{workerList}}" wx:key="id" url="../worker-detail/worker-detail?id={{item.id}}">
          <image class="worker-av" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="worker-text">
            <view class="worker-name-row">
              <text class="name">{{item.name}}</text>
              <text class="gender-label" wx:if="{{item.genderLabel}}">{{item.genderLabel}}</text>
            </view>
            <text class="worker-dir">主营：{{item.mainDirection}}</text>
            <text class="worker-intro" wx:if="{{item.intro}}">{{item.intro}}</text>
            <text class="sub">{{item.orders}}</text>
          </view>
        </navigator>
      </view>
    </scroll-view>
  </view>

  <view class="card section-card">
    <view class="section-head">
      <text class="title">管家精选</text>
    </view>
    <view class="market-grid">
      <navigator class="market-item" wx:for="{{marketList}}" wx:key="id" url="../goods-detail/goods-detail?id={{item.id}}">
        <image src="{{item.image}}" mode="aspectFill"></image>
        <text class="name">{{item.name}}</text>
        <text class="price" wx:if="{{item.price}}">￥{{item.price}}</text>
      </navigator>
    </view>
  </view>
  </view>

  <view class="fake-tabbar-space"></view>

  <view class="modal" wx:if="{{showGetTelModal}}">
    系统需要获取您的手机号码以方便客户与您联系
    <button open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber">同意获取手机号码 </button>
  </view>
</view>
