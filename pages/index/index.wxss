@import "../../tpl/notask/notask.wxss";
@import "../../tpl/liorder/liorder.wxss";

.home-page {
  background: #f2f3f5;
  min-height: 100vh;
}

.top-wrap {
  position: relative;
  z-index: 10;
  background: #f97316;
  padding: 18rpx 20rpx 26rpx;
  color: #fff;
}

.top-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 18rpx;
}

.top-tab {
  font-size: 34rpx;
  font-weight: 500;
  opacity: 0.88;
  margin-right: 30rpx;
}

.top-tab.active {
  font-weight: 700;
  opacity: 1;
  text-decoration: underline;
}

.top-entry {
  width: 88rpx;
  height: 52rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.top-entry .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  margin-left: 8rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.location-pill {
  height: 48rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #222;
  padding: 0 14rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  max-width: 150rpx;
}

.loc-icon {
  font-size: 20rpx;
  line-height: 1;
  flex-shrink: 0;
}

.loc-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.search-input {
  flex: 1;
  height: 48rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #9a9a9a;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.search-field {
  flex: 1;
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #333;
}

.search-btn {
  width: 92rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #d91f16;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.card {
  background: #fff;
  margin: 14rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.panel-grid {
  padding: 20rpx 0 10rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}

.service-item .svc-icon-wrap,
.svc-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.svc-icon-img {
  width: 88rpx;
  height: 88rpx;
}

.service-item text {
  font-size: 22rpx;
  color: #1f1f1f;
  margin-top: 10rpx;
}

/* 棣栭〉銆屾暣鐞嗘敹绾炽€嶁€︺€屼笂闂ㄧ編涓氥€嶏細涓庛€岀洿绾︽湇鍔″晢銆峬erchant-item 涓€鑷寸殑鏆栫伆搴曘€佸渾瑙掔缉鐣ュ浘銆佹鎻忚竟 */
.panel-grid .service-grid .service-item .svc-icon-wrap.svc-home-cat {
  width: 92rpx;
  height: 92rpx;
  border-radius: 12rpx;
  background: #f9f9f9;
  border: 2rpx solid rgba(255, 122, 0, 0.22);
  box-shadow: 0 2rpx 10rpx rgba(255, 122, 0, 0.06);
  box-sizing: border-box;
}

.panel-grid .service-grid .service-item .svc-icon-wrap.svc-home-cat .svc-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.panel-grid .service-grid .service-item .svc-home-cat-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #212121;
  margin-top: 12rpx;
}

.home-cat-cell {
  min-height: 168rpx;
}

.svc-home-cat-off {
  opacity: 0.78;
}

.svc-home-cat-status-off {
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #d93025;
  line-height: 1.3;
}

.quick-nav {
  display: flex;
  border-top: 1rpx solid #f1f1f1;
  padding-top: 16rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon-img {
  width: 54rpx;
  height: 54rpx;
}

.quick-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.quick-item text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #303030;
}

.mini-program-grid {
  display: flex;
  padding: 0 20rpx 20rpx;
  gap: 20rpx;
}

.mini-program-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.mini-program-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.mini-program-name {
  font-size: 24rpx;
  color: #333;
}

.section-card {
  padding: 0 0 14rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
}

.section-head .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.section-head .more {
  color: #9d9d9d;
  font-size: 22rpx;
}

.section-head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.portal-entry-btn {
  background: #ff6b35;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  line-height: 1.4;
}

.knowledge-row {
  display: flex;
  padding: 0 16rpx 12rpx;
}

.knowledge-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.know-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.know-icon-img {
  width: 78rpx;
  height: 78rpx;
}

.know-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.knowledge-item text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2e2e2e;
}

.neighborhood-head .title-wrap {
  display: flex;
  align-items: center;
}

.assist-tag {
  margin-left: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #FFF4E8;
  color: #F97316;
  font-size: 18rpx;
}

.assist-marquee {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.assist-marquee-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.marquee-chip {
  display: inline-block;
  max-width: 420rpx;
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  color: #475569;
  background: #fff7ed;
  border: 1rpx solid #ffedd5;
  border-radius: 999rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.neighborhood-services {
  padding-bottom: 18rpx;
}

.neighborhood-services .know-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.hot-scroll {
  white-space: nowrap;
  padding-bottom: 6rpx;
}

.hot-wrap {
  display: flex;
  padding: 0 14rpx;
}

.hot-item {
  width: 168rpx;
  margin-right: 12rpx;
  position: relative;
}

.hot-item image {
  width: 168rpx;
  height: 130rpx;
  border-radius: 10rpx;
}

.hot-rank {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 122, 0, 0.9);
  color: #fff;
  font-size: 18rpx;
}

.hot-name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2f2f2f;
}

.hot-price {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #F97316;
}

.hot-filter-row {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 14rpx 0;
}

.hot-filter {
  margin: 0 10rpx 10rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #4b4b4b;
  font-size: 20rpx;
}

.merchant-list {
  padding: 0 14rpx;
}

.merchant-item {
  display: flex;
  align-items: center;
  padding: 14rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.merchant-item image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 10rpx;
}

.merchant-text {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}

.merchant-text .name {
  font-size: 26rpx;
  color: #212121;
}

.merchant-text .sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9f9f9f;
}

.worker-scroll {
  white-space: nowrap;
}

.worker-row {
  display: flex;
  padding: 0 14rpx;
}

.worker-item {
  width: 190rpx;
  margin-right: 12rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  padding: 14rpx 0;
}

.worker-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.worker-item .name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.worker-item .sub {
  display: block;
  margin-top: 6rpx;
  color: #9e9e9e;
  font-size: 20rpx;
}

/* 鐩寸害鎶€宸ワ細澶村儚 + 濮撳悕/鎬у埆/涓昏惀/绠€浠?*/
.worker-item--rich {
  width: 300rpx;
  display: inline-flex;
  flex-direction: row;
  align-items: flex-start;
  text-align: left;
  padding: 16rpx 14rpx;
  box-sizing: border-box;
  vertical-align: top;
  white-space: normal;
}

.worker-item--rich .worker-av {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.worker-item--rich .worker-text {
  flex: 1;
  min-width: 0;
}

.worker-item--rich .worker-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.worker-item--rich .name {
  margin-top: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.worker-item--rich .gender-label {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(90deg, #fb923c, #f97316);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.worker-item--rich .worker-dir {
  display: block;
  font-size: 20rpx;
  color: #ea580c;
  margin-top: 6rpx;
}

.worker-item--rich .worker-intro {
  display: block;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
  line-height: 1.35;
  max-height: 54rpx;
  overflow: hidden;
}

.worker-item--rich .sub {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.market-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}

.market-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.market-item image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
}

.market-item .name {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #2c2c2c;
}

.market-item .price {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #F97316;
}

.fake-tabbar-space {
  height: 120rpx;
}

.publish-btn {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: #000000;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 110rpx;
  z-index: 99;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 0, 0.38);
}

.modal {
  position: fixed;
  top: 25%;
  left: 0;
  width: 50%;
  margin: 0 auto;
  text-align: center;
  background-color: #fff;
  padding: 60rpx;
  border-radius: 20rpx;
  right: 0;
  border: 1px solid #eee;
  font-size: 32rpx;
}

.modal button {
  margin-top: 20rpx;
  background-color: #d81e06;
  color: #fff;
}

/* =============================
   鏈湴鍟嗗煄 (JiaTui) 鏂扮増鏍峰紡閲嶆瀯 
   ============================= */
.jiatui-wrapper {
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 妯″潡涓€锛氶《绾ц宸捣鎶ュ尯 */
.jt-hero {
  position: relative; /* 闄愬埗缁濆瀹氫綅鐨?Swiper 婧㈠嚭 */
  height: 280rpx;     /* 璁惧畾涓€涓叿浣撶殑鍥哄畾楂樺害锛岃€岄潪娴佸紡 padding */
  background: linear-gradient(180deg, #100b16 0%, #1f1433 60%, #ffe4e1 100%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.jt-hero-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1; /* 缃簬搴曞眰鑳屾櫙 */
}

.fs-hero-img {
  width: 100%;
  height: 100%;
  opacity: 0.8; /* 绋嶄綔鎻愪寒 */
}

.slide-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.slide-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2; /* 纭繚鏂囧瓧婕傛诞鍦ㄨ疆鎾浘涓?*/
  text-align: center;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}



.jt-hero-title {
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
  background: linear-gradient(180deg, #fff 0%, #ffe0b2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.jt-hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  background: #d6a171;
  color: #fff;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
}

/* 妯″潡浜岋細浜斿ぇ閲戝垰鍖?*/
.jt-categories {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 10rpx;
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx; /* 绉婚櫎璐烳argin锛屾仮澶嶆甯告枃妗ｆ祦 */
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.jt-cate-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.jt-cate-emoji-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.jt-cate-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.jt-cate-item text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #333;
}

/* 妯″潡涓夛細涓夎姳鑱氶《瀵艰喘绐?*/
.jt-promo-grid {
  display: flex;
  padding: 0 20rpx;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.jt-promo-left, .jt-promo-right {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  position: relative;
  height: 200rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  border: 4rpx solid #FFE8D6;
}

.jt-promo-left image, .jt-promo-right image {
  width: 120rpx;
  height: 120rpx;
  position: absolute;
  top: 16rpx;
}

.jt-promo-left .tag, .jt-promo-right .tag {
  background: #000000;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx 8rpx 0 0;
  width: 80%;
  text-align: center;
  z-index: 2;
}

.jt-promo-mid {
  flex: 2;
  background: linear-gradient(135deg, #FFF5EB, #FFECD9);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #FFD4B8;
}

.jt-promo-mid .title {
  font-size: 34rpx;
  font-weight: 800;
  color: #d12e1a;
  text-shadow: 1rpx 1rpx 0 #fff;
}

.jt-promo-mid .sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #fff;
  background: #FF934A;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}

/* 妯″潡鍥涳細涓婃柊涓庣儹鍗栨 */
.jt-sales-row {
  display: flex;
  padding: 0 20rpx;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.jt-daily-news, .jt-top-sales {
  flex: 1;
  border-radius: 16rpx;
  background: #fff;
  padding: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.jt-daily-news {
  background: #fff5f8;
}

.jt-top-sales {
  background: #fffcf2;
  display: flex;
  flex-direction: column;
}

.jt-sales-row .head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.jt-sales-row .head .title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111;
}

.jt-sales-row .head-icon {
  width: 40rpx;
  height: 40rpx;
}

.jt-daily-news .grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.jt-daily-news .news-item {
  width: 100%; /* 鐢?Grid 鐖剁骇鍒嗛厤 */
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.jt-daily-news .news-item image {
  width: 100%;
  height: 160rpx;
  object-fit: cover;
}

.rebate-tag {
  background: #000000;
  color: #fff;
  font-size: 16rpx; /* 瀛椾綋鏀瑰皬涓€鐐归€傚簲绐勫垪 */
  padding: 4rpx 8rpx;
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  position: absolute;
  top: 130rpx; /* 绱ц创鍥剧墖涓嬫部 */
  left: 0;
  z-index: 2;
  white-space: nowrap; /* 淇濊瘉鏂囧瓧涓嶆崲琛?*/
  transform: scale(0.9);
  transform-origin: left bottom;
}

.jt-daily-news .price-row {
  color: #FF7700;
  padding: 8rpx 6rpx;
  display: flex;
  align-items: baseline;
}
.jt-daily-news .price-row .yen { font-size: 16rpx; }
.jt-daily-news .price-row .num { font-size: 24rpx; font-weight: 700; }

.jt-top-sales .list {
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* 鑷€傚簲楂樺害骞冲潎鍒嗗竷 */
  flex: 1;
}

.jt-top-sales .top-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
