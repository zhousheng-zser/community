@import "../../tpl/notask/notask.wxss";
@import "../../tpl/liorder/liorder.wxss";

.home-page {
  background: #f2f3f5;
  min-height: 100vh;
}

.top-wrap {
  background: linear-gradient(180deg, #f6362b 0%, #ef3025 100%);
  padding: 18rpx 20rpx 26rpx;
  color: #fff;
}

.top-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 18rpx;
}

.top-tab {
  font-size: 34rpx;
  font-weight: 500;
  opacity: 0.88;
  margin-right: 30rpx;
}

.top-tab.active {
  font-weight: 700;
  opacity: 1;
  text-decoration: underline;
}

.top-entry {
  width: 88rpx;
  height: 52rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.top-entry .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  margin-left: 8rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.location-pill {
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #222;
  padding: 0 18rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  margin-right: 10rpx;
}

.dot-black {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #111;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  height: 56rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #9a9a9a;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.search-field {
  flex: 1;
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #333;
}

.search-btn {
  width: 92rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #d91f16;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.card {
  background: #fff;
  margin: 14rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.panel-grid {
  padding: 20rpx 0 10rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}

.service-item image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
}

.service-item text {
  font-size: 22rpx;
  color: #1f1f1f;
  margin-top: 10rpx;
}

.quick-nav {
  display: flex;
  border-top: 1rpx solid #f1f1f1;
  padding-top: 16rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-item image {
  width: 46rpx;
  height: 46rpx;
}

.quick-item text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #303030;
}

.promo-swiper {
  height: 170rpx;
}

.slide-image {
  width: 100%;
  height: 170rpx;
}

.section-card {
  padding: 0 0 14rpx;
}

.section-head {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 18rpx 20rpx;
}

.section-head .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.section-head .more {
  color: #9d9d9d;
  font-size: 22rpx;
}

.knowledge-row {
  display: flex;
  padding: 0 16rpx 12rpx;
}

.knowledge-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.knowledge-item image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
}

.knowledge-item text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2e2e2e;
}

.neighborhood-head .title-wrap {
  display: flex;
  align-items: center;
}

.assist-tag {
  margin-left: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #ffefeb;
  color: #f44336;
  font-size: 18rpx;
}

.neighborhood-services {
  padding-bottom: 18rpx;
}

.neighborhood-services .knowledge-item image {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.hot-scroll {
  white-space: nowrap;
  padding-bottom: 6rpx;
}

.hot-wrap {
  display: flex;
  padding: 0 14rpx;
}

.hot-item {
  width: 168rpx;
  margin-right: 12rpx;
  position: relative;
}

.hot-item image {
  width: 168rpx;
  height: 130rpx;
  border-radius: 10rpx;
}

.hot-rank {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(239, 50, 37, 0.9);
  color: #fff;
  font-size: 18rpx;
}

.hot-name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2f2f2f;
}

.hot-price {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #f44336;
}

.hot-filter-row {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 14rpx 0;
}

.hot-filter {
  margin: 0 10rpx 10rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #4b4b4b;
  font-size: 20rpx;
}

.merchant-list {
  padding: 0 14rpx;
}

.merchant-item {
  display: flex;
  align-items: center;
  padding: 14rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.merchant-item image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 10rpx;
}

.merchant-text {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}

.merchant-text .name {
  font-size: 26rpx;
  color: #212121;
}

.merchant-text .sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9f9f9f;
}

.worker-scroll {
  white-space: nowrap;
}

.worker-row {
  display: flex;
  padding: 0 14rpx;
}

.worker-item {
  width: 190rpx;
  margin-right: 12rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  padding: 14rpx 0;
}

.worker-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.worker-item .name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.worker-item .sub {
  display: block;
  margin-top: 6rpx;
  color: #9e9e9e;
  font-size: 20rpx;
}

.market-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}

.market-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.market-item image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
}

.market-item .name {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #2c2c2c;
}

.market-item .price {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #f44336;
}

.fake-tabbar-space {
  height: 120rpx;
}

.publish-btn {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: linear-gradient(180deg, #ff6d5e 0%, #f33d30 100%);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 110rpx;
  z-index: 99;
  box-shadow: 0 8rpx 20rpx rgba(244, 67, 54, 0.4);
}

.modal {
  position: fixed;
  top: 25%;
  left: 0;
  width: 50%;
  margin: 0 auto;
  text-align: center;
  background-color: #fff;
  padding: 60rpx;
  border-radius: 20rpx;
  right: 0;
  border: 1px solid #eee;
  font-size: 32rpx;
}

.modal button {
  margin-top: 20rpx;
  background-color: #d81e06;
  color: #fff;
}

.push-hero,
.fuka-banner,
.market-banner {
  position: relative;
  height: 220rpx;
}

.push-hero image,
.fuka-banner image,
.market-banner image {
  width: 100%;
  height: 220rpx;
}

.push-hero .mask,
.fuka-banner .mask {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  color: #fff;
}

.push-hero .title,
.fuka-banner .title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.push-hero .sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.push-cate {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 10rpx;
}

.push-cate-item {
  width: 20%;
  text-align: center;
}

.push-cate-item image {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
}

.push-cate-item text {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
}

.push-promo-grid {
  display: flex;
  padding: 12rpx;
}

.push-promo-item {
  flex: 1;
  background: #fff5f2;
  border-radius: 12rpx;
  margin: 0 6rpx;
  overflow: hidden;
}

.push-promo-item image {
  width: 100%;
  height: 110rpx;
}

.push-promo-item .info {
  padding: 10rpx;
}

.push-promo-item .name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.push-promo-item .desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #888;
}

.push-list {
  padding: 0 12rpx 12rpx;
}

.push-good {
  display: flex;
  background: #fff;
  border: 1rpx solid #f0f0f0;
  border-radius: 12rpx;
  margin-top: 12rpx;
  padding: 10rpx;
}

.push-good image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
}

.push-good .right {
  margin-left: 12rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.push-good .name {
  font-size: 24rpx;
  color: #202020;
}

.push-good .bottom {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.push-good .price {
  font-size: 26rpx;
  color: #f44336;
  font-weight: 700;
}

.push-good .buy-btn {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #ff5e4f;
  color: #fff;
  font-size: 20rpx;
}

.fuka-local-grid,
.fuka-service-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx 14rpx;
}

.fuka-local-item,
.fuka-service-item {
  width: 20%;
  text-align: center;
  margin-top: 12rpx;
}

.fuka-local-item image,
.fuka-service-item image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.fuka-local-item text,
.fuka-service-item text {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
}

.fuka-open-card {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(90deg, #ff755f 0%, #ff503f 100%);
  color: #fff;
}

.fuka-open-card .title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.fuka-open-card .sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.95;
}

.fuka-open-card .go {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.fuka-topic-grid {
  display: flex;
  padding: 10rpx 10rpx 14rpx;
}

.fuka-topic-item {
  flex: 1;
  margin: 0 6rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.fuka-topic-item image {
  width: 100%;
  height: 180rpx;
}

.fuka-topic-item .mask {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  color: #fff;
}

.fuka-topic-item .title {
  display: block;
  font-size: 22rpx;
}

.fuka-topic-item .price {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.fuka-filter-tabs {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.fuka-filter-tabs .tab {
  font-size: 24rpx;
  color: #777;
}

.fuka-filter-tabs .tab.active {
  color: #f44336;
  font-weight: 700;
}

.fuka-goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx;
}

.fuka-goods-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.fuka-goods-item image {
  width: 100%;
  height: 210rpx;
  border-radius: 12rpx;
}

.fuka-goods-item .name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.fuka-goods-item .price {
  display: block;
  margin-top: 6rpx;
  color: #f44336;
}

.market-top-cats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 10rpx;
}

.market-top-item {
  width: 33.33%;
  text-align: center;
}

.market-top-item image {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
}

.market-top-item text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
}

.market-banner .cta {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  font-size: 20rpx;
  color: #fff;
  background: #ff5f4e;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.market-title-row {
  display: flex;
  align-items: center;
  margin: 18rpx 20rpx 8rpx;
}

.market-title-row .near {
  color: #ef3e2f;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.market-title-row .shop {
  font-size: 30rpx;
  font-weight: 700;
}

.market-filter-row {
  display: flex;
  justify-content: flex-start;
  padding: 16rpx 20rpx;
}

.market-filter-row .market-filter {
  font-size: 22rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
}

.market-shop-card {
  padding: 14rpx;
}

.shop-head {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.shop-head .name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.shop-head .badge {
  font-size: 20rpx;
  background: #f44336;
  color: #fff;
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
}

.shop-meta {
  margin-top: 8rpx;
  color: #8f8f8f;
  font-size: 22rpx;
}

.shop-meta .sold {
  margin-left: 16rpx;
}

.shop-goods-scroll {
  white-space: nowrap;
  margin-top: 14rpx;
}

.shop-goods-row {
  display: flex;
}

.shop-goods-item {
  width: 150rpx;
  margin-right: 12rpx;
}

.shop-goods-item image {
  width: 150rpx;
  height: 110rpx;
  border-radius: 8rpx;
}

.shop-goods-item .g-name {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
}

.shop-goods-item .g-price {
  display: block;
  margin-top: 4rpx;
  color: #f44336;
  font-size: 20rpx;
}
