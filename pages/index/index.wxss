@import "../../tpl/notask/notask.wxss";
@import "../../tpl/liorder/liorder.wxss";

.home-page {
  background: #f2f3f5;
  min-height: 100vh;
}

.top-wrap {
  position: relative;
  z-index: 10;
  background: linear-gradient(180deg, #f6362b 0%, #ef3025 100%);
  padding: 18rpx 20rpx 26rpx;
  color: #fff;
}

.top-tabs {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 18rpx;
}

.top-tab {
  font-size: 34rpx;
  font-weight: 500;
  opacity: 0.88;
  margin-right: 30rpx;
}

.top-tab.active {
  font-weight: 700;
  opacity: 1;
  text-decoration: underline;
}

.top-entry {
  width: 88rpx;
  height: 52rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.top-entry .dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
  margin-left: 8rpx;
}

.search-row {
  display: flex;
  align-items: center;
}

.location-pill {
  height: 48rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #222;
  padding: 0 14rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  max-width: 150rpx;
}

.loc-icon {
  font-size: 20rpx;
  line-height: 1;
  flex-shrink: 0;
}

.loc-text {
  font-size: 20rpx;
  font-weight: 500;
  color: #222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.search-input {
  flex: 1;
  height: 48rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #9a9a9a;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
}

.search-field {
  flex: 1;
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #333;
}

.search-btn {
  width: 92rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #d91f16;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  margin-left: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.card {
  background: #fff;
  margin: 14rpx 16rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.panel-grid {
  padding: 20rpx 0 10rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 18rpx;
}

.service-item .svc-icon-wrap,
.svc-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.svc-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.service-item text {
  font-size: 22rpx;
  color: #1f1f1f;
  margin-top: 10rpx;
}

.quick-nav {
  display: flex;
  border-top: 1rpx solid #f1f1f1;
  padding-top: 16rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.quick-item text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #303030;
}

.promo-swiper {
  height: 170rpx;
}

.slide-image {
  width: 100%;
  height: 170rpx;
}

.section-card {
  padding: 0 0 14rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
}

.section-head .title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
}

.section-head .more {
  color: #9d9d9d;
  font-size: 22rpx;
}

.knowledge-row {
  display: flex;
  padding: 0 16rpx 12rpx;
}

.knowledge-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.know-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.know-emoji {
  font-size: 34rpx;
  line-height: 1;
}

.knowledge-item text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2e2e2e;
}

.neighborhood-head .title-wrap {
  display: flex;
  align-items: center;
}

.assist-tag {
  margin-left: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #ffefeb;
  color: #f44336;
  font-size: 18rpx;
}

.neighborhood-services {
  padding-bottom: 18rpx;
}

.neighborhood-services .know-icon-wrap {
  width: 78rpx;
  height: 78rpx;
  border-radius: 39rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.hot-scroll {
  white-space: nowrap;
  padding-bottom: 6rpx;
}

.hot-wrap {
  display: flex;
  padding: 0 14rpx;
}

.hot-item {
  width: 168rpx;
  margin-right: 12rpx;
  position: relative;
}

.hot-item image {
  width: 168rpx;
  height: 130rpx;
  border-radius: 10rpx;
}

.hot-rank {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(239, 50, 37, 0.9);
  color: #fff;
  font-size: 18rpx;
}

.hot-name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2f2f2f;
}

.hot-price {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #f44336;
}

.hot-filter-row {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx 14rpx 0;
}

.hot-filter {
  margin: 0 10rpx 10rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #4b4b4b;
  font-size: 20rpx;
}

.merchant-list {
  padding: 0 14rpx;
}

.merchant-item {
  display: flex;
  align-items: center;
  padding: 14rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.merchant-item image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 10rpx;
}

.merchant-text {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}

.merchant-text .name {
  font-size: 26rpx;
  color: #212121;
}

.merchant-text .sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9f9f9f;
}

.worker-scroll {
  white-space: nowrap;
}

.worker-row {
  display: flex;
  padding: 0 14rpx;
}

.worker-item {
  width: 190rpx;
  margin-right: 12rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  text-align: center;
  padding: 14rpx 0;
}

.worker-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}

.worker-item .name {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
}

.worker-item .sub {
  display: block;
  margin-top: 6rpx;
  color: #9e9e9e;
  font-size: 20rpx;
}

.market-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}

.market-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.market-item image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
}

.market-item .name {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #2c2c2c;
}

.market-item .price {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #f44336;
}

.fake-tabbar-space {
  height: 120rpx;
}

.publish-btn {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: linear-gradient(180deg, #ff6d5e 0%, #f33d30 100%);
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  line-height: 110rpx;
  z-index: 99;
  box-shadow: 0 8rpx 20rpx rgba(244, 67, 54, 0.4);
}

.modal {
  position: fixed;
  top: 25%;
  left: 0;
  width: 50%;
  margin: 0 auto;
  text-align: center;
  background-color: #fff;
  padding: 60rpx;
  border-radius: 20rpx;
  right: 0;
  border: 1px solid #eee;
  font-size: 32rpx;
}

.modal button {
  margin-top: 20rpx;
  background-color: #d81e06;
  color: #fff;
}

/* =============================
   家推 (JiaTui) 新版样式重构 
   ============================= */
.jiatui-wrapper {
  background: #f7f8fa;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

/* 模块一：顶级视差海报区 */
.jt-hero {
  position: relative; /* 限制绝对定位的 Swiper 溢出 */
  height: 280rpx;     /* 设定一个具体的固定高度，而非流式 padding */
  background: linear-gradient(180deg, #100b16 0%, #1f1433 60%, #ffe4e1 100%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.jt-hero-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1; /* 置于底层背景 */
}

.fs-hero-img {
  width: 100%;
  height: 100%;
  opacity: 0.8; /* 稍作提亮 */
}

.slide-wrap {
  position: relative;
  width: 100%;
  height: 100%;
}

.slide-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2; /* 确保文字漂浮在轮播图上 */
  text-align: center;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.jt-hero-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.jt-hero-title {
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.5);
  background: linear-gradient(180deg, #fff 0%, #ffe0b2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.jt-hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  background: #d6a171;
  color: #fff;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
}

/* 模块二：五大金刚区 */
.jt-categories {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 10rpx;
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx; /* 移除负Margin，恢复正常文档流 */
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.jt-cate-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.jt-cate-emoji-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.jt-cate-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.jt-cate-item text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #333;
}

/* 模块三：三花聚顶导购窗 */
.jt-promo-grid {
  display: flex;
  padding: 0 20rpx;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.jt-promo-left, .jt-promo-right {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  position: relative;
  height: 200rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  border: 4rpx solid #ffe9e9;
}

.jt-promo-left image, .jt-promo-right image {
  width: 120rpx;
  height: 120rpx;
  position: absolute;
  top: 16rpx;
}

.jt-promo-left .tag, .jt-promo-right .tag {
  background: linear-gradient(90deg, #ff7e70, #ff4d3d);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx 8rpx 0 0;
  width: 80%;
  text-align: center;
  z-index: 2;
}

.jt-promo-mid {
  flex: 2;
  background: linear-gradient(135deg, #fff0ed, #ffdfd6);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #ffcec5;
}

.jt-promo-mid .title {
  font-size: 34rpx;
  font-weight: 800;
  color: #d12e1a;
  text-shadow: 1rpx 1rpx 0 #fff;
}

.jt-promo-mid .sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #fff;
  background: #ff5f4e;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}

/* 模块四：上新与热卖榜 */
.jt-sales-row {
  display: flex;
  padding: 0 20rpx;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.jt-daily-news, .jt-top-sales {
  flex: 1;
  border-radius: 16rpx;
  background: #fff;
  padding: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.jt-daily-news {
  background: #fff5f8;
}

.jt-top-sales {
  background: #fffcf2;
  display: flex;
  flex-direction: column;
}

.jt-sales-row .head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.jt-sales-row .head .title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111;
}

.jt-sales-row .head-icon {
  width: 40rpx;
  height: 40rpx;
}

.jt-daily-news .grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.jt-daily-news .news-item {
  width: 100%; /* 由 Grid 父级分配 */
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.jt-daily-news .news-item image {
  width: 100%;
  height: 160rpx;
  object-fit: cover;
}

.rebate-tag {
  background: linear-gradient(90deg, #ff7e70, #ff4c3b);
  color: #fff;
  font-size: 16rpx; /* 字体改小一点适应窄列 */
  padding: 4rpx 8rpx;
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  position: absolute;
  top: 130rpx; /* 紧贴图片下沿 */
  left: 0;
  z-index: 2;
  white-space: nowrap; /* 保证文字不换行 */
  transform: scale(0.9);
  transform-origin: left bottom;
}

.jt-daily-news .price-row {
  color: #ff4d3d;
  padding: 8rpx 6rpx;
  display: flex;
  align-items: baseline;
}
.jt-daily-news .price-row .yen { font-size: 16rpx; }
.jt-daily-news .price-row .num { font-size: 24rpx; font-weight: 700; }

.jt-top-sales .list {
  display: flex;
  flex-direction: column;
  justify-content: space-between; /* 自适应高度平均分布 */
  flex: 1;
}

.jt-top-sales .top-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 10rpx 12rpx;
  align-items: center;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.rank-badge {
  position: absolute;
  left: 0;
  top: 0;
  background: linear-gradient(135deg, #e4cca2, #cca062);
  color: #fff;
  padding: 4rpx 10rpx;
  border-radius: 12rpx 0 12rpx 0;
  text-align: center;
  z-index: 2;
  box-shadow: 2rpx 2rpx 6rpx rgba(204,160,98,0.4);
}

.rank-badge .top { font-size: 16rpx; display: block; }
.rank-badge .num { font-size: 22rpx; font-weight: bold; }

.jt-top-sales .top-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.jt-top-sales .info {
  flex: 1;
}

.jt-top-sales .name {
  font-size: 22rpx;
  color: #333;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.jt-top-sales .info .rebate-tag {
  display: inline-block;
  background: #ffeeec;
  color: #ff4d3d;
  margin-top: 10rpx;
  border-radius: 4rpx;
  padding: 4rpx 8rpx;
  font-size: 18rpx;
}

/* 模块五：两级直播推介窗 */
.jt-live-section {
  margin: 0 20rpx 20rpx;
  background: linear-gradient(180deg, #fff0ec 0%, #fff 40%);
  border-radius: 16rpx;
  padding: 20rpx;
}

.jt-live-section .section-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.jt-live-section .section-head .title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111;
}

.jt-live-section .section-head .red {
  color: #ff4d3d;
}

.jt-live-section .section-head .sub {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ff4d3d;
}

.jt-live-section .section-head .more {
  margin-left: auto;
  font-size: 22rpx;
  color: #666;
}

.live-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.live-card .logo-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
}

.live-card .logo-wrap image, .live-card .circle-sign {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #ff4d3d;
}

.live-card .circle-sign {
  background: #d32f2f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.live-card .circle-sign .city {
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 0 10rpx;
}

.live-card .live-badge {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #ff4d3d;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
  white-space: nowrap;
}

.live-card .live-badge.grey {
  background: #999;
}
.live-card .logo-wrap.closed .circle-sign {
  border-color: #999;
}

.live-card .info {
  flex: 1;
}

.live-card .brand {
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
  display: block;
}

.live-card .sub {
  font-size: 22rpx;
  color: #888;
  display: block;
  margin-top: 4rpx;
}

.live-card .bottom {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.live-card .rebate {
  background: rgba(255, 77, 61, 0.1);
  color: #ff4d3d;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.live-card .promoters {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #999;
}

.live-card .push-btn {
  background: #ff4d3d;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  line-height: normal;
  margin: 0;
}

.local-pavilion {
  background: linear-gradient(180deg, #fff2f2 0%, #fff 20%);
}

.pavilion-swiper {
  height: 380rpx;
  margin-bottom: 20rpx;
}

.pavilion-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  padding: 0 10rpx;
}

.p-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}



.p-item image {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
}

.p-item.active image {
  border-color: #ff4d3d;
}

.p-item text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #333;
}
.p-item.active text { color: #ff4d3d; }

/* 模块六：热门带货视频 */
.jt-video-section {
  background: #fff;
  padding: 20rpx;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.jt-video-section .section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.jt-video-section .title {
  font-size: 32rpx;
  font-weight: 800;
}

.jt-video-section .more {
  font-size: 22rpx;
  color: #666;
}

.video-scroll {
  white-space: nowrap;
  padding-bottom: 20rpx; /* 留出底部滚动条空间 */
}

/* 自定义胶囊滚动条 */
.custom-scrollbar {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 10rpx;
}

.scrollbar-track {
  width: 80rpx; /* 轨道总长变长，更易感知滑动 */
  height: 8rpx;
  background: #eee;
  border-radius: 4rpx;
  position: relative;
  overflow: hidden;
}

.scrollbar-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 40rpx; /* 胶囊长度，可滑动范围就是 track宽 - thumb宽 = 40rpx左右 */
  height: 8rpx;
  background: #ff4d3d;
  border-radius: 4rpx;
}

.video-row {
  white-space: nowrap;
}

.video-card {
  width: 320rpx;
  display: inline-block;
  vertical-align: top;
  margin-right: 20rpx;
  white-space: normal;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #eee;
}

.video-card .cover-wrap {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.video-card .cover-wrap image {
  width: 100%;
  height: 100%;
}

.video-card .play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.4);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #fff;
}

.video-card .bottom-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 10rpx;
  box-sizing: border-box;
  background: linear-gradient(0deg, rgba(0,0,0,0.6) 0%, transparent 100%);
  display: flex;
  justify-content: space-between;
  color: #fff;
  font-size: 20rpx;
}

.video-card .v-details {
  padding: 12rpx;
  background: #fff;
}

.video-card .v-details .title {
  font-size: 24rpx;
  color: #222;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  font-weight: normal;
}

.video-card .v-details .price {
  color: #333;
  font-size: 24rpx;
  display: block;
  margin-top: 6rpx;
}

.video-card .v-details .share {
  background: rgba(255, 77, 61, 0.1);
  color: #ff4d3d;
  font-size: 20rpx;
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

/* 模块七：长效商品流瀑布 */
.jt-feed-section {
  padding: 0 20rpx;
}

.feed-tabs {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  position: sticky;
  top: var(--sticky-top, 0); 
  background: inherit; /* 继承父容器背景，确保视觉统一 */
  z-index: 100;
}

/* 确保分类导航也能正确吸顶 */
.sub-tabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
  position: sticky;
  top: var(--sticky-top, 0);
  background: #f7f8fa;
  z-index: 99;
  padding: 10rpx 0;
}

.feed-tabs .tab {
  font-size: 28rpx;
  color: #555;
  padding-bottom: 8rpx;
  position: relative;
}

.feed-tabs .tab.active {
  color: #ff4d3d;
  font-weight: 700;
}

.feed-tabs .tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #ff4d3d;
}

.feed-goods-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 10rpx;
}

.f-card {
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #ffebea;
  padding: 16rpx;
  display: flex;
}

.f-card image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f1f1f1;
}

.f-info {
  margin-left: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.f-title {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.f-price {
  color: #ff4d3d;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: baseline;
}

.f-price .yen {
  font-size: 22rpx;
}

.f-price .tag {
  font-size: 18rpx;
  font-weight: normal;
  background: #333;
  color: #d1b17a;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.f-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #ff4d3d;
  border-radius: 30rpx;
  overflow: hidden;
}

.f-action .share {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #ff4d3d;
  padding: 8rpx 0;
}

.f-action .btn {
  background: #ff4d3d;
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
}

.view-more-line {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 30rpx 0;
}

.sub-tabs-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.sub-tabs {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.sub-tabs .tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #222;
  position: relative;
  padding: 10rpx 0;
}

.sub-tabs .tab-item.active {
  font-weight: 700;
}
.sub-tabs .tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #222;
}

.fuka-local-grid,
.fuka-service-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx 14rpx;
}

.fuka-local-item,
.fuka-service-item {
  width: 20%;
  text-align: center;
  margin-top: 12rpx;
}

.fuka-emoji-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.fuka-emoji {
  font-size: 30rpx;
  line-height: 1;
}

.fuka-local-item text,
.fuka-service-item text {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
}

.fuka-open-card {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 20rpx;
  background: linear-gradient(90deg, #ff755f 0%, #ff503f 100%);
  color: #fff;
}

.fuka-open-card .title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.fuka-open-card .sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.95;
}

.fuka-open-card .go {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.fuka-topic-grid {
  display: flex;
  padding: 10rpx 10rpx 14rpx;
}

.fuka-topic-item {
  flex: 1;
  margin: 0 6rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.fuka-topic-item image {
  width: 100%;
  height: 180rpx;
}

.fuka-topic-item .mask {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  color: #fff;
}

.fuka-topic-item .title {
  display: block;
  font-size: 22rpx;
}

.fuka-topic-item .price {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.fuka-filter-tabs {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.fuka-filter-tabs .tab {
  font-size: 24rpx;
  color: #777;
}

.fuka-filter-tabs .tab.active {
  color: #f44336;
  font-weight: 700;
}

.fuka-goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx;
}

.fuka-goods-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.fuka-goods-item image {
  width: 100%;
  height: 210rpx;
  border-radius: 12rpx;
}

.fuka-goods-item .name {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.fuka-goods-item .price {
  display: block;
  margin-top: 6rpx;
  color: #f44336;
}

.market-top-cats {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx;
}

.market-top-item {
  width: 20%;
  text-align: center;
  margin-bottom: 20rpx;
}

.market-emoji-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.market-emoji {
  font-size: 36rpx;
  line-height: 1;
}

.market-top-item text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
}

.market-title-row {
  display: flex;
  align-items: center;
  margin: 18rpx 20rpx 8rpx;
}

.market-title-row .near {
  color: #ef3e2f;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 16rpx;
}

.market-filter-row {
  display: flex;
  justify-content: flex-start;
  padding: 16rpx 20rpx;
}

.market-filter-row .market-filter {
  font-size: 22rpx;
  color: #666;
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
}

.market-shop-card {
  padding: 14rpx;
}

.shop-head {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.shop-head .name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.shop-head .badge {
  font-size: 20rpx;
  background: #f44336;
  color: #fff;
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
}

.shop-meta {
  margin-top: 8rpx;
  color: #8f8f8f;
  font-size: 22rpx;
}

.shop-meta .sold {
  margin-left: 16rpx;
}

.shop-goods-scroll {
  white-space: nowrap;
  margin-top: 14rpx;
}

.shop-goods-row {
  display: flex;
}

.shop-goods-item {
  width: 150rpx;
  margin-right: 12rpx;
}

.shop-goods-item image {
  width: 150rpx;
  height: 110rpx;
  border-radius: 8rpx;
}

.shop-goods-item .g-name {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
}

.shop-goods-item .g-price {
  display: block;
