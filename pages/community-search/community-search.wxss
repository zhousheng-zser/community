.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  gap: 16rpx;
  flex-shrink: 0;
}

.city-pill {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #111;
  max-width: 200rpx;
}

.pin {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.arrow {
  margin-left: 6rpx;
  font-size: 20rpx;
  color: #999;
}

.search-input-wrap {
  flex: 1;
  background: #f3f3f3;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}

.search-input {
  font-size: 28rpx;
  width: 100%;
}

.map-wrap {
  position: relative;
  width: 100%;
  height: 42vh;
  flex-shrink: 0;
}

.map {
  width: 100%;
  height: 100%;
}

.map-locate-btn {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.locate-icon {
  font-size: 40rpx;
  color: #333;
  line-height: 1;
}

.list {
  flex: 1;
  background: #fff;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.list-hint {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-item.focused {
  background: #fff8f0;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.tag {
  font-size: 20rpx;
  background: #fff3e0;
  color: #e65100;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.region {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

.select-btn {
  color: #e85d04;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 8rpx;
  flex-shrink: 0;
}
