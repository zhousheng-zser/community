<view class="register-wrapper">
  <view class="header">
    <text class="title">新用户注册</text>
  </view>

  <view class="form-group">
    <view class="input-row">
      <text class="label">手机号码</text>
      <input class="input" type="number" placeholder="请输入手机号码" bindinput="onInput" data-key="phone" />
    </view>

    <view class="input-row">
      <text class="label">验证码</text>
      <input class="input" type="number" placeholder="请输入验证码" bindinput="onInput" data-key="code" />
      <button class="sms-btn" disabled="{{smsCount > 0}}" bindtap="sendSms">{{smsCount > 0 ? smsCount + 's后重发' : '获取验证码'}}</button>
    </view>

    <view class="input-row">
      <text class="label">设置密码</text>
      <input class="input" type="password" placeholder="请输入密码" bindinput="onInput" data-key="password" />
    </view>

    <view class="input-row">
      <text class="label">确认密码</text>
      <input class="input" type="password" placeholder="请再次输入密码" bindinput="onInput" data-key="confirmPassword" />
    </view>

    <view class="input-row" bindtap="chooseLocation">
      <text class="label">选择位置</text>
      <text class="input {{address ? '' : 'placeholder'}}">{{address || '请选择您的位置信息'}}</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="agreement-row" bindtap="toggleAgree">
    <view class="checkbox {{agreed ? 'checked' : ''}}">
      <text wx:if="{{agreed}}" class="check-mark">✓</text>
    </view>
    <text class="agree-text">已阅读并同意 <text class="link" catchtap="viewAgreement">《用户注册协议》</text></text>
  </view>

  <button class="submit-btn" bindtap="doRegister">立即注册</button>
  
  <view class="login-link-wrap">
    <navigator url="/pages/login/login" open-type="navigateBack" class="login-link">已有账号？去登录</navigator>
  </view>
</view>
