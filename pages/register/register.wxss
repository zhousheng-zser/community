.register-wrapper {
  padding: 40rpx;
  background: #f8f8f8;
  min-height: 100vh;
}
.header {
  margin-bottom: 60rpx;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.form-group {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}
.input-row {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.input-row:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333;
}
.input {
  flex: 1;
  font-size: 30rpx;
}
.placeholder {
  color: #999;
}
.arrow {
  color: #ccc;
  font-size: 36rpx;
}
.sms-btn {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #FF7700;
  background: #fff;
  border: 1rpx solid #FF7700;
  border-radius: 30rpx;
  padding: 0;
  margin: 0;
}
.sms-btn[disabled] {
  color: #999;
  border-color: #ddd;
  background: #f5f5f5;
}
.agreement-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid #ccc;
  border-radius: 50%;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox.checked {
  background: #000000;
  border-color: #FF7700;
}
.check-mark {
  color: #fff;
  font-size: 24rpx;
}
.agree-text {
  font-size: 24rpx;
  color: #666;
}
.link {
  color: #FF7700;
}
.submit-btn {
  background: #000000;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
.login-link-wrap {
  text-align: center;
  margin-top: 40rpx;
}
.login-link {
  font-size: 28rpx;
  color: #666;
}

