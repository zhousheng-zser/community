.category-page {
  background-color: #121212;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部黑色导航栏 */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  background: #1c1c1c;
  z-index: 100;
  border-bottom: 1rpx solid #333;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 20rpx;
}

.back-btn {
  color: #fff;
  font-size: 32rpx;
  padding: 10rpx 20rpx;
}

.title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

/* 顶部深咖色横向 Tabs */
.tabs-wrap {
  position: fixed;
  left: 0;
  width: 100%;
  height: 92rpx;
  background: #242424; /* 深咖/深灰色底栏 */
  z-index: 99;
}

.tabs-scroll {
  width: 100%;
  height: 100%;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  height: 100%;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 30rpx;
  height: 100%;
  position: relative;
  color: #888;
  font-size: 28rpx;
}

.tab-item.active {
  color: #ff524e; /* 激活状态橘色字 */
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background-color: #ff524e;
  border-radius: 4rpx;
}

/* 列表渲染 */
.video-list {
  padding: 20rpx;
  box-sizing: border-box;
}

.list-item {
  display: flex;
  background: #1c1c1c;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}

.cover-wrap {
  position: relative;
  width: 200rpx;
  height: 130rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #333;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.play-icon-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-circle {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-left: 6rpx; /* 微调三角形居中 */
  box-sizing: border-box;
}

.play-triangle {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-left: 14rpx solid #fff;
  border-bottom: 10rpx solid transparent;
}

.info-wrap {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.v-title {
  color: #ddd;
  font-size: 28rpx;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.v-stats {
  display: flex;
  align-items: center;
  margin-top: auto;
}

.s-icon {
  color: #7d5a86; /* 紫色图标 */
  font-size: 22rpx;
  margin-right: 8rpx;
}

.s-text {
  color: #888;
  font-size: 24rpx;
}
