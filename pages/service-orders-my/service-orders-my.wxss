.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}
.legacy-link {
  display: block;
  font-size: 24rpx;
  color: #888;
  text-align: right;
  margin-bottom: 16rpx;
}
.hint,
.empty {
  text-align: center;
  color: #888;
  padding: 80rpx 32rpx;
  font-size: 28rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.status {
  font-size: 26rpx;
  color: #ff7700;
  white-space: nowrap;
}
.row-meta {
  margin-top: 12rpx;
}
.meta {
  font-size: 24rpx;
  color: #999;
}
.amount {
  font-size: 28rpx;
  color: #e54d42;
}
