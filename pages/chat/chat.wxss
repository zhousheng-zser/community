page {
  background-color: #f2f2f2;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat-area {
  flex: 1;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.time-stamp {
  text-align: center;
  font-size: 24rpx;
  color: #c9c9c9;
  margin: 20rpx 0;
}

.msg-wrapper {
  margin-bottom: 30rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.chat-row.left {
  justify-content: flex-start;
}

.chat-row.right {
  justify-content: flex-end;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #eee;
  flex-shrink: 0;
}

.bubble {
  max-width: 65%;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-all;
  position: relative;
}

.bubble text {
  color: inherit;
}

.left-bubble {
  background-color: #fff;
  color: #333;
  margin-left: 20rpx;
  border-top-left-radius: 4rpx; /* 气泡小尖角 */
}

.right-bubble {
  background-color: #ff5000; /* 淘宝橙 */
  color: #fff;
  margin-right: 20rpx;
  border-top-right-radius: 4rpx; /* 气泡小尖角 */
}

.chat-img {
  width: 300rpx;
  border-radius: 10rpx;
  display: block;
}

/* 底部输入框 */
.input-area {
  width: 100%;
  height: 110rpx;
  background-color: #f6f6f6;
  border-top: 1rpx solid #e5e5e5;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: 100;
}

.icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.input-box {
  flex: 1;
  height: 70rpx;
  background-color: #fff;
  border-radius: 35rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 110rpx;
  height: 64rpx;
  margin-left: 20rpx;
  background-color: #ff5000;
  color: #fff;
  font-size: 28rpx;
  border-radius: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
