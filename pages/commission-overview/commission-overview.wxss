.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 配置卡片 */
.config-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.config-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.config-row {
  display: flex;
  justify-content: space-between;
}

.config-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.config-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.config-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff7a00;
}

.config-note {
  font-size: 20rpx;
  color: #999;
  margin-top: 16rpx;
  text-align: center;
}

/* 总览卡片 */
.summary-card {
  background: linear-gradient(135deg, #ff7a00, #ff9a40);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 30rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 24rpx;
  font-weight: bold;
}

.summary-row {
  display: flex;
  justify-content: space-around;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.summary-amount.available {
  color: #fff;
}

.summary-amount.pending {
  color: rgba(255,255,255,0.7);
}

.summary-amount.withdrawn {
  color: rgba(255,255,255,0.6);
}

.summary-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 角色卡片 */
.section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.role-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.role-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.role-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.role-earned {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff7a00;
}

.role-details {
  display: flex;
  gap: 40rpx;
}

.role-detail-item {
  display: flex;
  flex-direction: column;
  font-size: 22rpx;
  color: #999;
}

.role-detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-top: 4rpx;
}

.role-detail-value.pending {
  color: #ff7a00;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

/* 按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn-withdraw {
  flex: 1;
  background: #ff7a00;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-secondary {
  flex: 1;
  background: #fff;
  color: #ff7a00;
  border: 2rpx solid #ff7a00;
  border-radius: 12rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-primary {
  background: #ff7a00;
  color: #fff;
  border-radius: 12rpx;
}
