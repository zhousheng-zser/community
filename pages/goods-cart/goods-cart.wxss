page {
  background: #f3f4f6;
}

.cart-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.cart-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
  background: #fff;
}

.nav-back {
  width: 64rpx;
  font-size: 48rpx;
  color: #222;
  line-height: 1;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}

.nav-placeholder {
  width: 120rpx;
}

.nav-clear-all {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.55);
}

.cart-summary-bar {
  padding: 8rpx 8rpx 16rpx;
  font-size: 24rpx;
  color: #888;
}

.loading-wrap {
  padding: 80rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.cart-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
  padding: 16rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.shop-group {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: visible;
}

.service-shop-group {
  margin-bottom: 32rpx;
}

.shop-empty-hint {
  padding: 24rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.shop-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.shop-name-row {
  display: flex;
  align-items: center;
  flex: 1;
}

.shop-tag {
  font-size: 20rpx;
  color: #fff;
  background: #ff6b35;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.service-tag {
  background: #4a90e2;
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  padding: 8rpx 8rpx 12rpx;
}

.shop-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-arrow {
  margin-left: 8rpx;
  color: #bbb;
}

.clear-shop {
  font-size: 24rpx;
  color: #999;
}

.goods-item {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item.invalid {
  opacity: 0.55;
}

.goods-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #222;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.invalid-tip {
  font-size: 22rpx;
  color: #e54d42;
  margin-top: 8rpx;
}

.goods-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.goods-ops {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.goods-price {
  font-size: 30rpx;
  color: #e54d42;
  font-weight: 700;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  line-height: 44rpx;
  font-size: 32rpx;
  color: #333;
}

.step-btn.plus {
  background: #ff6b35;
  border-color: #ff6b35;
  color: #fff;
}

.step-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 26rpx;
  margin: 0 12rpx;
}

.remove-btn {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.shop-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx 24rpx;
  gap: 20rpx;
}

.shop-sub {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  text-align: right;
}

.settle-btn {
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: #ddd;
  color: #fff;
}

.settle-btn.active {
  background: linear-gradient(90deg, #ff8a3d, #ff6b35);
}

.login-tip,
.empty-wrap {
  padding: 120rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 32rpx;
  color: #666;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaa;
}

.go-market-btn {
  margin-top: 40rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  padding: 0 48rpx;
}
