<view class="message-page">
  <view class="msg-head" style="padding-top: {{navTopPadding}}px;">
    <text class="title">消息（{{messageCount}}）</text>
  </view>

  <view class="empty-wrap" wx:if="{{messageCount === 0}}">
    <view class="bubble-icon">
      <view class="dot"></view>
      <view class="dot"></view>
      <view class="dot"></view>
    </view>
    <text class="empty-text">消息列表为空</text>
  </view>

  <view class="message-list" wx:else>
    <view class="message-item" wx:for="{{messageList}}" wx:key="id">
      <text class="item-title">{{item.title}}</text>
      <text class="item-time">{{item.time}}</text>
    </view>
  </view>
</view>
