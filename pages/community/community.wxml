<!--pages/community/community.wxml-->
<view class="community-page">
  <view class="top-wrap" style="padding-top: {{navTopPadding}}px;">
    <view class="top-row">
      <view class="left" bindtap="handleLocationTap">
        <text class="pin">◎</text>
        <text class="location">📍</text>
        <text class="circle">邻里生活圈</text>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input
          class="search-field"
          placeholder="请输入"
          value="{{communitySearchKeyword}}"
          bindinput="onCommunitySearchInput"
          confirm-type="search"
        />
        </view>
      <text class="func-icon">◔</text>
      <text class="func-icon">⊕</text>
          </view>
          
    <view class="tab-row">
      <view class="tab {{activeTab === item ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-tab="{{item}}">
        {{item}}
            </view>
          </view>
        </view>

  <view class="content-wrap" wx:if="{{activeTab !== '邻里互动'}}">
    <view class="empty-board">
      <view class="empty-note"></view>
            </view>
          </view>

  <view class="post-list" wx:else>
    <view class="post-card" wx:for="{{posts}}" wx:key="id">
      <view class="user-row">
        <view class="left">
          <view class="avatar"></view>
          <text class="name">{{item.name}}</text>
        </view>
        <text class="time">{{item.time}}</text>
      </view>

      <text class="title">{{item.title}}</text>
      <image wx:if="{{item.image}}" class="post-image" src="{{item.image}}" mode="aspectFill"></image>
      <text class="desc">{{item.desc}}</text>

      <view class="meta-row">
        <text class="read">阅读 {{item.read}}</text>
        <view class="right">
          <text class="meta">💬 {{item.comment}}</text>
          <text class="meta">♡ {{item.like}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
