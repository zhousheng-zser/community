<!--pages/community/community.wxml-->
<wxs src="./utils.wxs" module="utilWxs" />
<view class="community-page">
  <view class="top-wrap" style="padding-top: {{navTopPadding}}px;">
    <view class="top-row">
      <view class="left" bindtap="handleLocationTap">
        <text class="pin">◎</text>
        <text class="location">📍</text>
        <text class="circle">邻里生活圈</text>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input
          class="search-field"
          placeholder="请输入"
          value="{{communitySearchKeyword}}"
          bindinput="onCommunitySearchInput"
          confirm-type="search"
        />
        </view>
      <text class="func-icon">◔</text>
      <text class="func-icon">⊕</text>
          </view>
          
    <view class="tab-row">
      <view class="tab {{activeTab === item ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-tab="{{item}}">
        {{item}}
            </view>
          </view>
        </view>

  <view class="post-list" wx:if="{{posts.length > 0}}">
    <view class="post-card" wx:for="{{posts}}" wx:key="id">
      <view class="user-row">
        <view class="left">
          <image class="avatar" src="{{item.author ? item.author.avatar_url : '/img/placeholders/avatar_worker.png'}}" mode="aspectFill"></image>
          <text class="name">{{item.author ? item.author.nickname : '匿名'}}</text>
        </view>
        <text class="time">{{item.createdAt}}</text>
      </view>

      <view class="post-content" wx:if="{{item.content}}">
        <text class="content-text">{{item.content}}</text>
      </view>

      <view class="image-gallery" wx:if="{{item.images && item.images.length > 0}}">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="post-image" src="{{img}}" mode="aspectFill"></image>
      </view>

      <view class="meta-row">
        <text class="read">阅读 {{item.id * 7 + 12}}</text>
        <view class="right">
          <view class="meta" bindtap="handleComment" data-id="{{item.id}}" data-index="{{index}}">
            <text class="meta-icon">💬</text>
            <text>{{item.comments ? item.comments.length : 0}}</text>
          </view>
          <view class="meta" bindtap="handleLike" data-id="{{item.id}}" data-index="{{index}}">
            <text class="meta-icon">{{item.isLiked ? '❤️' : '♡'}}</text>
            <text>{{item.likes ? item.likes.length : 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-board" wx:else>
      <text class="empty-note">暂无动态，快来发一条吧~</text>
  </view>
</view>
