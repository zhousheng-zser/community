<!--pages/community/community.wxml-->
<wxs src="./utils.wxs" module="utilWxs" />
<view class="community-page">
  <view class="top-wrap" style="padding-top: {{navTopPadding}}px;">
    <view class="top-row">
      <view class="left" bindtap="handleLocationTap">
        <text class="pin">◎</text>
        <text class="location">📍</text>
        <text class="circle">邻里生活圈</text>
      </view>
    </view>

    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">⌕</text>
        <input
          class="search-field"
          placeholder="请输入"
          value="{{communitySearchKeyword}}"
          bindinput="onCommunitySearchInput"
          confirm-type="search"
        />
        </view>
      <text class="func-icon">◔</text>
      <text class="func-icon">⊕</text>
          </view>

    <view class="announce-strip" wx:if="{{announcements.length}}">
      <scroll-view class="announce-scroll" scroll-x="true" show-scrollbar="{{false}}">
        <text class="announce-item {{item.read ? 'read' : ''}}" wx:for="{{announcements}}" wx:key="id">{{item.title}}</text>
      </scroll-view>
      <text class="announce-readall" bindtap="readAllAnnouncements">一键已读</text>
    </view>
          
    <view class="tab-row">
      <view class="tab-list">
        <view class="tab {{activeTab === item ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="switchTab" data-tab="{{item}}">
          {{item}}
        </view>
      </view>
      <view class="publish-tab" bindtap="goPublish">
        <text class="publish-tab-text">一键发布</text>
        <view class="publish-tab-badge">填需求 马上帮</view>
      </view>
    </view>
  </view>

  <view class="post-list" wx:if="{{posts.length > 0}}">
    <view class="post-card" wx:for="{{posts}}" wx:key="id">
      <view class="user-row">
        <view class="left">
          <image class="avatar" src="{{item.author ? item.author.avatar_url : 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&q=80'}}" mode="aspectFill"></image>
          <text class="name">{{item.author ? item.author.nickname : '匿名'}}</text>
        </view>
        <text class="time">{{item.createdAt}}</text>
      </view>

      <view class="post-content" wx:if="{{item.content}}">
        <text class="content-text">{{item.content}}</text>
      </view>

      <view class="image-gallery" wx:if="{{item.images && item.images.length > 0}}">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="post-image" src="{{img}}" mode="aspectFill"></image>
      </view>

      <view class="meta-row">
        <text class="read">阅读 {{item.id * 7 + 12}}</text>
        <view class="right">
          <view class="meta" bindtap="handleComment" data-id="{{item.id}}" data-index="{{index}}">
            <text class="meta-icon">💬</text>
            <text>{{item.comments ? item.comments.length : 0}}</text>
          </view>
          <view class="meta" bindtap="handleLike" data-id="{{item.id}}" data-index="{{index}}">
            <text class="meta-icon">{{item.isLiked ? '❤️' : '♡'}}</text>
            <text>{{item.likes ? item.likes.length : 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-board" wx:else>
    <view class="empty-illus">
      <text class="empty-emoji">🏘️</text>
      <view class="empty-dots">
        <view class="dot-item"></view>
        <view class="dot-item"></view>
        <view class="dot-item"></view>
      </view>
    </view>
    <text class="empty-title">邻里圈还很安静</text>
    <text class="empty-sub">成为第一个分享的人，让社区热闹起来吧～</text>
    <view class="empty-btn" bindtap="goNewPost">
      <text class="empty-btn-icon">✏️</text>
      <text class="empty-btn-text">发布第一条动态</text>
    </view>
  </view>

  <!-- 底部悬浮发帖按钮 -->
  <view class="fab-post" bindtap="goNewPost">
    <text class="fab-icon">✏️</text>
    <text class="fab-text">发帖</text>
  </view>

  <!-- 评论遮罩 -->
  <view wx:if="{{commentPanel.show}}" class="cp-overlay" bindtap="closeCommentPanel"></view>

  <!-- 评论面板 -->
  <view class="comment-panel {{commentPanel.show ? 'cp-show' : ''}}" style="{{commentPanel.show ? 'bottom: ' + commentPanel.keyboardHeight + 'px' : ''}}">
    <view class="cp-header">
      <text class="cp-title">发表评论</text>
      <text class="cp-close" bindtap="closeCommentPanel">✕</text>
    </view>

    <textarea
      class="cp-textarea"
      placeholder="文明上网，理性发言..."
      placeholder-class="cp-placeholder"
      value="{{commentPanel.content}}"
      bindinput="onCommentInput"
      adjust-position="{{false}}"
      bindkeyboardheightchange="onCommentKeyboard"
      maxlength="500"
      auto-focus="{{commentPanel.show}}"
    ></textarea>

    <!-- 已选图片预览 -->
    <view class="cp-img-list" wx:if="{{commentPanel.images.length > 0}}">
      <view class="cp-img-item" wx:for="{{commentPanel.images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" bindtap="previewCommentImage" data-idx="{{index}}"></image>
        <view class="cp-img-del" catchtap="delCommentImage" data-idx="{{index}}">✕</view>
      </view>
    </view>

    <!-- 工具栏 -->
    <view class="cp-toolbar">
      <view class="cp-add-img" bindtap="addCommentImage" wx:if="{{commentPanel.images.length < 3}}">
        <text class="cp-add-icon">🖼️</text>
        <text class="cp-add-text">图片</text>
      </view>
      <view style="flex:1;"></view>
      <text class="cp-count">{{commentPanel.content.length}}/500</text>
      <view
        class="cp-send-btn {{(commentPanel.content.length > 0 || commentPanel.images.length > 0) && !commentPanel.sending ? 'active' : ''}}"
        bindtap="submitComment"
      >{{commentPanel.sending ? '发送中' : '发送'}}</view>
    </view>
  </view>
</view>
