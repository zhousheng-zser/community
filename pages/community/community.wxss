/* pages/community/community.wxss */
page {
  background: #e9e9f1;
}

.community-page {
  min-height: 100vh;
}

.top-wrap {
  background: linear-gradient(180deg, #f6362b 0%, #ef3025 100%);
  padding: 28rpx 32rpx 0;
  color: #fff;
}

.top-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.top-row .left {
  display: flex;
  align-items: center;
  color: #fff;
  flex: 1;
}

.pin {
  font-size: 28rpx;
  margin-right: 8rpx;
  opacity: 0.8;
}

.location {
  font-size: 42rpx;
}

.circle {
  margin-left: 16rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.capsule {
  min-width: 180rpx;
  height: 58rpx;
  border-radius: 29rpx;
  border: 1rpx solid #ddd;
  color: #1e1e1e;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.search-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #fff;
}

.search-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.search-field {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #fff;
}

.func-icon {
  margin-left: 24rpx;
  font-size: 40rpx;
  color: #fff;
}

.tab-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.tab {
  position: relative;
  padding: 20rpx 4rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tab.active {
  color: #fff;
  font-weight: 700;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: 8rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #fff;
}

.content-wrap {
  min-height: calc(100vh - 300rpx);
  background: #e9e9f1;
}

.empty-board {
  padding-top: 120rpx;
  display: flex;
  justify-content: center;
}

.empty-note {
  width: 180rpx;
  height: 220rpx;
  border: 6rpx solid #c6cbda;
  border-radius: 18rpx;
  opacity: 0.62;
  position: relative;
}

.empty-note::before {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -14rpx;
  width: 90rpx;
  height: 6rpx;
  background: rgba(198, 203, 218, 0.35);
  border-radius: 999rpx;
}

.post-list {
  background: #f4f6f8;
  padding: 24rpx 24rpx 150rpx;
}

.post-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 24rpx;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-row .left {
  display: flex;
  align-items: center;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #b0b0b0;
}

.post-content {
  margin: 12rpx 0 16rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  display: block;
}

.image-gallery {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.post-image {
  width: 218rpx;
  height: 218rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
}

.post-image:nth-child(3n) {
  margin-right: 0;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.read {
  font-size: 24rpx;
  color: #bfc2c7;
}

.meta-row .right {
  display: flex;
}

.meta {
  margin-left: 32rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.meta-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}
