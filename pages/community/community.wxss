/* pages/community/community.wxss */
page {
  background: #e9e9f1;
}

.community-page {
  min-height: 100vh;
}

.top-wrap {
  background: #f5dfb3;
  padding: 28rpx 24rpx 0;
}

.top-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.top-row .left {
  display: flex;
  align-items: center;
  color: #1f1f1f;
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
}

.pin {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.location {
  font-size: 42rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.circle {
  margin-left: 20rpx;
  font-size: 42rpx;
  color: #333;
  flex-shrink: 0;
}

.capsule {
  min-width: 180rpx;
  height: 58rpx;
  border-radius: 29rpx;
  border: 1rpx solid #ddd;
  color: #1e1e1e;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.search-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  height: 60rpx;
  background: #fff;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #9ca0a8;
}

.search-field {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.func-icon {
  margin-left: 16rpx;
  font-size: 36rpx;
  color: #1f1f1f;
}

.tab-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.tab {
  position: relative;
  padding: 14rpx 2rpx 14rpx;
  font-size: 32rpx;
  color: #444;
}

.tab.active {
  color: #1f1f1f;
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2rpx;
  height: 5rpx;
  border-radius: 6rpx;
  background: #e5ab2d;
}

.content-wrap {
  min-height: calc(100vh - 300rpx);
  background: #e9e9f1;
}

.empty-board {
  padding-top: 120rpx;
  display: flex;
  justify-content: center;
}

.empty-note {
  width: 180rpx;
  height: 220rpx;
  border: 6rpx solid #c6cbda;
  border-radius: 18rpx;
  opacity: 0.62;
  position: relative;
}

.empty-note::before {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -14rpx;
  width: 90rpx;
  height: 6rpx;
  background: rgba(198, 203, 218, 0.35);
  border-radius: 999rpx;
}

.post-list {
  background: #e9e9f1;
  padding-bottom: 150rpx;
}

.post-card {
  margin: 12rpx 18rpx;
  border-radius: 12rpx;
  background: #fff;
  overflow: hidden;
}

.user-row {
  padding: 16rpx 18rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-row .left {
  display: flex;
  align-items: center;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #d8d8d8;
  margin-right: 12rpx;
}

.name {
  font-size: 34rpx;
  color: #1f1f1f;
}

.time {
  font-size: 24rpx;
  color: #9a9a9a;
}

.title {
  display: block;
  margin: 12rpx 18rpx 0;
  font-size: 40rpx;
  color: #1f1f1f;
  font-weight: 700;
}

.post-image {
  width: 190rpx;
  height: 190rpx;
  margin: 12rpx 18rpx 0;
  border-radius: 8rpx;
}

.desc {
  display: block;
  margin: 12rpx 18rpx 14rpx;
  font-size: 34rpx;
  color: #2a2a2a;
}

.meta-row {
  border-top: 1rpx solid #eee;
  padding: 12rpx 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.read {
  font-size: 28rpx;
  color: #8f8f95;
}

.meta-row .right {
  display: flex;
  align-items: center;
}

.meta {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #8f8f95;
}
