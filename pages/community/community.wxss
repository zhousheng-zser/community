/* pages/community/community.wxss */
page {
  background-color: #fff;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

/* 顶部封面 */
.header-cover {
  position: relative;
  width: 100%;
  height: 500rpx;
  background-color: #f0f0f0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.user-info {
  position: absolute;
  right: 30rpx;
  bottom: -40rpx;
  display: flex;
  align-items: center;
}

.user-name {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
  margin-right: 20rpx;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 4rpx solid #fff;
  background-color: #ccc;
}

/* 动态列表区 */
.post-list {
  padding-top: 60rpx;
  border-bottom: 1px solid #eee;
}

.post-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1px solid #f2f2f2;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background-color: #eee;
  flex-shrink: 0;
}

.post-content-area {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.post-name {
  color: #576b95; /* 微信经典名字蓝色 */
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.post-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
  word-break: break-all;
}

/* 九宫格图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.post-img {
  width: 180rpx;
  height: 180rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  background-color: #f5f5f5;
}

.post-img.single-img {
  width: 400rpx;
  height: 300rpx;
}

/* 底部时间与操作 */
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  margin-bottom: 20rpx;
}

.post-time {
  font-size: 24rpx;
  color: #b2b2b2;
}

.action-btn {
  width: 60rpx;
  height: 40rpx;
  background-color: #f5f5f5;
  border-radius: 6rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.action-icon-dots {
  color: #576b95;
  font-weight: bold;
  line-height: 20rpx;
  font-size: 30rpx;
}

.action-menu {
  position: absolute;
  right: 70rpx;
  top: -10rpx;
  background-color: #4c5154;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx;
  opacity: 0;
  width: 0;
  overflow: hidden;
  transition: all 0.2s ease;
}

.action-menu.show {
  opacity: 1;
  width: 300rpx; /* 展开宽度 */
  padding: 0 20rpx;
}

.menu-item {
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx;
  flex: 1;
  text-align: center;
}

.menu-divider {
  width: 1px;
  height: 30rpx;
  background-color: #3d4245;
}

/* 点赞与评论展示区 */
.interaction-area {
  background-color: #f7f7f7;
  border-radius: 8rpx;
  margin-top: 10rpx;
  position: relative;
}

/* 小三角箭头 */
.interaction-area::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 20rpx;
  border-width: 0 12rpx 12rpx;
  border-style: solid;
  border-color: transparent transparent #f7f7f7;
}

.likes-list {
  padding: 20rpx;
  border-bottom: 1px solid #ededed;
  color: #576b95;
  font-size: 28rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.like-heart {
  font-size: 24rpx;
  margin-right: 10rpx;
  color: #576b95;
}

.like-name {
  margin-right: 6rpx;
}

.comments-list {
  padding: 10rpx 20rpx;
}

.comment-item {
  font-size: 28rpx;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

.comment-name {
  color: #576b95;
  font-weight: bold;
}

.comment-text {
  color: #333;
}

/* 悬浮发布按钮 */
.publish-btn-float {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #e64340; /* 配合主题红 */
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(230, 67, 64, 0.4);
  z-index: 999;
}

.publish-btn-float image {
  width: 50rpx;
  height: 50rpx;
  filter: brightness(0) invert(1); /* 纯白图标 */
}
