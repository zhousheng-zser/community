/* pages/community/community.wxss */
page {
  background: #e9e9f1;
}

.community-page {
  min-height: 100vh;
}

.top-wrap {
  background: linear-gradient(180deg, #f6362b 0%, #ef3025 100%);
  padding: 28rpx 32rpx 0;
  color: #fff;
}

.top-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.top-row .left {
  display: flex;
  align-items: center;
  color: #fff;
  flex: 1;
}

.pin {
  font-size: 28rpx;
  margin-right: 8rpx;
  opacity: 0.8;
}

.location {
  font-size: 42rpx;
}

.circle {
  margin-left: 16rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.capsule {
  min-width: 180rpx;
  height: 58rpx;
  border-radius: 29rpx;
  border: 1rpx solid #ddd;
  color: #1e1e1e;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  box-sizing: border-box;
  background: #f8f8f8;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.search-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.search-box {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #fff;
}

.search-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.search-field {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #fff;
}

.func-icon {
  margin-left: 24rpx;
  font-size: 40rpx;
  color: #fff;
}

.tab-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.tab-list {
  display: flex;
  flex: 1;
}

.tab {
  position: relative;
  padding: 20rpx 4rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.tab.active {
  color: #fff;
  font-weight: 700;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 20%;
  right: 20%;
  bottom: 8rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #fff;
}

/* ===== 一键发布 Tab 按钮 ===== */
.publish-tab {
  position: relative;
  margin-bottom: 12rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: center;
}

.publish-tab-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.publish-tab-badge {
  position: absolute;
  top: -18rpx;
  right: -8rpx;
  background: #ff4b4b;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  line-height: 1.4;
}

/* ===== 底部悬浮发帖按钮 ===== */
.fab-post {
  position: fixed;
  right: 36rpx;
  bottom: 180rpx;
  background: linear-gradient(135deg, #f64e4e, #ff8a65);
  border-radius: 48rpx;
  padding: 18rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(246, 78, 78, 0.45);
  z-index: 50;
}

.fab-icon {
  font-size: 32rpx;
  line-height: 1;
}

.fab-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.content-wrap {
  min-height: calc(100vh - 300rpx);
  background: #e9e9f1;
}

.empty-board {
  padding-top: 120rpx;
  display: flex;
  justify-content: center;
}

.empty-note {
  width: 180rpx;
  height: 220rpx;
  border: 6rpx solid #c6cbda;
  border-radius: 18rpx;
  opacity: 0.62;
  position: relative;
}

.empty-note::before {
  content: "";
  position: absolute;
  right: -10rpx;
  bottom: -14rpx;
  width: 90rpx;
  height: 6rpx;
  background: rgba(198, 203, 218, 0.35);
  border-radius: 999rpx;
}

.post-list {
  background: #f4f6f8;
  padding: 24rpx 24rpx 150rpx;
}

.post-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 24rpx;
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-row .left {
  display: flex;
  align-items: center;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f0f0f0;
  margin-right: 16rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.time {
  font-size: 24rpx;
  color: #b0b0b0;
}

.post-content {
  margin: 12rpx 0 16rpx;
}

.content-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
  display: block;
}

.image-gallery {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.post-image {
  width: 218rpx;
  height: 218rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
}

.post-image:nth-child(3n) {
  margin-right: 0;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.read {
  font-size: 24rpx;
  color: #bfc2c7;
}

.meta-row .right {
  display: flex;
}

.meta {
  margin-left: 32rpx;
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.meta-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* ===== 评论面板 ===== */
.cp-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.comment-panel {
  position: fixed;
  left: 0; right: 0;
  bottom: -100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 0 env(safe-area-inset-bottom);
  z-index: 101;
  transition: bottom 0.25s ease;
}

.comment-panel.cp-show {
  bottom: 0;
}

.cp-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.cp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.cp-close {
  font-size: 32rpx;
  color: #aaa;
  padding: 0 8rpx;
}

.cp-textarea {
  display: block;
  width: 100%;
  min-height: 160rpx;
  max-height: 280rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
}

.cp-placeholder {
  color: #ccc;
  font-size: 28rpx;
}

/* 已选图片行 */
.cp-img-list {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
}

.cp-img-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
}

.cp-img-item image {
  width: 100%;
  height: 100%;
}

.cp-img-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 工具栏 */
.cp-toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
  border-top: 1rpx solid #f2f2f2;
  gap: 20rpx;
}

.cp-add-img {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
}

.cp-add-icon {
  font-size: 34rpx;
  line-height: 1;
}

.cp-add-text {
  font-size: 24rpx;
  color: #666;
}

.cp-count {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
}

.cp-send-btn {
  padding: 14rpx 40rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #e0e0e0;
  color: #aaa;
  flex-shrink: 0;
  transition: background 0.2s;
}

.cp-send-btn.active {
  background: linear-gradient(90deg, #f64e4e, #ff8a65);
  color: #fff;
}
