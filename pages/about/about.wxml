<!--pages/about/about.wxml-->
<view class="about-page">

  <!-- 顶部 Logo 区 -->
  <view class="hero">
    <view class="logo-wrap">
      <image class="logo" src="/img/home-1.png" mode="aspectFit"></image>
    </view>
    <text class="app-name">社区生活服务平台</text>
    <text class="app-slogan">连接社区服务与本地消费</text>
    <text class="app-version">版本 v1.0.0</text>
  </view>

  <!-- 产品介绍 -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-icon">🏠</text>
      <text class="card-title">关于我们</text>
    </view>
    <text class="card-text">我们是一款面向社区场景的本地生活服务应用，围绕“服务 + 商品 + 社区互动”构建一站式体验，让用户在一个平台内完成日常所需。</text>
    <text class="card-text mt">当前版本聚焦首页生活服务、本地好物、本地集市与惠民卡联盟等核心模块，持续优化附近供给、商品推荐与社区连接效率。</text>
  </view>

  <!-- 核心功能 -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-icon">⚡</text>
      <text class="card-title">核心功能</text>
    </view>
    <view class="feature-list">
      <view class="feature-item" wx:for="{{features}}" wx:key="name">
        <view class="feature-icon-bg" style="background: {{item.bg}};">
          <text class="feature-emoji">{{item.emoji}}</text>
        </view>
        <view class="feature-text">
          <text class="feature-name">{{item.name}}</text>
          <text class="feature-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系我们 -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-icon">📞</text>
      <text class="card-title">联系我们</text>
    </view>
    <view class="contact-list">
      <view class="contact-item" wx:for="{{contacts}}" wx:key="label" bindtap="handleContact" data-type="{{item.type}}" data-value="{{item.value}}">
        <text class="contact-label">{{item.label}}</text>
        <view class="contact-right">
          <text class="contact-value">{{item.value}}</text>
          <text class="contact-arrow" wx:if="{{item.type !== 'text'}}">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 法律条款 -->
  <view class="card">
    <view class="card-title-row">
      <text class="card-icon">📄</text>
      <text class="card-title">法律与隐私</text>
    </view>
    <view class="link-list">
      <view class="link-item" bindtap="goPrivacy">
        <text class="link-name">隐私政策</text>
        <text class="link-arrow">›</text>
      </view>
      <view class="link-item" bindtap="goTerms">
        <text class="link-name">用户服务协议</text>
        <text class="link-arrow">›</text>
      </view>
      <view class="link-item last" bindtap="goLicense">
        <text class="link-name">第三方 SDK 说明</text>
        <text class="link-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部版权 -->
  <view class="footer">
    <text class="footer-company">© 2024 社区生活服务平台</text>
    <text class="footer-icp">增值电信业务经营许可证 备案号：待填写</text>
  </view>

</view>
