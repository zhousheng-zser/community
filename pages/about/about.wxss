/* pages/about/about.wxss */
page { background: #f5f5f5; }
.about-page { padding-bottom: 60rpx; }

/* ===== 顶部 Hero ===== */
.hero {
  background: linear-gradient(160deg, #fff5f5 0%, #fff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 32rpx 48rpx;
  margin-bottom: 16rpx;
}
.logo-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(230, 67, 64, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.logo { width: 100rpx; height: 100rpx; }
.app-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.app-slogan {
  font-size: 28rpx;
  color: #e64340;
  margin-bottom: 16rpx;
}
.app-version {
  font-size: 24rpx;
  color: #bbb;
  background: #f5f5f5;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* ===== 通用卡片 ===== */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 16rpx;
  padding: 32rpx;
}
.card-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.card-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.card-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  display: block;
}
.card-text.mt { margin-top: 16rpx; }

/* ===== 核心功能列表 ===== */
.feature-list { display: flex; flex-direction: column; gap: 28rpx; }
.feature-item {
  display: flex;
  align-items: center;
}
.feature-icon-bg {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.feature-emoji { font-size: 40rpx; }
.feature-text { display: flex; flex-direction: column; }
.feature-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 6rpx;
}
.feature-desc {
  font-size: 24rpx;
  color: #999;
}

/* ===== 联系我们 ===== */
.contact-list { display: flex; flex-direction: column; }
.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.contact-item:last-child { border-bottom: none; }
.contact-label { font-size: 28rpx; color: #555; }
.contact-right { display: flex; align-items: center; gap: 8rpx; }
.contact-value { font-size: 28rpx; color: #333; font-weight: 500; }
.contact-arrow { font-size: 32rpx; color: #ccc; }

/* ===== 法律链接 ===== */
.link-list { display: flex; flex-direction: column; }
.link-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.link-item.last { border-bottom: none; }
.link-name { font-size: 28rpx; color: #333; }
.link-arrow { font-size: 32rpx; color: #ccc; }

/* ===== 底部 ===== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 20rpx;
  gap: 12rpx;
}
.footer-company { font-size: 22rpx; color: #bbb; }
.footer-icp { font-size: 20rpx; color: #ccc; }
