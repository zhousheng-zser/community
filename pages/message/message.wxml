<view class="container">
  <view class="msg-tabs">
    <view class="msg-tab {{activeTab === 'chat' ? 'on' : ''}}" data-tab="chat" bindtap="switchTab">会话</view>
    <view class="msg-tab {{activeTab === 'sys' ? 'on' : ''}}" data-tab="sys" bindtap="switchTab">通知</view>
  </view>

  <block wx:if="{{activeTab === 'chat'}}">
    <view class="empty-list" wx:if="{{conversations.length === 0}}">暂无会话，订单沟通将出现在这里</view>

    <scroll-view class="msg-list" scroll-y="true" wx:else>
      <view class="msg-item {{item.isTouchMove ? 'touch-move-active' : ''}}" data-index="{{index}}" bindtouchstart="touchstart" bindtouchmove="touchmove" wx:for="{{conversations}}" wx:key="conversation_id">
        <view class="content" data-item="{{item}}" bindtap="goToChat">
          <view class="avatar-box">
            <image class="avatar" src="{{item.peerUser ? item.peerUser.avatar_url : 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=600&q=80'}}"></image>
            <view class="unread-badge" wx:if="{{item.unread_count > 0}}">{{item.unread_count > 99 ? '99+' : item.unread_count}}</view>
          </view>
          <view class="info-box">
            <view class="top-row">
              <text class="name">{{item.title || (item.peerUser ? item.peerUser.nickname : (item.peer_id == 0 ? '系统消息助手' : '未知'))}}</text>
              <text class="time">{{item.conversation.updated_at}}</text>
            </view>
            <view class="bottom-row">
              <text class="preview">{{item.conversation.last_message_preview}}</text>
            </view>
          </view>
        </view>
        <view class="delete-btn" catchtap="deleteConv" data-index="{{index}}">删除</view>
      </view>
    </scroll-view>
  </block>

  <block wx:else>
    <view class="sys-toolbar">
      <text class="sys-readall" bindtap="markAllSysRead">全部已读</text>
    </view>
    <view class="empty-list" wx:if="{{systemNotices.length === 0}}">暂无系统通知</view>
    <scroll-view class="sys-list" scroll-y="true" wx:else>
      <view class="sys-item {{item.read ? 'read' : ''}}" wx:for="{{systemNotices}}" wx:key="id" data-id="{{item.id}}" bindtap="openSys">
        <text class="sys-title">{{item.title}}</text>
        <text class="sys-time">{{item.timeLabel}}</text>
      </view>
    </scroll-view>
  </block>
</view>
