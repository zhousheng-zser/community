page {
  background-color: #f5f5f5;
}

.container {
  width: 100%;
  padding-bottom: 20rpx;
}

.empty-list {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.msg-list {
  width: 100%;
}

.msg-item {
  width: 100%;
  height: 140rpx;
  background-color: #fff;
  margin-bottom: 2rpx;
  display: flex;
  overflow: hidden; /* 防止滑动内容溢出 */
  position: relative;
}

.content {
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  z-index: 10;
  transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  background: #fff;
}

/* 核心滑动激活类 */
.touch-move-active .content {
    transform: translateX(-140rpx); /* 根据删除按钮宽度调整左滑距离 */
}

/* 删除按钮 */
.delete-btn {
  width: 140rpx;
  height: 100%;
  background-color: #ff3b30;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 1;
  font-size: 30rpx;
}

.avatar-box {
  width: 90rpx;
  height: 90rpx;
  position: relative;
  flex-shrink: 0; /* 防止被挤压 */
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #eee;
}

.unread-badge {
    position: absolute;
    top: -6rpx;
    right: -10rpx;
    background-color: #ff3b30;
    color: #fff;
    font-size: 20rpx;
    min-width: 30rpx;
    height: 30rpx;
    line-height: 30rpx;
    text-align: center;
    border-radius: 15rpx;
    padding: 0 6rpx;
    border: 2rpx solid #fff;
}

.info-box {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 90rpx;
  overflow: hidden;
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 70%;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.bottom-row {
  display: flex;
}

.preview {
  font-size: 26rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}
