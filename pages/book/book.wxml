<view class="month-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈 📍</text>
    <text class="title">开通月卡套餐</text>
    <text>⤴</text>
  </view>
  <view class="tabs">
    <text wx:for="{{tabs}}" wx:key="*this" class="{{activeTab===item?'active':''}}" bindtap="switchTab" data-tab="{{item}}">{{item}}</text>
  </view>

  <view class="banner">开通{{activeTab}}月卡 安心又省钱</view>

  <view class="head-row">
    <view>
      <text class="title">月卡</text>
      <text class="sub">省钱又省心</text>
    </view>
    <text class="rule">使用规则</text>
  </view>

  <view class="perks">
    <view class="perk" wx:for="{{perks}}" wx:key="title">
      <text class="icon">{{item.icon}}</text>
      <text class="name">{{item.title}}</text>
    </view>
  </view>

  <view class="empty">
    <text class="icon">⊖</text>
    <text>暂无月卡套餐</text>
  </view>
</view>
