.cs-page { padding: 40rpx; min-height: 100vh; background: #f5f5f5; }
.cs-tip { display: block; font-size: 26rpx; color: #555; line-height: 1.6; margin-bottom: 32rpx; }
.cs-phone-row { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 28rpx; border-radius: 12rpx; margin-bottom: 24rpx; font-size: 28rpx; }
.cs-phone { color: #ff7a00; font-weight: 700; }
.cs-btn { margin-bottom: 20rpx; background: #ff7a00; color: #fff; border-radius: 12rpx; }
.cs-btn.ghost { background: #fff; color: #333; border: 1rpx solid #ddd; }
