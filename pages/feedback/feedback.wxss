page { background: #f5f5f5; }
.fb-page { padding: 24rpx 24rpx 40rpx; }
.fb-card { background: #fff; border-radius: 16rpx; padding: 30rpx 24rpx; margin-bottom: 24rpx; }
.fb-section-title { display: block; font-size: 32rpx; font-weight: 700; color: #222; margin-bottom: 16rpx; }
.fb-hint { display: block; font-size: 26rpx; color: #999; line-height: 1.6; margin-bottom: 24rpx; }
.fb-textarea { width: 100%; min-height: 200rpx; font-size: 28rpx; color: #333; line-height: 1.7; margin-bottom: 20rpx; }
.fb-upload-area { border: 2rpx dashed #ddd; border-radius: 12rpx; min-height: 200rpx; display: flex; align-items: center; justify-content: center; background: #fafafa; }
.fb-upload-placeholder { display: flex; flex-direction: column; align-items: center; }
.fb-camera-icon { font-size: 72rpx; }
.fb-upload-tip { margin-top: 16rpx; font-size: 26rpx; color: #bbb; }
.fb-img-grid { display: flex; flex-wrap: wrap; gap: 14rpx; padding: 14rpx; width: 100%; box-sizing: border-box; }
.fb-img-wrap { position: relative; width: 180rpx; height: 180rpx; }
.fb-img { width: 100%; height: 100%; border-radius: 10rpx; }
.fb-img-del { position: absolute; top: -10rpx; right: -10rpx; width: 36rpx; height: 36rpx; border-radius: 18rpx; background: rgba(0,0,0,0.5); color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.fb-add-more { width: 180rpx; height: 180rpx; border: 2rpx dashed #ddd; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 60rpx; color: #ccc; }
.fb-submit-btn { background: linear-gradient(90deg, #ff8c00, #ffa000); color: #fff; height: 96rpx; border-radius: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 600; }
