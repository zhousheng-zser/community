<view class="order-page">
  <scroll-view class="tab-scroll" scroll-x scroll-with-animation>
    <view class="tab-row">
      <view
        class="order-tab {{activeTab===item.key?'active':''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        bindtap="switchTab"
        data-key="{{item.key}}"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="order-content">
    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载中...</text>
    </view>
    <block wx:elif="{{list.length > 0}}">
      <view
        class="order-card"
        wx:for="{{list}}"
        wx:key="orderNo"
        bindtap="goDetail"
        data-orderno="{{item.orderNo}}"
      >
        <view class="order-card-head">
          <text class="order-svc-name">{{item.title}}</text>
          <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="order-card-row">
          <text class="order-label">订单号</text>
          <text class="order-val">{{item.orderNo}}</text>
        </view>
        <view class="order-card-row" wx:if="{{item.time}}">
          <text class="order-label">下单时间</text>
          <text class="order-val">{{item.time}}</text>
        </view>
        <view class="order-card-foot">
          <text class="order-price">￥{{item.amount}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty-wrap">
      <text class="empty-icon">🛒</text>
      <text class="empty-text">暂无集市订单</text>
    </view>
  </view>
</view>
