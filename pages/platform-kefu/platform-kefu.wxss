.pk-page { padding: 40rpx; min-height: 100vh; background: #f5f5f5; }
.pk-tip { display: block; font-size: 26rpx; color: #555; line-height: 1.6; margin-bottom: 32rpx; }
.pk-row { display: flex; justify-content: space-between; background: #fff; padding: 28rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.pk-phone { color: #ff7a00; font-weight: 700; }
.pk-btn { background: #ff7a00; color: #fff; border-radius: 12rpx; }
