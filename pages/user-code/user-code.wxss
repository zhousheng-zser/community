page {
  background: #f5f6fa;
  min-height: 100vh;
}

.invite-page {
  padding-bottom: 80rpx;
  position: relative;
}

/* 椤堕儴鑳屾櫙瑁呴グ */
.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 320rpx;
  background: #000000;
  border-radius: 0 0 40rpx 40rpx;
  z-index: 0;
}

/* 鐢ㄦ埛淇℃伅 */
.user-card {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.sub-title {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* 涓诲崱鐗?*/
.main-card {
  position: relative;
  z-index: 1;
  margin: 0 40rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.08);
  padding: 48rpx 40rpx;
}

.card-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.code-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 48rpx;
  background: linear-gradient(135deg, #fff8f0 0%, #fff0e0 100%);
  border-radius: 20rpx;
  border: 2rpx dashed #ffcc99;
  width: 100%;
  box-sizing: border-box;
}

.invite-code {
  font-size: 72rpx;
  font-weight: 800;
  color: #ff7a00;
  letter-spacing: 12rpx;
  line-height: 1.2;
}

.copy-badge {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 24rpx;
  background: #000000;
  border-radius: 999rpx;
}

.copy-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.copy-text {
  font-size: 24rpx;
  color: #fff;
}

.divider {
  width: 60rpx;
  height: 4rpx;
  background: #e5e5e5;
  border-radius: 2rpx;
  margin: 32rpx 0 20rpx;
}

.hint {
  font-size: 24rpx;
  color: #bbb;
}

/* 缁熻鍗＄墖 */
.stats-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 24rpx 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.stat-num.bound {
  color: #27ae60;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

/* 閭€璇蜂汉淇℃伅 */
.inviter-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 40rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inviter-label {
  font-size: 26rpx;
  color: #666;
}

.inviter-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 鎵爜缁戝畾 */
.scan-section {
  margin: 32rpx 40rpx 0;
}

.scan-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000000;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 0, 0.3);
}

.scan-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.manual-input {
  text-align: center;
  margin-top: 24rpx;
}

.manual-text {
  font-size: 26rpx;
  color: #ff7a00;
  text-decoration: underline;
}

/* 宸茬粦瀹氭彁绀?*/
.binded-section {
  margin: 32rpx 40rpx 0;
}

.binded-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #27ae60;
  background: #e8f5e9;
  padding: 24rpx;
  border-radius: 16rpx;
}

.binded-icon {
  margin-right: 12rpx;
}

/* 鍒嗕韩鎸夐挳 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #333;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 26rpx 0;
  font-size: 28rpx;
  margin: 32rpx 40rpx 0;
  font-weight: 500;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

/* 鍔犺浇鐘舵€?*/
.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

