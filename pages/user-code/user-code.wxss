page {
  background: #f5f6fa;
  min-height: 100vh;
}

.invite-page {
  padding: 24rpx 28rpx;
  padding-bottom: 80rpx;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 二维码卡片 */
.qr-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  text-align: center;
}

.qr-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: block;
}

.code-box {
  background: #f8f9ff;
  border: 2rpx dashed #c8d6e5;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.invite-code {
  font-size: 48rpx;
  font-weight: 700;
  color: #ff7a00;
  letter-spacing: 8rpx;
  display: block;
}

.copy-hint {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.qr-image-wrap {
  margin: 20rpx auto;
  padding: 16rpx;
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  width: 340rpx;
  height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-canvas {
  width: 300rpx !important;
  height: 300rpx !important;
}

.share-hint {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 16rpx;
}

/* 邀请统计 */
.invite-stats {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: #eee;
}

/* 邀请人信息 */
.inviter-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.inviter-label {
  font-size: 26rpx;
  color: #666;
}

.inviter-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 扫码绑定 */
.scan-section {
  text-align: center;
  margin-bottom: 24rpx;
}

.scan-btn {
  background: linear-gradient(135deg, #ff7a00, #ff9e3d);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  font-weight: 600;
}

.manual-input {
  margin-top: 16rpx;
}

.manual-text {
  font-size: 24rpx;
  color: #ff7a00;
  text-decoration: underline;
}

/* 已绑定提示 */
.binded-section {
  text-align: center;
  padding: 30rpx;
}

.binded-hint {
  font-size: 26rpx;
  color: #27ae60;
  background: #e8f5e9;
  padding: 16rpx 30rpx;
  border-radius: 12rpx;
  display: inline-block;
}

/* 分享按钮 */
.share-btn {
  background: #fff;
  color: #333;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
