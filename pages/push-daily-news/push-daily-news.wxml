<view class="daily-news-page">
  <!-- 顶部渐变背景和返回 -->
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <view class="back-btn" bindtap="goBack">
      <text class="arrow">〈</text>
    </view>
    <view class="right-icon">•••</view>
  </view>
  
  <view class="header-title">
    <text class="main">每日上新</text>
    <text class="sub">宝藏新品，抢先体验</text>
    <view class="watermark">New</view>
  </view>

  <!-- 单列商品流 -->
  <view class="goods-list">
    <view wx:if="{{loading}}" class="empty-tip">加载中…</view>
    <view wx:elif="{{goodsList.length === 0}}" class="empty-tip">暂无上新商品</view>
    <block wx:else>
      <navigator class="good-card" wx:for="{{goodsList}}" wx:key="id" url="../push-product-detail/push-product-detail?id={{item.id}}">
        <view class="img-box">
          <image src="{{item.image}}" class="cover" mode="aspectFill"></image>
          <view wx:if="{{item.tag}}" class="tag-label">{{item.tag}}</view>
        </view>
        <view class="info-box">
          <view class="title-row">
            <text class="jd-icon">jd</text>
            <text class="name">{{item.name}}</text>
          </view>
          <view class="share-tag">分享赚/购买返￥{{item.comm}}</view>
          <view class="bottom-row">
            <text class="price">￥{{item.price}}</text>
            <view class="buy-btn">去购买</view>
          </view>
        </view>
      </navigator>
    </block>
  </view>
</view>
