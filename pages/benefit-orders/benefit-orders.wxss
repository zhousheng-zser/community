.bo-page { min-height: 100vh; background: #f5f5f5; padding: 24rpx; box-sizing: border-box; }
.bo-loading { text-align: center; color: #999; padding: 80rpx; }
.bo-item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.bo-title { display: block; font-size: 28rpx; font-weight: 600; }
.bo-sub { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.bo-empty { text-align: center; padding: 80rpx 32rpx; color: #666; font-size: 26rpx; }
.bo-btn { margin-top: 32rpx; background: #000000; color: #fff; border-radius: 999rpx; }

