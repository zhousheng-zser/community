<view class="bo-page">
  <view class="bo-loading" wx:if="{{loading}}">加载中…</view>
  <block wx:elif="{{list.length}}">
    <view class="bo-item" wx:for="{{list}}" wx:key="id">
      <text class="bo-title">{{item.title || item.order_no || item.id}}</text>
      <text class="bo-sub">{{item.status_text || item.status || ''}}</text>
    </view>
  </block>
  <view class="bo-empty" wx:else>
    <text>{{err || '暂无订单'}}</text>
    <button class="bo-btn" bindtap="goBenefit">去惠民卡看看</button>
  </view>
</view>
