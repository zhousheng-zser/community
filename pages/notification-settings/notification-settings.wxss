.ns-page { padding: 32rpx; background: #f5f5f5; min-height: 100vh; box-sizing: border-box; }
.ns-tip { display: block; font-size: 24rpx; color: #888; margin-bottom: 24rpx; line-height: 1.5; }
.ns-row { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 28rpx 24rpx; border-radius: 12rpx; margin-bottom: 16rpx; font-size: 28rpx; }
