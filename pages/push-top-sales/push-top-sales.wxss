page {
  background: #FFF0E5; /* 浅淡金橘色底 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.top-sales-page {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FFD2A6 0%, #FFDFBE 15%, #FFF0E5 30%, #FFF0E5 100%);
  padding-bottom: 40rpx;
}

/* 顶部导航与返回 */
.top-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end; /* right-icon alignment */
  color: #333;
  padding: 10rpx 30rpx 20rpx;
  z-index: 10;
}

.back-btn {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  font-weight: 300;
  padding: 10rpx 20rpx;
  color: #FFF;
}

.right-icon {
  background: rgba(255, 255, 255, 0.4);
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #333;
}

/* 麦穗标题区域 */
.header-logo {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.logo-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-title {
  display: flex;
  align-items: center;
  font-size: 56rpx;
  font-weight: 900;
  color: #333;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 8rpx rgba(255,255,255,0.6);
}

.main-title .wheat-l, .main-title .wheat-r {
  font-size: 40rpx;
  margin: 0 10rpx;
  opacity: 0.8;
}

.sub-badge {
  background: #222;
  color: #EAC085;
  font-size: 22rpx;
  padding: 6rpx 40rpx;
  border-radius: 30rpx;
  margin-top: -10rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
}

.sub-badge::before, .sub-badge::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  transform: translateY(-50%);
}

.sub-badge::before {
  left: -20rpx;
  border-right: 20rpx solid #222;
}

.sub-badge::after {
  right: -20rpx;
  border-left: 20rpx solid #222;
}

/* 列表容器 */
.goods-list {
  padding: 0 24rpx;
}

/* 横向单列商品卡片 (同每日上新，可复用) */
.good-card {
  display: flex;
  background: #FFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 180, 180, 0.1);
}

.img-box {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f8f8f8;
}

.img-box .cover {
  width: 100%;
  height: 100%;
}

/* 底部右下角标签 */
.tag-label-btm {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(133, 203, 102, 0.9); /* 类似绿色特卖标签 */
  color: #FFF;
  font-size: 22rpx;
  text-align: center;
  padding: 4rpx 0;
  font-weight: bold;
}

/* ⚠️ 特色 TOP 角标设计 ⚠️ */
.rank-tag {
  position: absolute;
  top: -6rpx;
  left: 10rpx;
  width: 60rpx;
  height: 70rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 0 0 8rpx 8rpx;
  z-index: 5;
  box-shadow: 2rpx 4rpx 8rpx rgba(0,0,0,0.2);
  /* 制作旗帜缺角底边 */
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 85%, 0 100%);
}

/* 第一名金底黑字 */
.rank-first {
  background: linear-gradient(135deg, #FFD87A, #F5B03E);
  color: #5A3500;
}

/* 后续黑底银字/白字 */
.rank-other {
  background: linear-gradient(135deg, #555, #222);
  color: #EAC085;
}

.rank-tag .lbl {
  font-size: 16rpx;
  font-weight: bold;
  line-height: 1;
  margin-bottom: 2rpx;
}
.rank-tag .num {
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

/* 右侧文本域 */
.info-box {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title-row {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  font-weight: 500;
}

.jd-icon {
  display: inline-block;
  background: #FF4142;
  color: #FFF;
  font-size: 20rpx;
  padding: 0 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

.name {
  vertical-align: middle;
}

.share-tag {
  color: #FF5A5A;
  font-size: 24rpx;
}

.bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bottom-row .price {
  color: #FF5A5A;
  font-size: 40rpx;
  font-weight: bold;
}

.bottom-row .buy-btn {
  background: linear-gradient(90deg, #FF6F5B, #FF4542);
  color: #FFF;
  font-size: 26rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
}

.empty-tip {
  text-align: center;
  color: #aaa;
  font-size: 28rpx;
  padding: 80rpx 0;
}
