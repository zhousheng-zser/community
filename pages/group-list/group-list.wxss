.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.create-btn {
  padding: 12rpx 24rpx;
  background: #FF9F43;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  border: none;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.group-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.group-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.group-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.group-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.group-last-msg {
  font-size: 24rpx;
  color: #999;
}

.group-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.group-time {
  font-size: 22rpx;
  color: #999;
}

.group-members {
  font-size: 20rpx;
  color: #666;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.group-actions {
  margin-left: 20rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
  border-radius: 16rpx;
  border: none;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 40rpx;
  background: #FF9F43;
  color: #fff;
  font-size: 28rpx;
  border-radius: 24rpx;
  border: none;
}
