<view class="detail-wrap">
  <view class="mock-banner" wx:if="{{isMock}}">演示模式 · 后端未返回时使用本地示例</view>

  <scroll-view class="detail-scroll" scroll-y="true">
    <!-- 状态头部 -->
    <view class="detail-hero na-gradient">
      <view class="detail-hero-inner">
        <view class="detail-pill">{{order.statusText || '—'}}</view>
        <text class="detail-hero-title">{{order.title}}</text>
        <view class="detail-no-row">
          <text class="detail-hero-no">单号 {{order.orderNo}}</text>
          <text class="detail-copy" bindtap="copyOrderNo">复制</text>
        </view>
        <view class="detail-amount-row" wx:if="{{order.rewardText}}">
          <text class="detail-amount-label">悬赏金额</text>
          <text class="detail-amount">¥{{order.rewardText}}</text>
        </view>
        <view class="pay-status-badge" wx:if="{{order.payStatus === 'unpaid'}}">待支付</view>
        <view class="pay-status-badge paid" wx:elif="{{order.payStatus === 'paid'}}">已支付</view>
      </view>
    </view>

    <view class="detail-sheet">
      <!-- 需求信息 -->
      <view class="sheet-section">
        <view class="sheet-head">
          <text class="sheet-title">需求信息</text>
        </view>
        <view class="sheet-body">
          <view class="kv" wx:if="{{order.category}}">
            <text class="k">服务类型</text>
            <view class="v-tag"><text class="tag">{{order.category}}</text></view>
          </view>
          <view class="kv" wx:if="{{order.serviceTime}}">
            <text class="k">期望时间</text>
            <text class="v">{{order.serviceTime}}</text>
          </view>
          <view class="kv" wx:if="{{order.contactPhone}}">
            <text class="k">联系电话</text>
            <text class="v">{{order.contactPhoneDisplay || order.contactPhone}}</text>
          </view>
          <view class="kv">
            <text class="k">备注</text>
            <text class="v multiline">{{order.desc || '—'}}</text>
          </view>
        </view>
      </view>

      <!-- 地址 -->
      <view class="sheet-section">
        <view class="sheet-head">
          <text class="sheet-title">地址信息</text>
        </view>
        <view class="sheet-body">
          <view class="addr-block" wx:if="{{order.pickupAddress || order.deliveryAddress}}">
            <view class="addr-item">
              <view class="addr-dot pickup">取</view>
              <view class="addr-info">
                <text class="addr-label">取货地址</text>
                <text class="addr-text">{{order.pickupAddress || order.address || '—'}}</text>
              </view>
            </view>
            <view class="addr-arrow"></view>
            <view class="addr-item">
              <view class="addr-dot delivery">送</view>
              <view class="addr-info">
                <text class="addr-label">送货地址</text>
                <text class="addr-text">{{order.deliveryAddress || order.address || '—'}}</text>
              </view>
            </view>
          </view>

          <view class="addr-block single" wx:elif="{{order.address}}">
            <view class="addr-item">
              <view class="addr-dot location">📍</view>
              <view class="addr-info">
                <text class="addr-label">服务地址</text>
                <text class="addr-text">{{order.address}}</text>
              </view>
            </view>
          </view>

          <view class="btn-row-2">
            <button class="sheet-btn ghost" bindtap="copyAddress">📋 复制地址</button>
            <button class="sheet-btn ghost" bindtap="openNav" wx:if="{{order.lat != null}}">🧭 导航</button>
          </view>
        </view>
      </view>

      <!-- 对方信息 -->
      <view class="sheet-section" wx:if="{{order.peerName}}">
        <view class="sheet-head">
          <text class="sheet-title">{{peerLabel}}</text>
        </view>
        <view class="sheet-body">
          <view class="peer-card">
            <view class="peer-avatar">👤</view>
            <view class="peer-info">
              <text class="peer-name">{{order.peerName}}</text>
              <text class="peer-phone">{{order.peerPhoneDisplay || '—'}}</text>
            </view>
          </view>
          <button class="call-big" bindtap="callPeer" wx:if="{{order.peerPhoneRaw}}">📞 拨打电话</button>
        </view>
      </view>

      <!-- 费用到账 -->
      <view class="sheet-section" wx:if="{{showFundsReceived}}">
        <view class="sheet-head">
          <text class="sheet-title">💰 费用到账</text>
        </view>
        <view class="sheet-body">
          <view class="kv">
            <text class="k">悬赏金额</text>
            <text class="v highlight">¥{{order.rewardText}}</text>
          </view>
          <view class="kv">
            <text class="k">到账状态</text>
            <text class="v success">✅ 已到账</text>
          </view>
        </view>
      </view>

      <!-- 服务执行（接单方） -->
      <view class="sheet-section" wx:if="{{myRole === 'helper' && showServeBlock}}">
        <view class="sheet-head">
          <text class="sheet-title">🔧 服务执行</text>
          <text class="sheet-sub">接单方</text>
        </view>
        <view class="sheet-body">
          <text class="serve-hint">到达服务地点附近后请先完成上门定位打卡，再提交「服务完成」等待发布人确认。</text>
          <view class="serve-item">
            <view class="serve-item-head">
              <text class="serve-item-title">上门定位打卡</text>
              <text class="serve-item-tag" wx:if="{{checkInDisplay}}">已打卡</text>
            </view>
            <text class="serve-item-desc" wx:if="{{checkInDisplay}}">{{checkInDisplay}}</text>
            <button class="sheet-btn block primary" bindtap="checkIn" disabled="{{checking || !!checkInDisplay}}" loading="{{checking}}">
              {{checking ? '定位中…' : (checkInDisplay ? '已完成打卡' : '上门定位打卡')}}
            </button>
          </view>

          <view class="serve-item" wx:if="{{showProofUpload}}">
            <text class="serve-item-title">服务完成凭证</text>
            <text class="serve-item-desc">请拍摄现场完成效果照片，至少 1 张，最多 6 张</text>
            <view class="proof-photo-grid" wx:if="{{proofUrls.length}}">
              <view class="proof-photo-cell" wx:for="{{proofUrls}}" wx:for-item="pUrl" wx:for-index="pidx" wx:key="*this">
                <image class="proof-photo-img" src="{{pUrl}}" mode="aspectFill" data-index="{{pidx}}" data-kind="upload" bindtap="previewProofPhoto"></image>
                <view class="proof-photo-del" data-index="{{pidx}}" catchtap="removeProofPhoto">×</view>
              </view>
            </view>
            <button class="sheet-btn block ghost" bindtap="chooseProofPhoto" wx:if="{{proofUrls.length < 6}}">📷 拍照 / 上传凭证</button>
          </view>

          <button class="sheet-btn block ghost" bindtap="completeService" disabled="{{!canCompleteService || !proofUrls.length || completing}}" loading="{{completing}}" wx:if="{{bucket === 'in_service'}}">✅ 提交服务完成</button>
        </view>
      </view>

      <!-- 发布人：服务进度 -->
      <view class="sheet-section" wx:if="{{myRole === 'publisher' && ((checkInDisplay && bucket === 'in_service') || showProofForPublisher)}}">
        <view class="sheet-head">
          <text class="sheet-title">服务进度</text>
        </view>
        <view class="sheet-body">
          <text class="serve-hint" wx:if="{{checkInDisplay && bucket === 'in_service'}}">接单邻居 {{checkInDisplay}}，正在为您服务。</text>
          <text class="serve-hint" wx:if="{{bucket === 'pending_confirm'}}">接单邻居已提交服务完成，请查看凭证后确认订单。</text>
          <view class="proof-block" wx:if="{{showProofForPublisher}}">
            <text class="proof-block-title">服务完成凭证</text>
            <view class="proof-photo-grid">
              <image class="proof-photo-img" wx:for="{{completionProofImages}}" wx:for-item="pUrl" wx:for-index="pidx" wx:key="*this" src="{{pUrl}}" mode="aspectFill" data-index="{{pidx}}" data-kind="server" bindtap="previewProofPhoto"></image>
            </view>
          </view>
        </view>
      </view>

      <!-- 发布人操作 -->
      <view class="sheet-section" wx:if="{{myRole === 'publisher'}}">
        <view class="sheet-head">
          <text class="sheet-title">📝 发布人操作</text>
        </view>
        <view class="sheet-body">
          <button class="sheet-btn block primary" bindtap="confirmDone" wx:if="{{bucket === 'pending_confirm'}}">✅ 确认订单完成</button>
          <button class="sheet-btn block ghost" bindtap="goReview" wx:if="{{bucket === 'completed' && !reviewed}}">⭐ 去评价</button>
          <button class="sheet-btn block ghost" bindtap="openComplaint">⚠️ 投诉 / 纠纷</button>
        </view>
      </view>

      <!-- 沟通 -->
      <view class="sheet-section">
        <view class="sheet-head">
          <text class="sheet-title">💬 沟通</text>
        </view>
        <view class="sheet-body">
          <view class="waiting-text" wx:if="{{!order.peerName && !canCommunityGrab && myRole === 'publisher'}}">待接单</view>
          <button class="sheet-btn block primary chat-btn" bindtap="openChat" wx:elif="{{order.peerName}}">💬 文字 / 语音聊天</button>
          <view class="waiting-text" wx:else>待接单</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 接单按钮 -->
  <view class="bottom-bar" wx:if="{{(myRole === 'helper' && bucket === 'pending_accept') || canAcceptOrder}}">
    <button class="bar-btn primary" bindtap="acceptOrder">接单</button>
  </view>

  <!-- 社区成员接单按钮 -->
  <view class="bottom-bar" wx:elif="{{canCommunityGrab}}">
    <button class="bar-btn primary" bindtap="communityGrabOrder">邻里接单</button>
  </view>

  <!-- 发布人-待支付时显示支付和取消按钮 -->
  <view class="bottom-bar multi" wx:elif="{{canPay}}">
    <button class="bar-btn ghost" bindtap="cancelOrder">取消订单</button>
    <button class="bar-btn primary" bindtap="goPay">去支付</button>
  </view>

  <!-- 投诉弹窗 -->
  <view class="modal-mask" wx:if="{{complaintShow}}" catchtouchmove="noop">
    <view class="modal-box">
      <text class="modal-title">投诉 / 纠纷</text>
      <textarea class="modal-ta" placeholder="请描述问题" value="{{complaintText}}" bindinput="onComplaintInput" maxlength="500" />
      <view class="modal-actions">
        <button class="modal-btn ghost" bindtap="closeComplaint">取消</button>
        <button class="modal-btn primary" bindtap="submitComplaint">提交</button>
      </view>
    </view>
  </view>

  <!-- 评价弹窗 -->
  <view class="modal-mask" wx:if="{{reviewShow}}" catchtouchmove="noop">
    <view class="modal-box">
      <text class="modal-title">评价接单邻居</text>
      <view class="star-row">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{reviewScore >= item ? 'on' : ''}}" bindtap="setReviewScore" data-score="{{item}}">★</text>
      </view>
      <textarea class="modal-ta" placeholder="选填评价内容" value="{{reviewText}}" bindinput="onReviewText" maxlength="300" />
      <view class="modal-actions">
        <button class="modal-btn ghost" bindtap="closeReview">取消</button>
        <button class="modal-btn primary" bindtap="submitReview">提交</button>
      </view>
    </view>
  </view>
</view>
