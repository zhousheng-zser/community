page {
  background: #f3f4f6;
  height: 100%;
}

.detail-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.mock-banner {
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #92400e;
  background: #fef3c7;
  text-align: center;
}

.detail-scroll {
  flex: 1;
  height: 0;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.na-gradient {
  background: linear-gradient(135deg, #ff8a3d 0%, #ff6b35 50%, #ea580c 100%);
  padding: 40rpx 32rpx 48rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.detail-pill {
  display: inline-block;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  margin-bottom: 16rpx;
}

.detail-hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
}

.detail-no-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.detail-hero-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.detail-copy {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.detail-amount {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.detail-sheet {
  margin: -20rpx 24rpx 0;
  position: relative;
  z-index: 2;
}

.sheet-section {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.sheet-head {
  padding: 24rpx 28rpx 8rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.sheet-body {
  padding: 12rpx 28rpx 28rpx;
}

.kv {
  display: flex;
  padding: 10rpx 0;
  font-size: 28rpx;
  gap: 16rpx;
}

.k {
  color: #6b7280;
  width: 160rpx;
  flex-shrink: 0;
}

.v {
  flex: 1;
  color: #374151;
}

.v.multiline {
  white-space: pre-wrap;
}

.addr-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
}

.btn-row-2 {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.sheet-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  line-height: 1.4;
}

.sheet-btn.block {
  width: 100%;
  margin-top: 16rpx;
}

.sheet-btn.primary {
  background: #ff7a00;
  color: #fff;
}

.sheet-btn.ghost {
  background: #f3f4f6;
  color: #374151;
}

.call-big {
  margin-top: 20rpx;
  background: #ecfdf5;
  color: #059669;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.serve-hint {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  display: block;
}

.serve-item {
  margin-bottom: 20rpx;
}

.serve-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.serve-item-desc {
  font-size: 24rpx;
  color: #6b7280;
  margin: 8rpx 0;
  display: block;
}

.chat-btn {
  margin-top: 8rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-btn.primary {
  background: #ff7a00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.modal-box {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 20rpx;
}

.modal-ta {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}

.modal-btn.primary {
  background: #ff7a00;
  color: #fff;
}

.modal-btn.ghost {
  background: #f3f4f6;
  color: #374151;
}

.star-row {
  margin-bottom: 16rpx;
}

.star {
  font-size: 48rpx;
  color: #d1d5db;
  margin-right: 8rpx;
}

.star.on {
  color: #fbbf24;
}
