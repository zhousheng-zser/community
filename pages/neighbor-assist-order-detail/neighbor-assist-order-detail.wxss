page {
  background: #f5f5f5;
  height: 100%;
}

.detail-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.mock-banner {
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #92400e;
  background: #fef3c7;
  text-align: center;
}

.detail-scroll {
  flex: 1;
  height: 0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 鐘舵€佸ご閮?===== */
.na-gradient {
  background: #000000;
  padding: 40rpx 32rpx 56rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.detail-hero-inner {
  position: relative;
}

.detail-pill {
  display: inline-block;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  margin-bottom: 16rpx;
  backdrop-filter: blur(4rpx);
}

.detail-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
}

.detail-no-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.detail-hero-no {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.detail-copy {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.detail-amount-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-amount-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.detail-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
}

.pay-status-badge {
  display: inline-block;
  background: #fff3e6;
  color: #e67e22;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
  font-weight: 600;
}

.pay-status-badge.paid {
  background: #e8f5e9;
  color: #27ae60;
}

/* ===== 淇℃伅鍗＄墖 ===== */
.detail-sheet {
  margin: -24rpx 24rpx 0;
  position: relative;
  z-index: 2;
}

.sheet-section {
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.sheet-head {
  padding: 28rpx 28rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.sheet-sub {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

.sheet-body {
  padding: 8rpx 28rpx 28rpx;
}

/* 閿€煎 */
.kv {
  display: flex;
  padding: 14rpx 0;
  font-size: 28rpx;
  gap: 20rpx;
  align-items: flex-start;
}

.k {
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
}

.v {
  flex: 1;
  color: #333;
  line-height: 1.5;
}

.v.multiline {
  white-space: pre-wrap;
  line-height: 1.6;
}

.v.highlight {
  color: #ff7700;
  font-weight: 700;
  font-size: 32rpx;
}

.v.success {
  color: #27ae60;
  font-weight: 600;
}

.v-tag {
  flex: 1;
}

.tag {
  display: inline-block;
  background: #fff3e6;
  color: #ff7700;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

/* 鍦板潃淇℃伅 */
.addr-block {
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.addr-block.single {
  padding: 20rpx 24rpx;
}

.addr-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.addr-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.addr-dot.pickup {
  background: #000000;
}

.addr-dot.delivery {
  background: #27ae60;
}

.addr-dot.location {
  background: #409eff;
  font-size: 20rpx;
}

.addr-arrow {
  width: 2rpx;
  height: 32rpx;
  background: #ddd;
  margin: 12rpx 0 12rpx 23rpx;
}

.addr-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.addr-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.addr-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 瀵规柟淇℃伅鍗＄墖 */
.peer-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.peer-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.peer-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.peer-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.peer-phone {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 鎸夐挳 */
.btn-row-2 {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.sheet-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 20rpx;
  line-height: 1.4;
  border: none;
}

.sheet-btn::after {
  border: none;
}

.sheet-btn.block {
  width: 100%;
  margin-top: 16rpx;
}

.sheet-btn.primary {
  background: #000000;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 119, 0, 0.25);
}

.sheet-btn.ghost {
  background: #f5f5f5;
  color: #333;
}

.call-big {
  margin-top: 16rpx;
  background: #e8f5e9;
  color: #27ae60;
  font-size: 28rpx;
  border-radius: 12rpx;
  font-weight: 600;
  border: none;
}

.call-big::after {
  border: none;
}

/* 鏈嶅姟鎵ц */
.serve-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
  line-height: 1.5;
}

.serve-item {
  margin-bottom: 24rpx;
}

.serve-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.serve-item-tag {
  font-size: 22rpx;
  color: #16a34a;
  font-weight: 600;
}

.serve-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.serve-item-desc {
  font-size: 24rpx;
  color: #999;
  margin: 8rpx 0 12rpx;
  display: block;
}

.proof-block {
  margin-top: 16rpx;
}

.proof-block-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.proof-photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.proof-photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.proof-photo-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.proof-photo-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.chat-btn {
  margin-top: 8rpx;
}

/* 搴曢儴鎿嶄綔鏍?*/
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
  z-index: 100;
}

.bottom-bar.multi {
  justify-content: space-between;
}

.bar-btn {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0 48rpx;
  border-radius: 36rpx;
  margin: 0;
  border: none;
  font-weight: 600;
}

.bar-btn::after {
  border: none;
}

.bar-btn.ghost {
  border: 2rpx solid #ddd;
  color: #333;
  background: #fff;
}

.bar-btn.primary {
  background: #000000;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255, 119, 0, 0.3);
}

/* 寮圭獥 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.modal-box {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 24rpx;
  color: #333;
}

.modal-ta {
  width: 100%;
  min-height: 160rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 22rpx;
  border: none;
  font-weight: 600;
}

.modal-btn::after {
  border: none;
}

.modal-btn.primary {
  background: #000000;
  color: #fff;
}

.modal-btn.ghost {
  background: #f5f5f5;
  color: #333;
}

.star-row {
  margin-bottom: 20rpx;
}

.star {
  font-size: 52rpx;
  color: #ddd;
  margin-right: 12rpx;
}

.star.on {
  color: #ffc107;
}

.waiting-text {
  text-align: center;
  font-size: 28rpx;
  color: #bbb;
  padding: 32rpx 0;
  background: #fafafa;
  border-radius: 12rpx;
}

