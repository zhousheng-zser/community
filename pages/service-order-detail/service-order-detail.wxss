.page {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 24rpx;
  box-sizing: border-box;
}
.hint {
  text-align: center;
  color: #888;
  padding: 80rpx;
}
.hero {
  background: #000000;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.status-pill {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  margin-bottom: 12rpx;
}
.title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}
.no,
.line {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.label {
  font-size: 24rpx;
  color: #64748b;
  display: block;
}
.val {
  font-size: 30rpx;
  color: #111;
  margin-top: 8rpx;
  display: block;
}
.val.multiline {
  white-space: pre-wrap;
  line-height: 1.45;
}
.btn {
  margin-top: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}
.btn.primary {
  background: #000000;
  color: #fff;
}
.btn.ghost {
  background: #fff;
  color: #374151;
  border: 1rpx solid #e5e7eb;
}
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.modal-box {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}
.modal-ta {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.modal-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx;
  border-radius: 12rpx;
}
.modal-btn.primary {
  background: #000000;
  color: #fff;
}
.modal-btn.ghost {
  background: #f3f4f6;
  color: #374151;
}

