<view class="order-page">
  <scroll-view class="tab-scroll" scroll-x scroll-with-animation>
    <view class="tab-row">
      <view class="order-tab {{activeTab===item.key?'active':''}}" wx:for="{{tabs}}" wx:key="key" bindtap="switchTab" data-key="{{item.key}}">{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="order-content">
    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载中...</text>
    </view>
    <block wx:elif="{{list.length > 0}}">
      <view class="order-card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="order-card-head">
          <text class="order-svc-name">{{item.serviceName}}</text>
          <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="order-card-row">
          <text class="order-label">预约时间</text>
          <text class="order-val">{{item.bookTime}}</text>
        </view>
        <view class="order-card-row">
          <text class="order-label">服务地址</text>
          <text class="order-val">{{item.address}}</text>
        </view>
        <view class="order-card-foot">
          <text class="order-price">￥{{item.price}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty-wrap">
      <text class="empty-icon">📋</text>
      <text class="empty-text">订单为空</text>
    </view>
  </view>
</view>
