page { background: #f5f5f5; }
.order-page { min-height: 100vh; }
.tab-scroll { background: #fff; border-bottom: 1rpx solid #eee; white-space: nowrap; }
.tab-row { display: flex; padding: 0 10rpx; }
.order-tab { flex-shrink: 0; padding: 26rpx 24rpx; font-size: 28rpx; color: #888; position: relative; white-space: nowrap; }
.order-tab.active { color: #FF7A00; font-weight: 700; }
.order-tab.active::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 5rpx; border-radius: 3rpx; background: #FF7A00; }
.order-content { padding: 20rpx; }
.loading-wrap, .empty-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 200rpx 0; }
.loading-text { font-size: 28rpx; color: #bbb; }
.empty-icon { font-size: 110rpx; opacity: 0.25; }
.empty-text { margin-top: 24rpx; font-size: 28rpx; color: #bbb; }
.order-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.order-card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.order-svc-name { font-size: 30rpx; font-weight: 600; color: #222; }
.order-status { font-size: 24rpx; }
.order-status.pending { color: #f87c00; }
.order-status.done { color: #4caf50; }
.order-status.cancel { color: #bbb; }
.order-card-row { display: flex; margin-bottom: 10rpx; }
.order-label { font-size: 24rpx; color: #999; width: 140rpx; flex-shrink: 0; }
.order-val { flex: 1; font-size: 24rpx; color: #555; }
.order-card-foot { margin-top: 16rpx; text-align: right; }
.order-price { font-size: 30rpx; color: #f64e4e; font-weight: 700; }
