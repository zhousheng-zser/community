page {
  background: #f4f5f7;
}

.push-list-page {
  min-height: 100vh;
}

/* 头部大横幅区 */
.hero-banner {
  position: relative;
  width: 100%;
  height: 460rpx; /* 高度给足，让图有展示空间 */
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 微信顶导区域叠加在 Banner 之上 */
.top-nav {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
  padding: 10rpx 18rpx 20rpx;
}

.top-nav .back-btn {
  font-size: 36rpx;
  font-weight: 400;
  width: 60rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.top-nav .title {
  font-size: 34rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

/* 横幅内的大标题和口号 */
.hero-content {
  position: relative;
  z-index: 5;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-title {
  color: #fff;
  font-size: 80rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 4rpx;
  text-shadow: 4rpx 4rpx 0 #EA580C, 0 8rpx 16rpx rgba(0,0,0,0.4);
}

.hero-sub-wrap {
  margin-top: 12rpx;
  display: inline-block;
}

.hero-sub {
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(8rpx);
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

/* 主体内容区（涵盖搜索框与商品瀑布流） */
.main-content {
  position: relative;
  z-index: 20;
  background: #f4f5f7;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -32rpx; /* 向上挤压横幅，形成圆角遮盖 */
  padding-top: 20rpx;
  min-height: calc(100vh - 428rpx);
}

/* 礼物专区子分类横向滑动 */
.gift-sub-scroll {
  width: 100%;
  white-space: nowrap;
  padding: 10rpx 0 20rpx;
  background: #f4f5f7;
}

.gift-sub-row {
  display: inline-flex;
  padding: 0 20rpx;
}

.gift-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.gift-sub-item image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  background: #eee;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.gift-sub-item text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #c47663; /* 对应图一中的主题色偏粉棕 */
}

.gift-sub-item.active image {
  border-color: #ff594d;
  box-shadow: 0 4rpx 12rpx rgba(255, 89, 77, 0.35);
}

/* 独立圆角搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 10rpx 30rpx 20rpx;
  border-radius: 999rpx;
  padding: 10rpx 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}

.search-input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  background: #ff524e;
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  margin-left: 20rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 10rpx;
  justify-content: space-between;
}

.item {
  width: 48.5%;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.item .cover-img {
  width: 100%;
  height: 350rpx;
}

.info-wrap {
  padding: 16rpx;
}

.info-wrap .name {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
  height: 72rpx; /* 强制两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
  color: #e53935;
  font-size: 36rpx;
  font-weight: 600;
}

.price-row .yen {
  font-size: 24rpx;
}

.price-row .tag {
  font-size: 18rpx;
  color: #fff;
  background: linear-gradient(90deg, #ff7a70, #e53935);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.action-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.action-row .rebate {
  font-size: 20rpx;
  color: #e53935;
  background: #ffeaeb;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.action-row .buy-btn {
  font-size: 22rpx;
  color: #fff;
  background: #e53935;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
}

/* ================================
   本地商城甄选专区专属逻辑 (左右侧分栏)
   ================================ */
.sidebar-layout {
  display: flex;
  width: 100%;
  height: calc(100vh - 428rpx); /* 精确计算确保 Scroll-view 起效 */
  background: #fff;
}

/* 左侧导航栏 */
.sidebar-left {
  width: 180rpx;
  background: #f4f5f7;
  height: 100%;
}

.sidebar-item {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.sidebar-item.active {
  background: #fff;
  color: #333;
  font-weight: 700;
}

.sidebar-item.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 30rpx;
  bottom: 30rpx;
  width: 8rpx;
  background: #ff524e;
  border-radius: 0 4rpx 4rpx 0;
}

/* 右侧内容区 */
.sidebar-right {
  flex: 1;
  background: #fff;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 单列商品排版 */
.list-item {
  display: flex;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  padding: 16rpx;
}

.list-cover {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}

.list-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.list-name {
  font-size: 28rpx;
  color: #333;
  line-height: 40rpx;
  font-weight: 600;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 10rpx;
}

.t-red {
  font-size: 20rpx;
  color: #ff524e;
  border: 1rpx solid #ff524e;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.list-bottom {
  margin-top: auto;
}

.list-price {
  color: #ff524e;
  font-size: 38rpx;
  font-weight: bold;
}

.list-comm {
  display: inline-block;
  background: linear-gradient(90deg, #ecc5b3, #e1c0b1);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-top: 6rpx;
}

/* ================================
   高佣专区专属逻辑 (满宽单列)
   ================================ */
.high-comm-notice {
  width: 100%;
  background: linear-gradient(90deg, #ff5741, #ff8129);
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 60, 0.2);
  margin-bottom: 20rpx;
}

.high-comm-layout {
  padding: 0 20rpx;
}
