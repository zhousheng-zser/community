page {
  background: #f3f3f3;
}

.tidy-page {
  padding: 0 14rpx 30rpx;
}

/* 顶部自定义导航 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 4rpx 14rpx;
}

.back-btn {
  font-size: 56rpx;
  color: #333;
  line-height: 1;
  padding: 0 10rpx;
  font-weight: 300;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.nav-ph {
  width: 60rpx;
}

/* 分类标签栏 */
.cate-scroll {
  width: 100%;
  white-space: nowrap;
}

.cate-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 10rpx;
  padding-right: 14rpx;
}

.cate-item {
  flex: 0 0 128rpx;
  background: #fff;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  height: 110rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #555;
}

.cate-item.active {
  border-color: #e8d49e;
  background: #fdf9f0;
  color: #c9943a;
}

.cate-icon {
  width: 44rpx;
  height: 44rpx;
}

.cate-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  text-align: center;
  max-width: 110rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 服务卡片列表 */
.service-list {
  margin-top: 16rpx;
}

.service-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  align-items: flex-start;
}

.service-card image {
  width: 168rpx;
  height: 126rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.service-card .info {
  margin-left: 18rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 126rpx;
}

.s-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
}

.s-price {
  display: block;
  margin-top: 10rpx;
  color: #f5860f;
  font-size: 36rpx;
  font-weight: 700;
}

.s-meta {
  display: block;
  margin-top: 8rpx;
  color: #999;
  font-size: 26rpx;
}

.nomore {
  display: block;
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin: 22rpx 0 10rpx;
}

.empty-tip {
  text-align: center;
  color: #bbb;
  font-size: 28rpx;
  padding: 60rpx 0;
}
