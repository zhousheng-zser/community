<view class="worker-page">
  <view class="top-bar" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈 📍</text>
    <view class="search">名称搜索</view>
    <text>•••</text>
  </view>

  <view class="category-wrap {{categoryExpanded ? 'expanded' : ''}}">
    <view class="category-grid">
      <view class="skill-list">
        <view class="skill-item" wx:for="{{categories}}" wx:key="*this">
        <view class="icon"></view>
        <text>{{item}}</text>
      </view>
      </view>
      <view class="expand-btn" bindtap="toggleCategory">
        <text>{{categoryExpanded ? '∧' : '∨'}}</text>
      </view>
    </view>
  </view>

  <view class="filter-row">
    <text>综合排序</text>
    <text>全部分类</text>
    <text>全部技工</text>
  </view>

  <view class="worker-card" wx:for="{{workers}}" wx:key="id" bindtap="goWorkerDetail" data-id="{{item.id}}">
    <image class="avatar" src="{{item.avatar}}" mode="aspectFill"></image>
    <view class="body">
      <view class="name-line">
        <text class="name">{{item.name}}</text>
        <text class="gender">{{item.gender}}</text>
      </view>
      <text class="region">{{item.region}}</text>
      <text class="meta">服务{{item.serviceCount}}单  工作经验{{item.exp}}年</text>
      <text class="desc">技工简介：{{item.desc}}</text>
      <view class="tags">
        <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="more">展开</text>
    </view>
  </view>
</view>
