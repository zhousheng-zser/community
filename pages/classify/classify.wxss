/* pages/classify/classify.wxss */
@import "../../tpl/notask/notask.wxss";
page {
  background-color: #fff;
  height: 100%;
}

.container {
  display: flex;
  height: 100%;
}

.menu-wrap {
  flex: 0 0 auto;
  border-right: 1px solid #eee;
}

.menu {
  width: 150rpx;
  padding: 16rpx 0;
  margin: 20rpx 0;
  text-align: center;
  border-left: 3px solid #fff;
  border-right: 3px solid #fff;
}

.menu.active {
  color: #e64340;
  border-left-color: #e64340;
}

.title {
  display: block;
  margin-bottom: 40rpx;
  text-align: center;
}

.list {
  display: flex;
  flex-wrap: wrap;
  flex: 1 1 100%;
  background-color: #fff;
}

.section-image {
  width: 100%;
  margin-bottom: 20rpx;
}

.item {
  display: flex;
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
  border-bottom: 1px solid #f5f5f5; /* 增加底部边框区分行 */
}

.item .img {
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 120rpx;
  margin-right: 30rpx;
  border-radius: 8rpx;
}

.info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 24rpx;
  flex: 1; /* 撑满剩余空间 */
}

.name {
  font-size: 28rpx;
  font-weight: bold;
}

.desc {
  color: #a8a8a8;
  margin-top: 10rpx;
}

.text-red {
  font-size: 32rpx;
  font-weight: bold;
  color: #e64340;
}

.price-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.cart-btn {
  background-color: #e64340;
  color: #fff;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}

.content {
  height: 100%;
  width: 100%;
}

.content .scroll-view {
  height: 100%;
  width: 100%;
}
