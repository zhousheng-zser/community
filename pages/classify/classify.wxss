page {
  background: #f2f2f2;
}

.worker-page {
  padding: 18rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 10rpx;
  font-size: 26rpx;
}

.top-bar .search {
  flex: 1;
  margin: 0 16rpx;
  background: #f0f0f0;
  border-radius: 28rpx;
  padding: 12rpx 20rpx;
  color: #a9a9a9;
}

.skill-row {
  white-space: nowrap;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
}

.skill-row .inner {
  display: flex;
}

.skill-item {
  width: 130rpx;
  text-align: center;
  margin-right: 16rpx;
}

.skill-item .icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 33rpx;
  margin: 0 auto 8rpx;
  background: linear-gradient(180deg, #ff9ab0 0%, #86c2ff 100%);
}

.skill-item text {
  font-size: 20rpx;
}

.filter-row {
  margin-top: 14rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  color: #7a7a7a;
}

.worker-card {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx;
  display: flex;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
}

.body {
  flex: 1;
}

.name-line {
  display: flex;
  align-items: center;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
}

.gender {
  margin-left: 8rpx;
  color: #e953a0;
}

.region {
  margin-top: 8rpx;
  display: inline-block;
  font-size: 20rpx;
  color: #8b8b8b;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.meta,
.desc {
  display: block;
  margin-top: 8rpx;
  color: #555;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tags text {
  margin-right: 8rpx;
  margin-top: 8rpx;
  background: #f4f4f4;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #888;
}

.more {
  margin-top: 10rpx;
  display: inline-block;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 2rpx 18rpx;
  font-size: 20rpx;
  color: #777;
}
