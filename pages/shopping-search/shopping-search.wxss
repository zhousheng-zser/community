.ss-page {
  padding-bottom: 40rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}
.ss-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.ss-mode-switch {
  font-size: 28rpx;
  color: #333;
  padding-right: 20rpx;
  font-weight: bold;
}
.ss-input {
  flex: 1;
  background: #f0f0f0;
  border-radius: 30rpx;
  padding: 10rpx 30rpx;
  font-size: 28rpx;
}
.ss-go {
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #FF7700;
  font-weight: bold;
}

.ss-section {
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}
.ss-h {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.ss-clear {
  color: #999;
  font-size: 28rpx;
  font-weight: normal;
}
.ss-tags {
  display: flex;
  flex-wrap: wrap;
}
.ss-tag {
  background: #f5f5f5;
  color: #333;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  margin: 0 20rpx 20rpx 0;
}
.ss-empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 60rpx 0;
}

/* 过滤控制器 */
.ss-filter-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  background: #fff;
  margin-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}
.ss-filter-item {
  font-size: 28rpx;
  color: #666;
}
.ss-filter-item.active {
  color: #FF7700;
  font-weight: bold;
}

/* 商品卡片容器 */
.ss-goods-list {
  padding: 0 16rpx;
  display: flex;
  flex-direction: column;
}
.ss-goods-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
}
.g-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.g-body {
  margin-left: 24rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.g-name {
  font-size: 30rpx;
  color: #333;
  line-height: 44rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.g-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}
.sale-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF7700;
}
.orig-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}
.g-sales {
  font-size: 24rpx;
  color: #999;
}

/* 店铺卡片容器 */
.ss-shop-list {
  padding: 0 16rpx;
}
.ss-shop-card {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 16rpx;
  padding: 24rpx;
}
.shop-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.shop-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.shop-info {
  flex: 1;
}
.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.shop-tags {
  margin-top: 6rpx;
}
.shop-tags .tag {
  background: #ffebe0;
  color: #FF7700;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
}
.followers {
  color: #999;
  font-size: 24rpx;
}
.btn-enter {
  border: 1rpx solid #FF7700;
  border-radius: 30rpx;
  color: #FF7700;
  font-size: 24rpx;
  padding: 8rpx 30rpx;
}
.shop-goods-preview {
  display: flex;
  gap: 16rpx;
}
.shop-goods-preview image {
  width: 216rpx;
  height: 216rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

/* 猜你喜欢卡片 (老代码借用) */
.ss-guess {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.ss-gitem {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}
.ss-gimg {
  width: 100%;
  height: 340rpx;
}
.ss-gname {
  font-size: 28rpx;
  padding: 16rpx;
  color: #333;
  display: block;
}
