.ss-page { min-height: 100vh; background: #f5f5f5; padding: 20rpx; box-sizing: border-box; }
.ss-bar { display: flex; align-items: center; gap: 16rpx; background: #fff; padding: 16rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.ss-input { flex: 1; font-size: 28rpx; }
.ss-go { color: #ff7a00; font-weight: 600; }
.ss-section { margin-bottom: 28rpx; }
.ss-h { display: flex; justify-content: space-between; font-size: 26rpx; font-weight: 600; margin-bottom: 12rpx; }
.ss-clear { color: #888; font-weight: 400; font-size: 24rpx; }
.ss-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ss-tag { background: #fff; padding: 12rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; }
.ss-guess { display: flex; flex-wrap: wrap; gap: 16rpx; }
.ss-gitem { width: 30%; background: #fff; border-radius: 8rpx; padding: 8rpx; font-size: 22rpx; }
.ss-gimg { width: 100%; height: 120rpx; border-radius: 6rpx; }
.ss-gname { display: block; margin-top: 6rpx; color: #333; }
.ss-empty { color: #999; font-size: 24rpx; }
.ss-res { display: flex; gap: 16rpx; background: #fff; padding: 16rpx; border-radius: 12rpx; margin-bottom: 12rpx; align-items: center; }
.ss-rimg { width: 120rpx; height: 120rpx; border-radius: 8rpx; }
.ss-rname { display: block; font-size: 28rpx; }
.ss-rprice { color: #b45309; font-weight: 700; }
