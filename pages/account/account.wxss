/* pages/account/account.wxss */

.top {
  background: linear-gradient(135deg, #3a7bd5 0%, #00d2ff 100%);
  color: #fff;
  text-align: center;
  padding: 50rpx 0 110rpx 0;
  line-height: 1;
}

.top .name {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  opacity: 0.85;
}

.top .money {
  display: block;
  font-size: 80rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.list {
  width: 90%;
  margin: 0 auto;
  margin-top: -80rpx;
}

.item {
  position: relative;
  margin-top: 20rpx;
  background-color: #fff;
  padding: 0 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.item .name {
  display: block;
  padding: 24rpx 0;
  border-bottom: 1px solid #f0f0f0;
  font-size: 28rpx;
  color: #333;
}

.item .money {
  display: block;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  padding: 28rpx 0;
}

.money-left {
  flex: 1;
}

.money-wrap {
  display: flex;
  justify-content: space-around;
}

.btn-wrap {
  display: inline-block;
  position: absolute;
  font-size: 24rpx;
  border: 1px solid #3adda3;
  color: #3adda3;
  line-height: 1;
  padding: 8rpx 18rpx;
  right: 30rpx;
  top: 22rpx;
  border-radius: 20rpx;
}

.green {
  color: #3adda3;
}

.red {
  color: #f7504a;
}

/* 功能入口卡片区 */
.func-cards {
  width: 90%;
  margin: 30rpx auto 60rpx;
}

.func-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  transition: transform 0.15s;
}

.func-card:active {
  transform: scale(0.98);
}

.func-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-records {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
.icon-records::after {
  content: '📋';
  font-size: 36rpx;
}

.icon-partner {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}
.icon-partner::after {
  content: '🤝';
  font-size: 36rpx;
}

.icon-commission {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}
.icon-commission::after {
  content: '💰';
  font-size: 36rpx;
}

.func-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.func-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.func-desc {
  font-size: 24rpx;
  color: #999;
}

.func-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 10rpx;
}
