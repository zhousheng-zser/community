page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.periodic-page {
  min-height: 100vh;
  position: relative;
  /* 默认兜底背景 */
  background: #f5f6f8;
}

/* ==================================
   1. 通用顶部框架 (头部渐变与大字)
================================== */
.hero-header {
  position: relative;
  overflow: hidden;
  height: 480rpx;
  padding: 10rpx 30rpx;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 20;
}

.back-btn {
  font-size: 40rpx;
  font-weight: 300;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.right-icon {
  background: rgba(255, 255, 255, 0.3);
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #fff;
}

/* 背景字母修饰 - 透水印效果 */
.bg-deco-text {
  position: absolute;
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 180rpx;
  font-weight: 900;
  font-style: italic;
  color: rgba(255, 255, 255, 0.08); /* 半透作为背景元素 */
  z-index: 1;
  white-space: nowrap;
}

/* 中间正标题与角标区域 */
.title-zone {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.main-title {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
  margin-bottom: 20rpx;
}

/* 双菱形装饰副标题 */
.sub-title-bar {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  position: relative;
}

.sub-text {
  font-size: 26rpx;
}

.sub-corner {
  position: absolute;
  width: 0;
  height: 0;
  border: 10rpx solid transparent;
}


/* ==================================
   2. 三种主题色的特化处理
================================== */
/* A. 今日主推：蓝紫发散星光 */
.theme-today .hero-header {
  background: linear-gradient(135deg, #6c4af5 0%, #1e3a8a 100%);
}
.theme-today .main-title {
  color: #ffd447; /* 黄金标题 */
}
.theme-today .sub-text {
  color: #d1d5db;
}

/* B. 本周热卖：黑金暗夜风 */
.theme-week .hero-header {
  background: linear-gradient(180deg, #111111 0%, #291c12 100%);
}
/* 本周热卖的背景色是深色系，直接改量 */
.theme-week .bg-deco-text {
  color: rgba(255, 100, 0, 0.06); 
  text-shadow: 0 0 30rpx rgba(255,90,0,0.4);
}
.theme-week .main-title {
  color: #fff;
  text-shadow: 0 4rpx 12rpx #ff6600; /* 火焰发光字 */
}
.theme-week .sub-title-bar {
  background: linear-gradient(90deg, rgba(30,30,30,0) 0%, rgba(200,150,80,0.2) 50%, rgba(30,30,30,0) 100%);
}
.theme-week .sub-text {
  color: #dcb380; /* 旧金色 */
}

/* C. 本月排行：紫水晶冷淡风 */
.theme-month .hero-header {
  background: linear-gradient(135deg, #d8b4fe 0%, #a78bfa 100%);
}
.theme-month .main-title {
  color: #5b21b6;
  text-shadow: none;
}
.theme-month .sub-title-bar {
  background: #fff;
  border-radius: 40rpx;
  padding: 4rpx 30rpx;
}
.theme-month .sub-text {
  color: #7c3aed;
}

/* ==================================
   3. 全局商品垂直列表区
================================== */
.list-container {
  padding: 0 24rpx 60rpx;
  margin-top: -60rpx; /* 向上穿透盖住海报 */
  position: relative;
  z-index: 30;
}

.card-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.06);
  position: relative; /* 为左上角的徽标定位 */
}

/* 左上角粘附的红色榜单签 */
.badge {
  position: absolute;
  top: 0;
  left: 0;
  background: #ff5f53;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx 0 20rpx 0;
  z-index: 5;
}

/* 内层水平包裹 (左图右字) */
.main-info {
  display: flex;
}

.cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border: 1rpx solid #f0f0f0;
}

.details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.g-title {
  font-size: 28rpx;
  color: #222;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

/* 底部价格与动作区 */
.g-bottom {
  margin-top: 20rpx;
}

.price-wrap {
  color: #ff4d3d;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.p-sign {
  font-size: 24rpx;
}

.p-val {
  font-size: 38rpx;
}

.action-row {
  display: flex;
  align-items: center;
  border: 2rpx solid #ff4d3d;
  border-radius: 8rpx;
  overflow: hidden; /* 切割两侧不同颜色 */
}

.comm-box {
  flex: 1;
  text-align: center;
  background: #fff;
  color: #888;
  font-size: 22rpx;
  padding: 6rpx 0;
}

.buy-btn {
  background: #ff4d3d;
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  font-weight: bold;
}

/* ==================================
   4. 底部推荐理由行
================================== */
.reason-row {
  border-top: 2rpx dashed #eee;
  margin-top: 24rpx;
  padding-top: 20rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.thumb {
  margin-right: 8rpx;
}

.r-label {
  color: #222;
  font-weight: 600;
}

.r-cont {
  color: #666;
}

.loading-nomore {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx 0;
}
