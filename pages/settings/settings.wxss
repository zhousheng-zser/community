page { background: #f5f5f5; }
.settings-page { min-height: 100vh; padding-bottom: 40rpx; }
.settings-group { background: #fff; margin: 24rpx 0 0; }
.row { display: flex; align-items: center; padding: 0 28rpx; height: 100rpx; border-bottom: 1rpx solid #f0f0f0; }
.row:last-child { border-bottom: none; }
.row-label { flex: 1; font-size: 30rpx; color: #222; }
.cancel-text { color: #f64e4e; }
.row-value { font-size: 26rpx; color: #999; margin-right: 8rpx; }
.arrow { font-size: 36rpx; color: #ccc; font-weight: 300; }
.logout-area { padding: 60rpx 40rpx 20rpx; }
.logout-btn { height: 88rpx; border-radius: 44rpx; border: 2rpx solid #f64e4e; color: #f64e4e; font-size: 32rpx; display: flex; align-items: center; justify-content: center; }
