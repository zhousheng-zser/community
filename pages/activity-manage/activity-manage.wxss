.am-page { padding: 40rpx; min-height: 100vh; background: #f5f5f5; }
.am-tip { display: block; font-size: 26rpx; color: #555; line-height: 1.6; margin-bottom: 32rpx; }
.am-btn { margin-bottom: 24rpx; background: #000000; color: #fff; border-radius: 12rpx; }
.am-btn.ghost { background: #fff; color: #ff7a00; border: 1rpx solid #ff7a00; }

