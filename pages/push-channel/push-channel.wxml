<view class="push-channel-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈</text>
    <text class="title">爆款专区</text>
    <text>•••</text>
  </view>

  <image class="hero" src="https://images.unsplash.com/photo-1542838132-92c53300491e?w=1200&q=80" mode="aspectFill"></image>

  <view class="search-row">
    <text class="ph">请输入关键词</text>
    <text class="btn">搜索</text>
  </view>

  <view class="goods-grid">
    <navigator class="good" wx:for="{{goods}}" wx:key="id" url="../push-product-detail/push-product-detail?id={{item.id}}">
      <image src="{{item.image}}" mode="aspectFill"></image>
      <text class="name">{{item.name}}</text>
      <text class="price">￥{{item.price}}</text>
    </navigator>
  </view>

  <view class="live-card">
    <view class="head">
      <text>热推直播间</text>
      <navigator url="../push-live-detail/push-live-detail">查看全部 ></navigator>
    </view>
    <navigator class="item" url="../push-live-detail/push-live-detail">
      <text class="name">三只松鼠 ThreeSquirrels</text>
      <text class="btn">去推广</text>
    </navigator>
  </view>
</view>
