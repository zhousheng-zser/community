<view class="push-channel-page">
  <!-- 顶部标题栏保留返回键，中间放艺术字样式的九州好物 -->
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text class="back-btn" bindtap="goBack">〈</text>
    <view class="title-logo">
      <view class="title-box">
        <text class="text">{{pageTitle}}</text>
      </view>
    </view>

  </view>

  <!-- 分类选项卡 -->
  <view class="tabs">
    <view 
      class="tab-item {{currentTab === index ? 'active' : ''}}" 
      wx:for="{{categories}}" 
      wx:key="*this"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      {{item}}
    </view>
  </view>

  <!-- 瀑布流商品列表 -->
  <view class="goods-grid">
    <navigator class="good" wx:for="{{goods}}" wx:key="id" url="../push-product-detail/push-product-detail?id={{item.id}}">
      <image class="cover" src="{{item.image}}" mode="aspectFill"></image>
      <view class="info-box">
        <text class="name">{{item.name}}</text>
        <text class="share-tag">{{item.shareTag}}</text>
        <text class="price">￥{{item.price}}</text>
      </view>
    </navigator>
  </view>
</view>
