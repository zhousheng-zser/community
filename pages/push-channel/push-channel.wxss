page {
  background: #f5f5f5;
}

.push-channel-page {
  min-height: 100vh;
  background: #ff2f2f;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
  padding: 10rpx 18rpx 12rpx;
  font-size: 28rpx;
}

.top-nav .title {
  font-size: 34rpx;
  font-weight: 600;
}

.hero {
  width: 100%;
  height: 260rpx;
}

.search-row {
  margin: 14rpx 16rpx 0;
  background: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 10rpx 10rpx 10rpx 20rpx;
}

.search-row .ph {
  flex: 1;
  color: #b0b0b0;
}

.search-row .btn {
  width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ff6d42;
  border-radius: 28rpx;
  color: #fff;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx;
}

.good {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.good image {
  width: 100%;
  height: 260rpx;
  border-radius: 12rpx 12rpx 0 0;
}

.good .name {
  display: block;
  background: #fff;
  padding: 10rpx;
  font-size: 24rpx;
  min-height: 68rpx;
}

.good .price {
  display: block;
  background: #fff;
  color: #e65d39;
  font-size: 38rpx;
  padding: 0 10rpx 10rpx;
  border-radius: 0 0 12rpx 12rpx;
}

.live-card {
  margin: 10rpx 16rpx 16rpx;
  background: #fff4f0;
  border-radius: 14rpx;
  padding: 14rpx;
}

.live-card .head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #9e513d;
}

.live-card .item {
  margin-top: 10rpx;
  background: #fff;
  border-radius: 10rpx;
  padding: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.live-card .btn {
  background: #ff6444;
  color: #fff;
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}
