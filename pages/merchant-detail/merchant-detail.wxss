page {
  background: #efefef;
}

.merchant-page {
  padding: 18rpx;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  margin-bottom: 18rpx;
  padding-bottom: 8rpx;
}

.search-box {
  flex: 1;
  margin: 0 16rpx;
  background: #f0f0f0;
  border-radius: 28rpx;
  padding: 12rpx 20rpx;
  color: #a9a9a9;
}

.category-wrap {
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx;
}

.category-grid {
  display: flex;
  align-items: flex-start;
}

.cate-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  max-height: 118rpx;
  overflow: hidden;
}

.category-wrap.expanded .cate-list {
  max-height: 1200rpx;
}

.cate-item {
  width: 20%;
  text-align: center;
  margin-bottom: 20rpx;
}

.cate-item .icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 33rpx;
  margin: 0 auto 8rpx;
  background: linear-gradient(180deg, #ff9ab0 0%, #86c2ff 100%);
}

.cate-item text {
  font-size: 20rpx;
}

.expand-btn {
  width: 52rpx;
  height: 52rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #f5f6f8;
  color: #666;
  font-size: 24rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.filter-row {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.filter-row .active {
  width: 170rpx;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  background: #d90e16;
  color: #fff;
  border-radius: 16rpx;
  font-size: 38rpx;
}

.drop-btn {
  width: 100rpx;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  background: #fff;
  border-radius: 16rpx;
  color: #555;
  font-size: 34rpx;
}

.merchant-list {
  margin-top: 12rpx;
}

.merchant-card,
.notice-card,
.empty-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx;
}

.merchant-card {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.merchant-card image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  margin-right: 14rpx;
}

.merchant-card .info {
  flex: 1;
}

.merchant-card .name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.merchant-card .time {
  display: block;
  margin-top: 8rpx;
  color: #888;
}

.merchant-card .desc {
  display: block;
  margin-top: 8rpx;
}

.merchant-card .tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.merchant-card .tags text {
  margin-right: 8rpx;
  margin-bottom: 8rpx;
  background: #f4f4f4;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 20rpx;
  color: #777;
}

.merchant-card .role {
  color: #333;
}

.arrow {
  color: #444;
}

.notice-card {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
}

.section-title {
  margin: 24rpx 0 16rpx;
  font-size: 42rpx;
}

.empty-card {
  height: 680rpx;
  text-align: center;
}

.empty {
  display: block;
  text-align: center;
  margin-top: 20rpx;
  color: #b6bcc6;
  font-size: 60rpx;
}

.sub-tabs {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 12rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  justify-content: space-around;
  padding: 18rpx 0;
  color: #8a8a8a;
}

.sub-tabs .active {
  color: #a12a2a;
  position: relative;
}

.sub-tabs .active::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: -8rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: #b53030;
}
