<view class="merchant-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈 📍</text>
    <view class="search-box">名称搜索</view>
    <text>•••</text>
  </view>

  <view class="category-wrap {{categoryExpanded ? 'expanded' : ''}}">
    <view class="category-grid">
      <view class="cate-list">
        <view class="cate-item" wx:for="{{categories}}" wx:key="*this">
          <view class="icon"></view>
          <text>{{item}}</text>
        </view>
      </view>
      <view class="expand-btn" bindtap="toggleCategory">
        <text>{{categoryExpanded ? '∧' : '∨'}}</text>
      </view>
    </view>
  </view>

  <view class="filter-row">
    <text class="active">全部</text>
    <view class="drop-btn">⌄</view>
  </view>

  <view class="merchant-list">
    <view class="merchant-card" wx:for="{{merchants}}" wx:key="id">
      <image src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <text class="time">{{item.orders}}</text>
        <text class="desc">{{item.desc}}</text>
        <view class="tags">
          <text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="role">🧰 {{item.role}}</text>
      </view>
    </view>
  </view>
  <view class="empty">没有更多了</view>
</view>
