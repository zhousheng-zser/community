<view class="merchant-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈 果壳里的城</text>
    <text>•••</text>
  </view>

  <view class="merchant-card">
    <image src="{{merchant.avatar}}" mode="aspectFill"></image>
    <view class="info">
      <text class="name">{{merchant.name}}</text>
      <text class="time">服务时间：{{merchant.time}}</text>
    </view>
    <text class="arrow">〉</text>
  </view>

  <view class="notice-card">
    <text>🔊</text>
    <text class="arrow">〉</text>
  </view>

  <view class="section-title">精选服务</view>
  <view class="empty-card">
    <text class="empty">列表为空</text>
  </view>

  <view class="sub-tabs">
    <text class="active">首页</text>
    <text>产品</text>
    <text>分类</text>
    <text>客服</text>
  </view>
</view>
