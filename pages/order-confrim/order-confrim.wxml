<!--pages/order-confrim/order-confrim.wxml-->
<view class="oc-page">

  <!-- 服务地址卡片 -->
  <view class="oc-card">
    <view class="oc-row" bindtap="pickServiceAddr">
      <view class="oc-required">*</view>
      <text class="oc-label">服务地址</text>
      <text class="oc-val {{serviceAddr ? '' : 'oc-ph'}}">{{serviceAddr || '请选择服务地址'}}</text>
      <text class="oc-arrow">›</text>
    </view>
    <view class="oc-divider"></view>
    <view class="oc-row">
      <view class="oc-required">*</view>
      <text class="oc-label">门牌号</text>
      <input class="oc-input" placeholder="请选择地点" placeholder-class="oc-ph" value="{{doorNum}}" bindinput="onOcInput" data-field="doorNum" />
    </view>
    <view class="oc-divider"></view>
    <view class="oc-row oc-contact-row">
      <view class="oc-required">*</view>
      <text class="oc-label">联系人</text>
      <input class="oc-input" placeholder="请输入联系人姓名" placeholder-class="oc-ph" value="{{contactName}}" bindinput="onOcInput" data-field="contactName" />
      <view class="oc-gender">
        <view class="oc-gender-opt" bindtap="setGender" data-g="先生">
          <view class="oc-radio {{contactGender === '先生' ? 'checked' : ''}}"></view>
          <text class="oc-gender-txt">先生</text>
        </view>
        <view class="oc-gender-opt" bindtap="setGender" data-g="女士">
          <view class="oc-radio {{contactGender === '女士' ? 'checked' : ''}}"></view>
          <text class="oc-gender-txt">女士</text>
        </view>
      </view>
    </view>
    <view class="oc-divider"></view>
    <view class="oc-row">
      <view class="oc-required">*</view>
      <text class="oc-label">联系电话</text>
      <input class="oc-input" placeholder="请填写联系电话" placeholder-class="oc-ph" type="number" value="{{contactPhone}}" bindinput="onOcInput" data-field="contactPhone" maxlength="11" />
    </view>
  </view>

  <!-- 商品卡片 -->
  <view class="oc-card oc-prod-card" wx:if="{{bundleMode}}">
    <view class="oc-bundle-head">
      <text class="oc-prod-name">{{product.name}}</text>
      <text class="oc-prod-sub">{{product.sub}}</text>
    </view>
    <view class="oc-bundle-line" wx:for="{{bundleLines}}" wx:key="index">
      <text class="oc-bl-title">{{item.title}}</text>
      <text class="oc-bl-meta">×{{item.qty}} ￥{{item.price}}</text>
    </view>
  </view>
  <view class="oc-card oc-prod-card" wx:else>
    <image class="oc-prod-img" src="{{product.image}}" mode="aspectFill"></image>
    <view class="oc-prod-info">
      <text class="oc-prod-name">{{product.name}}</text>
      <text class="oc-prod-sub">{{product.sub}}</text>
      <text class="oc-prod-price">{{product.price}}元/份</text>
    </view>
    <view class="oc-qty">
      <view class="oc-qty-btn" bindtap="decQty">−</view>
      <text class="oc-qty-num">{{qty}}</text>
      <view class="oc-qty-btn" bindtap="incQty">+</view>
    </view>
  </view>

  <!-- 优惠券 -->
  <view class="oc-card">
    <view class="oc-row">
      <text class="oc-label">优惠券</text>
      <text class="oc-val oc-ph">暂无可用优惠券</text>
      <text class="oc-arrow">›</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="oc-card">
    <view class="oc-remark-tip">可提前来，来之前打电话，请尽快联系我</view>
    <textarea
      class="oc-remark"
      placeholder="如有特殊要求,请给商家带句话"
      placeholder-class="oc-ph"
      value="{{remark}}"
      bindinput="onOcInput"
      data-field="remark"
      auto-height
    ></textarea>
  </view>

  <view class="oc-spacer"></view>
</view>

<!-- 底部支付栏 -->
<view class="oc-pay-note">微信小程序内仅支持微信支付；支付宝等请使用平台其它渠道。</view>
<view class="oc-bottom-bar">
  <view class="oc-total">
    <text class="oc-total-label">待支付</text>
    <text class="oc-total-price">{{totalPrice}}元</text>
  </view>
  <view class="oc-submit-btn" bindtap="submitOrder">立即购买</view>
</view>
