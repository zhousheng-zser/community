<!--pages/address/address.wxml-->
<view class="addr-page">

  <!-- 地址列表 -->
  <view class="addr-list" wx:if="{{list.length > 0}}">
    <view class="addr-card" wx:for="{{list}}" wx:key="id">
      <!-- 默认标签 -->
      <view class="default-tag" wx:if="{{item.isDefault}}">默认</view>

      <view class="card-body" bindtap="editAddress" data-item="{{item}}">
        <view class="addr-top">
          <text class="addr-name">{{item.name}}</text>
          <text class="addr-phone">{{item.phone}}</text>
        </view>
        <text class="addr-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
      </view>

      <view class="card-footer">
        <view class="footer-left" bindtap="setDefault" data-id="{{item.id}}" wx:if="{{!item.isDefault}}">
          <view class="circle-check"></view>
          <text class="set-default-text">设为默认</text>
        </view>
        <view class="footer-left" wx:else>
          <view class="circle-check checked"></view>
          <text class="set-default-text active">已设默认</text>
        </view>
        <view class="footer-right">
          <view class="foot-btn" bindtap="editAddress" data-item="{{item}}">
            <text class="foot-icon">✏️</text>
            <text>编辑</text>
          </view>
          <view class="foot-btn danger" bindtap="deleteAddress" data-id="{{item.id}}">
            <text class="foot-icon">🗑️</text>
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{!loading}}">
    <text class="empty-emoji">📭</text>
    <text class="empty-title">暂无收货地址</text>
    <text class="empty-sub">添加地址，下单时快速填写</text>
  </view>

  <!-- 底部新增按钮 -->
  <view class="add-bar">
    <view class="add-btn" bindtap="addAddress">
      <text class="add-icon">＋</text>
      <text class="add-text">新增收货地址</text>
    </view>
  </view>

  <!-- 编辑/新增弹窗 -->
  <view wx:if="{{form.show}}" class="modal-overlay" catchtap="closeForm"></view>
  <view wx:if="{{form.show}}" class="modal-sheet">
    <view class="modal-header">
      <text class="modal-title">{{form.id ? '编辑地址' : '新增地址'}}</text>
      <text class="modal-close" bindtap="closeForm">✕</text>
    </view>
    <scroll-view class="modal-body" scroll-y>
      <!-- 姓名 -->
      <view class="form-row">
        <text class="form-label required">收货人</text>
        <input class="form-input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInput" data-field="name" />
      </view>
      <!-- 手机 -->
      <view class="form-row">
        <text class="form-label required">手机号</text>
        <input class="form-input" placeholder="请输入手机号" type="number" value="{{form.phone}}" bindinput="onInput" data-field="phone" maxlength="11" />
      </view>
      <!-- 地区 picker -->
      <view class="form-row" bindtap="chooseRegion">
        <text class="form-label required">所在地区</text>
        <text class="form-value" wx:if="{{form.province}}">{{form.province}} {{form.city}} {{form.district}}</text>
        <text class="form-placeholder" wx:else>请选择省/市/区</text>
        <text class="form-arrow">›</text>
      </view>
      <!-- 详细地址 -->
      <view class="form-row detail-row">
        <text class="form-label required">详细地址</text>
        <textarea class="form-textarea" placeholder="街道、楼栋、门牌号" value="{{form.detail}}" bindinput="onInput" data-field="detail" maxlength="100" auto-height></textarea>
      </view>
      <!-- 标签 -->
      <view class="form-row">
        <text class="form-label">标签</text>
        <view class="tag-list">
          <view
            class="tag-item {{form.tag === item ? 'active' : ''}}"
            wx:for="{{tags}}"
            wx:key="*this"
            bindtap="selectTag"
            data-tag="{{item}}"
          >{{item}}</view>
        </view>
      </view>
      <!-- 设为默认 -->
      <view class="form-row">
        <text class="form-label">设为默认</text>
        <switch checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#f64e4e" />
      </view>
    </scroll-view>
    <view class="modal-footer">
      <view class="save-btn {{canSave ? 'active' : ''}}" bindtap="saveAddress">保存</view>
    </view>
  </view>

</view>
