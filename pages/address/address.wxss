/* pages/address/address.wxss */
page { background: #f5f5f5; }
.addr-page { min-height: 100vh; padding-bottom: 160rpx; }

/* ===== 地址卡片 ===== */
.addr-list { padding: 20rpx 24rpx 0; }

.addr-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  position: relative;
}

.default-tag {
  position: absolute;
  top: 0; left: 0;
  background: #f64e4e;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 0 0 12rpx 0;
}

.card-body {
  padding: 32rpx 32rpx 20rpx;
}

.addr-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.addr-phone {
  font-size: 26rpx;
  color: #888;
}

.addr-detail {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  display: block;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
  background: #fafafa;
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.circle-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
}

.circle-check.checked {
  background: #f64e4e;
  border-color: #f64e4e;
}

.set-default-text {
  font-size: 24rpx;
  color: #aaa;
}

.set-default-text.active {
  color: #f64e4e;
}

.footer-right {
  display: flex;
  gap: 24rpx;
}

.foot-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #666;
}

.foot-btn.danger { color: #f64e4e; }
.foot-icon { font-size: 26rpx; }

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.empty-emoji { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: #333; margin-bottom: 12rpx; }
.empty-sub { font-size: 26rpx; color: #aaa; }

/* ===== 底部新增按钮 ===== */
.add-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx 32rpx 48rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.add-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #f64e4e, #ff8a65);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(246,78,78,0.3);
}

.add-icon { font-size: 36rpx; color: #fff; font-weight: 300; }
.add-text { font-size: 32rpx; font-weight: 600; color: #fff; }

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 200;
}

.modal-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 201;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
  flex-shrink: 0;
}

.modal-title { font-size: 32rpx; font-weight: 700; color: #1a1a1a; }
.modal-close { font-size: 36rpx; color: #bbb; padding: 0 8rpx; }

.modal-body { flex: 1; overflow: hidden; padding: 0 32rpx; }

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 16rpx;
}

.form-row.detail-row { align-items: flex-start; padding: 20rpx 0; }

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.form-label.required::before {
  content: '*';
  color: #f64e4e;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  min-height: 80rpx;
}

.form-value { flex: 1; font-size: 28rpx; color: #333; }
.form-placeholder { flex: 1; font-size: 28rpx; color: #ccc; }
.form-arrow { font-size: 32rpx; color: #ccc; }

.form-row.map-pick-row {
  min-height: 88rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.map-pick-link {
  flex: 1;
  font-size: 26rpx;
  color: #f64e4e;
  text-align: right;
}

/* 标签选择 */
.tag-list { display: flex; gap: 16rpx; flex-wrap: wrap; flex: 1; }
.tag-item {
  padding: 8rpx 28rpx;
  border-radius: 32rpx;
  border: 1rpx solid #e0e0e0;
  font-size: 26rpx;
  color: #666;
}
.tag-item.active {
  border-color: #f64e4e;
  background: #fff5f5;
  color: #f64e4e;
}

/* 底部保存 */
.modal-footer {
  padding: 20rpx 32rpx 48rpx;
  flex-shrink: 0;
  border-top: 1rpx solid #f2f2f2;
}

.save-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: #e0e0e0;
  color: #aaa;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn.active {
  background: linear-gradient(90deg, #f64e4e, #ff8a65);
  color: #fff;
}

/* ===== PICK MODE 样式 ===== */
.pick-wrap {
  padding: 24rpx 24rpx 0;
}

.pick-form-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.pf-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 32rpx;
}

.pf-contact-row { flex-wrap: nowrap; }

.pf-label {
  font-size: 30rpx;
  color: #333;
  width: 150rpx;
  flex-shrink: 0;
}

.pf-val { flex: 1; font-size: 28rpx; color: #333; }
.pf-ph-txt { flex: 1; font-size: 28rpx; color: #c8c8c8; }
.pf-ph-cls { color: #c8c8c8; font-size: 28rpx; }

.pf-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
}

.pf-arrow {
  font-size: 32rpx;
  color: #c8c8c8;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.pf-line {
  height: 1rpx;
  background: #f5f5f5;
  margin: 0 32rpx;
}

.gender-btns {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.gender-opt {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.radio-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #e0e0e0;
  background: #fff;
  flex-shrink: 0;
}

.radio-dot.checked {
  border-color: #e64340;
  background: #e64340;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.gender-label { font-size: 28rpx; color: #333; }

.save-use-btn {
  margin: 32rpx 0 48rpx;
  height: 100rpx;
  border-radius: 14rpx;
  background: #c0392b;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(192,57,43,0.35);
}
