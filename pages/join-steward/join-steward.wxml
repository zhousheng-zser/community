<view class="form-page">
  <view class="form-section">
    <text class="section-title">基本信息</text>
    <view class="form-row">
      <text class="form-label required">真实姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{form.realName}}" bindinput="onInput" data-key="realName"/>
    </view>
    <view class="form-row">
      <text class="form-label required">性别</text>
      <view class="gender-row">
        <view class="gender-opt" bindtap="setGender" data-val="男">
          <view class="radio {{form.gender==='男'?'checked':''}}"><view wx:if="{{form.gender==='男'}}" class="radio-dot"></view></view>
          <text>男</text>
        </view>
        <view class="gender-opt" bindtap="setGender" data-val="女">
          <view class="radio {{form.gender==='女'?'checked':''}}"><view wx:if="{{form.gender==='女'}}" class="radio-dot"></view></view>
          <text>女</text>
        </view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label required">手机号码</text>
      <input class="form-input" placeholder="{{maskedPhone || '请输入手机号码'}}" value="{{form.phone}}" bindinput="onInput" data-key="phone" type="number"/>
    </view>
    <view class="form-row">
      <text class="form-label required">身份证号</text>
      <input class="form-input" placeholder="请输入身份证号" value="{{form.idCard}}" bindinput="onInput" data-key="idCard"/>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">服务社区</text>
    <picker mode="selector" range="{{communityList}}" value="{{communityIndex}}" bindchange="onCommunityChange">
      <view class="form-row">
        <text class="form-label required">负责社区</text>
        <text class="{{form.community?'form-value':'form-placeholder'}}">{{form.community || '请选择服务社区'}}</text>
        <text class="form-arrow">›</text>
      </view>
    </picker>
    <view class="form-row" style="flex-direction:column;align-items:flex-start;">
      <text class="form-label">自我介绍</text>
      <textarea class="resume-textarea" placeholder="简要介绍您的社区服务经验" value="{{form.intro}}" bindinput="onInput" data-key="intro" maxlength="500"/>
    </view>
  </view>

  <view class="form-section">
    <text class="section-title">证件资料</text>
    <view class="form-row" bindtap="chooseIdCard">
      <text class="form-label required">身份证照片</text>
      <image wx:if="{{form.idFront}}" src="{{form.idFront}}" style="width:72rpx;height:72rpx;border-radius:8rpx;" mode="aspectFill"></image>
      <text wx:else class="form-placeholder">点击上传</text>
      <text class="form-arrow">›</text>
    </view>
  </view>

  <view class="submit-bar">
    <view class="agree-row" bindtap="toggleAgree">
      <view class="radio {{agreed?'checked':''}}"><view wx:if="{{agreed}}" class="radio-dot"></view></view>
      <text>我已阅读并同意《小区管家入驻协议》</text>
    </view>
    <button class="submit-btn" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交入驻申请</button>
  </view>
</view>
