<view class="mb-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text class="back" bindtap="goBack">〈</text>
    <text class="title">{{title}}</text>
    <view class="capsule">•••</view>
  </view>

  <image class="hero-banner" src="https://images.unsplash.com/photo-1607083206869-4c76720db39f?auto=format&fit=crop&w=600&q=80" mode="aspectFill"></image>

  <view class="shop-list">
    <view class="shop-card" wx:for="{{shops}}" wx:key="id" bindtap="goShop" data-id="{{item.id}}">
      <view class="shop-head">
        <image class="shop-logo" src="{{item.logo}}" mode="aspectFill"></image>
        <view class="shop-main">
          <text class="shop-name">{{item.name}}</text>
          <view class="row score-row">
            <text class="score">{{item.score}}</text>
            <text class="muted">{{item.monthSale}}</text>
          </view>
          <view class="row delivery-row">
            <text class="muted">{{item.delivery}}</text>
            <text class="muted">{{item.deliveryFee}}</text>
          </view>
        </view>
      </view>

      <view class="goods-preview" wx:if="{{item.previewGoods.length}}">
        <view class="preview-item" wx:for="{{item.previewGoods}}" wx:key="id">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <text class="name">{{item.name}}</text>
          <view class="price-row">
            <text class="price">￥{{item.price}}</text>
            <text class="old">￥{{item.oldPrice}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
