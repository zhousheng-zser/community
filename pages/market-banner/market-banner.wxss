page {
  background: #ececf4;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 18rpx 12rpx;
  font-size: 28rpx;
  background: #f5dfb2;
}

.top-nav .title {
  font-size: 34rpx;
  font-weight: 600;
}

.banner {
  width: calc(100% - 24rpx);
  height: 220rpx;
  margin: 12rpx;
  border-radius: 14rpx;
}
