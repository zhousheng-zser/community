page {
  background: #ececf4;
}

.mb-page {
  min-height: 100vh;
  padding-bottom: 24rpx;
}

.top-nav {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx 14rpx;
  background: #f5dfb2;
}

.back {
  width: 56rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #222;
}

.title {
  flex: 1;
  margin-left: 10rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #1f1f1f;
}

.capsule {
  min-width: 84rpx;
  height: 46rpx;
  border: 1rpx solid #ddd6c4;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #1f1f1f;
  text-align: center;
  line-height: 44rpx;
  background: rgba(255, 255, 255, 0.8);
}

.hero-banner {
  width: calc(100% - 32rpx);
  height: 250rpx;
  margin: 16rpx;
  border-radius: 16rpx;
}

.shop-list {
  padding: 0 16rpx;
}

.shop-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.shop-head {
  display: flex;
}

.shop-logo {
  width: 154rpx;
  height: 154rpx;
  border-radius: 14rpx;
  margin-right: 18rpx;
}

.shop-main {
  flex: 1;
}

.shop-name {
  display: block;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 600;
  color: #1f1f1f;
}

.row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.score {
  color: #e79d1e;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 22rpx;
}

.muted {
  color: #666;
  font-size: 28rpx;
  margin-right: 26rpx;
}

.goods-preview {
  display: flex;
  margin-top: 18rpx;
}

.preview-item {
  width: 25%;
  box-sizing: border-box;
  padding-right: 10rpx;
}

.preview-item:last-child {
  padding-right: 0;
}

.preview-item image {
  width: 100%;
  height: 130rpx;
  border-radius: 12rpx;
}

.preview-item .name {
  display: block;
  margin-top: 8rpx;
  color: #333;
  font-size: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.price-row {
  margin-top: 6rpx;
}

.preview-item .price {
  color: #e15b43;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.preview-item .old {
  color: #8a8a8a;
  text-decoration: line-through;
  font-size: 22rpx;
}
