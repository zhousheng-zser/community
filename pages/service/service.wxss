page {
  background: #f5f5f5;
}

.service-page {
  padding-bottom: 130rpx;
}

.top-nav {
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 20rpx 12rpx;
  font-size: 26rpx;
}

.top-nav .title {
  font-size: 34rpx;
  font-weight: 600;
}

.banner {
  width: 100%;
  height: 520rpx;
}

.title-card,
.spec-card,
.desc-card,
.notice-card,
.comment-card {
  background: #fff;
  margin-top: 16rpx;
  padding: 20rpx;
}

.name {
  display: block;
  font-size: 38rpx;
  color: #444;
}

.option-card {
  margin-top: 16rpx;
  border: 1rpx solid #e5c87f;
  border-radius: 10rpx;
  background: #f8f3e4;
  padding: 14rpx;
}

.option-name {
  display: block;
  font-size: 36rpx;
}

.option-price {
  display: block;
  margin-top: 8rpx;
  color: #d19e27;
  font-size: 46rpx;
  font-weight: 700;
}

.guarantee {
  background: #fff;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  color: #7b7b7b;
}

.guarantee .label {
  margin-right: 16rpx;
}

.guarantee text {
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.spec-card .head,
.comment-card .head {
  display: flex;
  justify-content: space-between;
  color: #686868;
}

.spec-list text {
  display: inline-block;
  margin-top: 14rpx;
  background: #f1f1f1;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.desc {
  display: block;
  color: #595959;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.desc-card image {
  width: 100%;
  margin-top: 10rpx;
  border-radius: 12rpx;
}

.empty {
  display: block;
  text-align: center;
  padding: 30rpx 0;
  color: #b0b0b0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.consult {
  width: 140rpx;
  text-align: center;
  color: #666;
}

.buy-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  color: #fff;
  font-size: 32rpx;
  background: linear-gradient(90deg, #ff2e2e 0%, #ff6a1f 100%);
}

.fav-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  flex-shrink: 0;
}

.fav-icon {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.fav-text {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.fav-btn-active .fav-icon {
  color: #ff6146;
}

.fav-btn-active .fav-text {
  color: #ff6146;
}
