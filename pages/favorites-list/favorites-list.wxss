page {
  background: #f5f5f5;
}

.fp-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.fp-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.fp-tab-active {
  color: #ff6146;
  font-weight: 600;
}

.fp-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #ff6146;
  border-radius: 2rpx;
}

.fp-local-tip {
  background: #fff8e1;
  padding: 18rpx 32rpx;
  font-size: 24rpx;
  color: #b07800;
  border-bottom: 1rpx solid #ffe082;
}

.fp-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

/* ── 工具栏 ── */
.fp-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}

.fp-hint {
  font-size: 26rpx;
  color: #888;
}

/* ── 骨架屏 ── */
.fp-skeleton {
  padding: 24rpx;
}

.fp-skel-item {
  height: 160rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── 列表 ── */
.fp-list {
  padding: 8rpx 24rpx 0;
}

.fp-item {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.fp-main {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
  min-width: 0;
}

/* ── 商品图片 ── */
.fp-cover-wrap {
  position: relative;
  flex-shrink: 0;
  width: 130rpx;
  height: 130rpx;
}

.fp-cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.fp-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  background: #f5f5f5;
}

.fp-off-tag {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.48);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 商品信息 ── */
.fp-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.fp-title {
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.fp-title.muted {
  color: #bbb;
}

.fp-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.fp-shop {
  font-size: 22rpx;
  color: #aaa;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fp-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6146;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.fp-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ── 取消按钮 ── */
.fp-unfav {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ff6146;
  background: #fff8f6;
  border-left: 1rpx solid #ffe8e4;
  flex-shrink: 0;
}

/* ── 加载更多 ── */
.fp-load-more,
.fp-no-more {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 28rpx 0;
}

/* ── 空/未登录 ── */
.fp-empty,
.fp-unlogin {
  padding: 120rpx 48rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fp-empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.fp-empty-text {
  display: block;
  font-size: 32rpx;
  color: #555;
  font-weight: 600;
}

.fp-empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.6;
}

.fp-login-btn {
  margin-top: 48rpx;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #ff6146;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  text-align: center;
  border: none;
}
