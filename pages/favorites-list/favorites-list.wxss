.fp-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 48rpx;
}

.fp-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}

.fp-hint {
  font-size: 26rpx;
  color: #888;
}

.fp-clear {
  font-size: 26rpx;
  color: #ff6146;
}

.fp-list {
  padding: 0 24rpx;
}

.fp-item {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.fp-main {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
  min-width: 0;
}

.fp-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eee;
}

.fp-body {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.fp-title {
  font-size: 30rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.fp-kind {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.fp-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.fp-unfav {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ff6146;
  background: #fff8f6;
  border-left: 1rpx solid #ffe8e4;
}

.fp-empty {
  padding: 120rpx 48rpx;
  text-align: center;
}

.fp-empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.fp-empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
}

.fp-empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.5;
}
