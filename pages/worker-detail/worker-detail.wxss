page {
  background: #f2f2f2;
}

.worker-detail-page {
  padding: 16rpx;
}

.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0 10rpx;
  font-size: 26rpx;
}

.top-nav .title {
  font-size: 34rpx;
  font-weight: 600;
}

.profile-card,
.comment-card,
.goods-card {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx;
}

.profile-card {
  display: flex;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  margin-right: 14rpx;
}

.name-row {
  display: flex;
  align-items: center;
}

.name-row .name {
  font-size: 34rpx;
  font-weight: 700;
}

.gender {
  margin-left: 8rpx;
  color: #f05ca0;
}

.region {
  margin-top: 8rpx;
  display: inline-block;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  color: #777;
  font-size: 20rpx;
}

.meta,
.desc {
  display: block;
  margin-top: 8rpx;
  color: #4d4d4d;
  font-size: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tags text {
  margin: 0 8rpx 8rpx 0;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #777;
  padding: 2rpx 10rpx;
}

.expand {
  display: inline-block;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
}

.comment-card .head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.empty {
  display: block;
  text-align: center;
  color: #b0b0b0;
  padding: 40rpx 0;
}

.goods-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.goods-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.goods-item .right {
  flex: 1;
}

.goods-item .name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.goods-item .price {
  display: block;
  margin-top: 8rpx;
  color: #e84b39;
  font-size: 36rpx;
}

.goods-item .sold {
  display: block;
  margin-top: 6rpx;
  color: #989898;
  font-size: 22rpx;
}

.buy-btn {
  background: #df1a19;
  color: #fff;
  border-radius: 16rpx;
  padding: 12rpx 18rpx;
  font-size: 24rpx;
}
