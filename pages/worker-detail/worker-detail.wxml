<view class="worker-detail-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text bindtap="goBack">〈</text>
    <text class="title">直约{{worker.name}}</text>
    <text>•••</text>
  </view>

  <view class="profile-card">
    <image class="avatar" src="{{worker.avatar}}" mode="aspectFill"></image>
    <view class="info">
      <view class="name-row">
        <text class="name">{{worker.name}}</text>
        <text class="gender">{{worker.gender}}</text>
      </view>
      <text class="region">{{worker.region}}</text>
      <text class="main-dir" wx:if="{{worker.mainDirection}}">主要方向：{{worker.mainDirection}}</text>
      <text class="meta">服务{{worker.serviceCount}}单  工作经验{{worker.exp}}年</text>
      <text class="desc">技工简介：{{worker.desc}}</text>
      <view class="tags">
        <text wx:for="{{worker.tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="comment-card">
    <view class="head">
      <text>大家对TA的评价 ({{reviewCount}})</text>
      <text>〉</text>
    </view>
    <view wx:if="{{reviews.length}}" class="review-list">
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-top">
          <text class="review-author">{{item.author}}</text>
          <text class="review-score">{{item.score}}分</text>
        </view>
        <text class="review-content">{{item.content}}</text>
        <text class="review-time" wx:if="{{item.time}}">{{item.time}}</text>
      </view>
    </view>
    <text wx:else class="empty">暂无评价，下单后欢迎首评</text>
  </view>

  <view class="goods-card">
    <view class="goods-head">服务项目（由平台/技工维护，下单后生成到家订单）</view>
    <view class="goods-item" wx:for="{{goods}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill"></image>
      <view class="right">
        <text class="name">{{item.name}}</text>
        <text class="price">￥{{item.price}}</text>
        <text class="sold">已接入平台服务</text>
      </view>
      <view class="buy-btn" bindtap="goBuy" data-id="{{item.id}}">立即购买</view>
    </view>
  </view>
</view>
