<view class="page">
  <view class="tabs">
    <view class="tab-item {{tab === 'published' ? 'active' : ''}}" data-tab="published" bindtap="setTab">我发布的</view>
    <view class="tab-item {{tab === 'helper' ? 'active' : ''}}" data-tab="helper" bindtap="setTab">我接的单</view>
  </view>

  <view wx:if="{{loading && list.length === 0}}" class="hint">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty-wrap">
    <text class="empty">{{emptyTip}}</text>
    <button class="pub-btn" bindtap="goPublish">去发布帮帮需求</button>
  </view>
  <view wx:else class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="row-top">
        <text class="tag">{{item.roleTag}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="title">{{item.title}}</view>
      <view class="row-meta" wx:if="{{item.time}}">
        <text class="meta">{{item.time}}</text>
      </view>
      <view class="row-meta" wx:if="{{item.amount != null && item.amount !== ''}}" style="display:flex;align-items:center;gap:8px;">
        <text class="amount">悬赏 ￥{{item.amount}}</text>
        <text class="pay-tag" wx:if="{{item.payStatus === 'unpaid'}}" style="font-size:11px;color:#e67e22;background:#fff3e6;padding:1px 6px;border-radius:4px;">待支付</text>
        <text class="pay-tag" wx:elif="{{item.payStatus === 'paid'}}" style="font-size:11px;color:#27ae60;background:#e8f5e9;padding:1px 6px;border-radius:4px;">已支付</text>
      </view>
    </view>
  </view>
</view>
