.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  color: #ff7a00;
  font-weight: 600;
  background: #fff8f0;
}

.empty-wrap {
  text-align: center;
  padding: 60rpx 32rpx;
}

.pub-btn {
  margin-top: 32rpx;
  background: #ff7a00;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.tag {
  font-size: 22rpx;
  color: #fff;
  background: #94a3b8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.title {
  font-size: 30rpx;
  color: #333;
  margin-top: 12rpx;
  line-height: 1.4;
}
.hint,
.empty {
  text-align: center;
  color: #888;
  padding: 80rpx 32rpx;
  font-size: 28rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.title {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}
.status {
  font-size: 26rpx;
  color: #ff7700;
  white-space: nowrap;
}
.row-meta {
  margin-top: 12rpx;
}
.meta {
  font-size: 24rpx;
  color: #999;
}
.amount {
  font-size: 28rpx;
  color: #e54d42;
}
