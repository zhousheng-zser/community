.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  position: relative;
  overflow-x: hidden;
}
.no-scroll {
  height: 100vh;
  overflow: hidden;
}

/* 椤堕儴杞挱 */
.goods-swiper {
  width: 100%;
  height: 750rpx;
  background: #fff;
}
.swiper-img {
  width: 100%;
  height: 100%;
}

/* 鍩虹淇℃伅鍗＄墖 */
.info-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
  color: #FF7700;
  margin-bottom: 16rpx;
}
.price-symbol {
  font-size: 32rpx;
  font-weight: bold;
}
.price-num {
  font-size: 50rpx;
  font-weight: bold;
}
.sales-num {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}
.goods-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

/* 瑙勬牸閫夋嫨娈?& 鍟嗗鍗＄墖 */
.card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.sku-entry {
  display: flex;
  align-items: center;
}
.sku-label {
  font-size: 28rpx;
  color: #999;
  width: 120rpx;
}
.sku-val {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}
.sku-entry .arrow {
  color: #ccc;
  font-size: 36rpx;
}

.shop-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.shop-header {
  display: flex;
  align-items: center;
}
.shop-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}
.shop-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.shop-entry {
  font-size: 26rpx;
  color: #FF7700;
}

/* 璇︽儏鍗＄墖 */
.detail-card {
  padding: 30rpx 0;
}
.detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 0 30rpx 20rpx;
}
.detail-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  padding: 0 30rpx;
}
.detail-content img {
  max-width: 100%;
  display: block;
  margin: 10rpx 0;
}

/* 搴曢儴鎿嶄綔鏉?*/
.bottom-space {
  height: 120rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 110rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  z-index: 90;
}
.bar-left {
  display: flex;
  align-items: center;
}
.kefu-btn, .cart-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  position: relative;
}
.kefu-btn .icon, .cart-btn .icon {
  font-size: 40rpx;
}
.kefu-btn .text, .cart-btn .text {
  font-size: 20rpx;
  color: #666;
  margin-top: 4rpx;
}
.badge {
  position: absolute;
  top: -4rpx;
  right: 10rpx;
  background: #FF4444;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 20rpx;
  text-align: center;
}

.bar-right {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  padding-left: 20rpx;
}
.bar-right button {
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 38rpx;
  margin: 0 0 0 16rpx;
  padding: 0 40rpx;
}
.bar-right button::after {
  content: none;
}
.add-cart {
  background: linear-gradient(90deg, #FFCB00, #FF9402);
  color: #fff;
}
.buy-now {
  background: #000000;
  color: #fff;
}


/* ================= 妯℃€侀伄缃?================= */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}

/* ================= SKU鍗婂睆寮圭獥 ================= */
.sku-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.sku-popup.show {
  transform: translateY(0);
}
.sku-popup-head {
  padding: 30rpx;
  display: flex;
  position: relative;
  align-items: flex-end;
}
.sku-cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  margin-top: -60rpx;
  border: 4rpx solid #fff;
}
.sku-price-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.sku-price {
  color: #FF7700;
  font-size: 36rpx;
  font-weight: bold;
}
.sku-stock, .sku-select-msg {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.sku-close {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.sku-popup-body {
  max-height: 50vh;
  padding: 0 30rpx 40rpx;
}
.sku-group {
  margin-top: 30rpx;
}
.sku-group-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}
.sku-items {
  display: flex;
  flex-wrap: wrap;
}
.sku-item {
  padding: 10rpx 30rpx;
  background: #f5f5f5;
  color: #333;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin: 0 20rpx 20rpx 0;
  border: 1rpx solid transparent;
}
.sku-item.active {
  background: #FFF1E5;
  border-color: #FF7700;
  color: #FF7700;
}

.sku-qty-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40rpx;
}
.qty-label {
  font-size: 28rpx;
  color: #333;
}
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  background: #f5f5f5;
  color: #333;
  border-radius: 6rpx;
  font-size: 36rpx;
}
.step-btn.disabled {
  color: #ccc;
}
.step-input {
  width: 80rpx;
  height: 50rpx;
  text-align: center;
  font-size: 28rpx;
  background: #f5f5f5;
  margin: 0 4rpx;
  border-radius: 6rpx;
}

.sku-popup-foot {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
}
.confirm-btn {
  width: 100%;
  border-radius: 40rpx;
  background: #000000;
  color: #fff;
  font-size: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* ================= 闂ㄥ簵绉佹湁璐墿杞︽娊灞?================= */
.cart-drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 102; /* 楂樹簬搴曟爮锛屼絾浣庝簬SKU寮圭獥鐨勯€昏緫濡傛灉鍒嗗紑锛岀洰鍓嶅畠鏈夌嫭绔嬮伄缃?*/
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}
.cart-drawer.show {
  transform: translateY(0);
}
.cart-drawer-head {
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  background: #fdfdfd;
  border-bottom: 1rpx solid #eee;
  border-radius: 24rpx 24rpx 0 0;
}
.cart-drawer-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.cart-drawer-title .desc {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
  margin-left: 10rpx;
}
.cart-drawer-clear {
  font-size: 24rpx;
  color: #999;
}
.cart-drawer-body {
  max-height: 50vh;
}
.cart-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}
.cart-item {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f9f9f9;
  align-items: flex-end;
}
.citem-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.citem-name {
  font-size: 28rpx;
  color: #333;
}
.citem-sku {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.citem-price {
  font-size: 32rpx;
  color: #FF7700;
  font-weight: bold;
  margin-top: 10rpx;
}
.stepper.mini .step-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  font-size: 32rpx;
  background: #000000;
  color: #fff;
  border-radius: 50%;
}
.stepper.mini .step-val {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
}

.cart-drawer-foot {
  display: flex;
  height: 100rpx;
  align-items: center;
}
.cfoot-left {
  flex: 1;
  background: #333;
  color: #fff;
  padding-left: 40rpx;
  display: flex;
  align-items: baseline;
}
.cfoot-symbol {
  font-size: 30rpx;
}
.cfoot-price {
  font-size: 40rpx;
  font-weight: bold;
}
.cfoot-right {
  width: 240rpx;
  background: #000000;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 100rpx;
  text-align: center;
}

