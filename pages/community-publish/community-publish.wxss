.container {
  padding: 30rpx;
  background-color: #fff;
  min-height: 100vh;
}

.input-area {
  margin-bottom: 20rpx;
}

.content-input {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.image-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.img-item {
  width: 210rpx;
  height: 210rpx;
  position: relative;
  background-color: #f5f5f5;
}

.img-item image {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #fff;
  border-radius: 50%;
}

.add-img-btn {
  width: 210rpx;
  height: 210rpx;
  background-color: #f7f7f7;
  display: flex;
  justify-content: center;
  align-items: center;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
}

.location-area {
  margin-bottom: 60rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
}

.location-input {
  font-size: 28rpx;
}

.submit-btn {
  background-color: #e64340;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  width: 100%;
  margin-top: 40rpx;
}

.submit-btn[disabled] {
  background-color: #f0a09e;
  color: #fff;
}
