.container {
  padding: 40rpx;
  background-color: #fff;
  min-height: 100vh;
}

.input-area {
  margin-bottom: 40rpx;
}

.content-input {
  width: 100%;
  height: 300rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
}

.image-area {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 48rpx;
}

.img-item {
  width: 216rpx;
  height: 216rpx;
  position: relative;
  background-color: #f8f8f8;
  margin-right: 11rpx;
  margin-bottom: 11rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.img-item:nth-child(3n) {
  margin-right: 0;
}

.img-item image {
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 8rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  z-index: 10;
}

.add-img-btn {
  width: 216rpx;
  height: 216rpx;
  background-color: #f7f8fa;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 12rpx;
  border: 1rpx dashed #dcdfe6;
}

.add-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.5;
}

.location-area {
  margin-bottom: 80rpx;
  border-bottom: 1rpx solid #f2f2f2;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
}

.location-icon {
  margin-right: 16rpx;
  font-size: 32rpx;
  color: #999;
}

.location-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.submit-btn {
  background: linear-gradient(90deg, #f6362b 0%, #ef3025 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 8rpx 20rpx rgba(246, 54, 43, 0.2);
}

.submit-btn[disabled] {
  background: #f0f0f0 !important;
  color: #999 !important;
  box-shadow: none;
}
