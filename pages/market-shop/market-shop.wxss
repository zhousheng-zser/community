page {
  background: #f3f3f3;
}

.ms-page {
  min-height: 100vh;
  padding-bottom: 130rpx;
}

.top-nav {
  background: #fff;
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx 12rpx;
}

.back {
  width: 56rpx;
  font-size: 42rpx;
  line-height: 1;
  color: #222;
}

.top-actions {
  flex: 1;
  display: flex;
  justify-content: center;
}

.icon {
  font-size: 34rpx;
  margin: 0 18rpx;
}

.capsule {
  min-width: 84rpx;
  height: 46rpx;
  border: 1rpx solid #e3e3e3;
  border-radius: 999rpx;
  text-align: center;
  line-height: 44rpx;
  font-size: 24rpx;
  color: #222;
}

.cover {
  width: 100%;
  height: 292rpx;
}

.shop-card {
  margin: -30rpx 24rpx 14rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 14rpx;
  display: flex;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}

.shop-logo {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  margin-right: 14rpx;
}

.shop-info {
  flex: 1;
}

.shop-name {
  display: block;
  font-size: 32rpx;
  color: #2b2b2b;
}

.shop-meta-grid {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  color: #8f8f8f;
  font-size: 24rpx;
}

.meta-value {
  margin-top: 4rpx;
  color: #3a3a3a;
  font-size: 30rpx;
}

.main-tabs {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  padding: 18rpx 0;
  display: flex;
  justify-content: space-around;
}

.main-tabs .tab {
  font-size: 32rpx;
  color: #8b8b8b;
  padding-bottom: 8rpx;
  border-bottom: 6rpx solid transparent;
}

.main-tabs .tab.active {
  color: #b7322f;
  border-bottom-color: #d2453a;
}

.goods-panel {
  margin: 0 24rpx;
  background: #fff;
  height: 870rpx;
  display: flex;
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
}

.left-cats {
  width: 180rpx;
  height: 100%;
  border-right: 1rpx solid #f1f1f1;
}

.cat-item {
  padding: 28rpx 14rpx;
  color: #8a8a8a;
  font-size: 30rpx;
  line-height: 1.3;
}

.cat-item.active {
  color: #b83b35;
}

.goods-list {
  flex: 1;
  height: 100%;
  padding: 8rpx 12rpx 20rpx;
  box-sizing: border-box;
}

.goods-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 10rpx;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.goods-item image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.goods-main {
  flex: 1;
  margin-left: 12rpx;
}

.goods-main .name {
  display: block;
  font-size: 34rpx;
  color: #2e2e2e;
}

.goods-main .sold {
  display: block;
  margin-top: 6rpx;
  color: #8d8d8d;
  font-size: 24rpx;
}

.price-row {
  margin-top: 8rpx;
}

.price {
  color: #d68027;
  font-size: 36rpx;
  margin-right: 12rpx;
}

.old {
  color: #9a9a9a;
  text-decoration: line-through;
  font-size: 26rpx;
}

.add {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #d91f25;
  color: #fff;
  font-size: 40rpx;
  text-align: center;
  line-height: 60rpx;
}

.comment-panel,
.about-panel {
  margin: 0 24rpx;
  background: #efefef;
  border-radius: 0 0 16rpx 16rpx;
  padding: 14rpx;
}

.notice-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
}

.comment-title {
  display: block;
  color: #333;
  font-size: 30rpx;
}

.comment-empty {
  display: block;
  margin-top: 12rpx;
  color: #999;
  font-size: 24rpx;
}

.notice-title {
  display: block;
  color: #333;
  font-size: 30rpx;
}

.notice-content {
  display: block;
  margin-top: 10rpx;
  color: #888;
  font-size: 24rpx;
  border-top: 1rpx solid #efefef;
  padding-top: 10rpx;
}

.table-card {
  margin-top: 14rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  border-bottom: 1rpx solid #f2f2f2;
  font-size: 24rpx;
  color: #4a4a4a;
}

.table-row:last-child {
  border-bottom: 0;
}

.table-row .value {
  color: #252525;
  margin-left: 20rpx;
}

.gallery-title-row {
  margin-top: 14rpx;
  display: flex;
  color: #3f3f3f;
  font-size: 24rpx;
}

.gallery-title-row text {
  width: 50%;
}

.gallery-row {
  margin-top: 8rpx;
  display: flex;
  gap: 8rpx;
}

.gallery-row image {
  width: calc(50% - 4rpx);
  height: 220rpx;
}

.license-title {
  display: block;
  margin-top: 14rpx;
  color: #3f3f3f;
  font-size: 24rpx;
}

.license {
  width: 48%;
  height: 260rpx;
  margin-top: 8rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 104rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.cart-box {
  width: 92rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #fff2f2;
  position: relative;
  text-align: center;
  line-height: 92rpx;
}

.cart-icon {
  font-size: 38rpx;
}

.dot {
  position: absolute;
  top: -8rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 16rpx;
  background: #dc1b1b;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 0 6rpx;
}

.total {
  flex: 1;
  margin-left: 12rpx;
}

.money {
  display: block;
  color: #b91717;
  font-size: 34rpx;
}

.desc {
  display: block;
  color: #8f8f8f;
  font-size: 20rpx;
  margin-top: 2rpx;
}

.settle {
  width: 180rpx;
  height: 82rpx;
  border-radius: 16rpx;
  background: #d91f25;
  color: #fff;
  text-align: center;
  line-height: 82rpx;
  font-size: 32rpx;
}
