.ms-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
  overflow: hidden;
}

.ms-empty-page {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  padding-top: calc(120rpx + env(safe-area-inset-top));
}
.ms-empty-text {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}

.top-nav {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  padding: 0 20rpx 20rpx;
  color: #fff;
  box-sizing: border-box;
}

.top-nav .back {
  font-size: 40rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
  padding: 10rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.top-actions .icon {
  font-size: 36rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

.top-actions .capsule {
  background: rgba(0,0,0,0.4);
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
}

.cover {
  width: 100%;
  height: 280rpx;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  filter: brightness(0.8);
}

.shop-card {
  position: relative;
  z-index: 10;
  background: #fff;
  margin: 180rpx 20rpx 20rpx;
  border-radius: 20rpx;
  padding: 30rpx 20rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  display: flex;
}

.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-top: -50rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.shop-info {
  flex: 1;
}

.shop-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #222;
  display: block;
}

.shop-meta-grid {
  display: flex;
  margin-top: 10rpx;
  gap: 30rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: 20rpx;
  color: #999;
}

.meta-value {
  font-size: 24rpx;
  color: #333;
  font-weight: bold;
  margin-top: 4rpx;
}

.shop-notice {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.shop-notice .tag {
  background: #fff0f0;
  color: #FF7700;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  white-space: nowrap;
}

.shop-notice .notice-text {
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.main-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 40rpx;
  z-index: 10;
  border-bottom: 1rpx solid #f1f1f1;
}

.main-tabs .tab {
  margin-right: 50rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding-bottom: 10rpx;
}

.main-tabs .tab.active {
  font-weight: bold;
  color: #333;
}

.main-tabs .tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #FF7700;
  border-radius: 4rpx;
}

.goods-panel {
  flex: 1;
  display: flex;
  overflow: hidden;
  background: #fff;
}

.left-menu {
  width: 170rpx;
  background: #f7f8fa;
  height: 100%;
}

.menu-item {
  padding: 30rpx 16rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  position: relative;
}

.menu-item.active {
  background: #fff;
  color: #333;
  font-weight: bold;
}

.menu-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 30rpx;
  background: #FF7700;
  border-radius: 0 4rpx 4rpx 0;
}

.right-goods {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}

.goods-group {
  padding-top: 20rpx;
}

.group-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  background: #f7f8fa;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 40rpx;
}

.goods-item image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f1f1;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.goods-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-main .name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-main .desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.goods-main .sold {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.prices {
  display: flex;
  align-items: baseline;
}

.prices .price {
  font-size: 32rpx;
  color: #FF7700;
  font-weight: bold;
}

.prices .old {
  font-size: 20rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
}

.step-btn.minus {
  border: 2rpx solid #ccc;
  color: #ccc;
  background: #fff;
  box-sizing: border-box;
}

.step-btn.plus {
  background: #FF7700;
  color: #fff;
}

.step-num {
  font-size: 26rpx;
  color: #333;
  width: 50rpx;
  text-align: center;
}

.placeholder-bottom {
  height: 160rpx;
}

.comment-panel, .about-panel {
  flex: 1;
  background: #fff;
  overflow-y: auto;
  padding: 30rpx;
}

.notice-card {
  background: #f9f9f9;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 300rpx;
}

.comment-empty {
  color: #999;
  font-size: 26rpx;
}

.table-card {
  border: 1rpx solid #f1f1f1;
  border-radius: 12rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f1f1f1;
  font-size: 26rpx;
  color: #333;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row text:first-child {
  width: 140rpx;
  color: #666;
}

.table-row .value {
  flex: 1;
  text-align: right;
}

.gallery-title-row {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.gallery-row {
  display: flex;
  gap: 20rpx;
}

.gallery-row image {
  flex: 1;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f1f1f1;
}

.license-title {
  display: block;
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.license {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  background: #f1f1f1;
}

/* 购物车 */
.bottom-bar {
  position: fixed;
  bottom: 30rpx;
  left: 20rpx;
  right: 20rpx;
  height: 100rpx;
  background: #333;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  z-index: 1000;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3);
}

.cart-box {
  position: relative;
  width: 110rpx;
  height: 100%;
  margin-left: 20rpx;
}

.cart-icon-wrap {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  width: 90rpx;
  height: 90rpx;
  background: #444;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 10rpx solid #333;
  transition: all 0.3s;
}

.cart-icon-wrap.active {
  background: #FF7700;
}

.cart-icon {
  font-size: 46rpx;
}

.cart-box .dot {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #FF7700;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  font-weight: bold;
  border: 2rpx solid #fff;
}

.total {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 20rpx;
}

.money {
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.money.empty {
  color: #ccc;
  font-size: 28rpx;
}

.desc {
  color: #999;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.settle {
  width: 180rpx;
  height: 100%;
  background: #555;
  color: #999;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 0 50rpx 50rpx 0;
}

.settle.active {
  background: #FF7700;
  color: #fff;
}

/* 购物车弹窗 */
.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  z-index: 900;
}

.cart-popup {
  position: fixed;
  bottom: -600rpx;
  left: 0;
  width: 100%;
  background: #fff;
  z-index: 950;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: 160rpx; /* 留出 bottom bar 的空间 */
  transition: transform 0.3s ease;
}

.cart-popup.show {
  transform: translateY(-600rpx); /* 将弹窗推起 */
  bottom: 0; 
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #f7f8fa;
  border-radius: 24rpx 24rpx 0 0;
}

.cart-header .title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.cart-header .clear-btn {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
}

.cart-list {
  max-height: 400rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

.cart-item:last-child {
  border-bottom: none;
}

.c-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.c-price {
  font-size: 32rpx;
  color: #FF7700;
  font-weight: bold;
  margin: 0 40rpx;
}
