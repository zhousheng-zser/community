page {
  background: #f3f3f3;
}

.ms-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.top-nav {
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 18rpx 12rpx;
  font-size: 28rpx;
}

.icons {
  display: flex;
  gap: 20rpx;
}

.cover {
  width: 100%;
  height: 180rpx;
}

.shop-card {
  margin: 12rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 14rpx;
  display: flex;
  align-items: center;
}

.shop-card image {
  width: 70rpx;
  height: 70rpx;
  margin-right: 10rpx;
}

.shop-card .name {
  display: block;
  font-size: 28rpx;
}

.shop-card .meta {
  display: block;
  margin-top: 6rpx;
  color: #888;
  font-size: 22rpx;
}

.tabs {
  margin: 0 12rpx;
  background: #fff;
  border-radius: 14rpx 14rpx 0 0;
  padding: 14rpx;
  display: flex;
  justify-content: space-around;
}

.tabs .active {
  color: #c53030;
  border-bottom: 5rpx solid #c53030;
}

.content {
  margin: 0 12rpx;
  display: flex;
  background: #fff;
}

.left {
  width: 180rpx;
  padding: 10rpx;
}

.left text {
  display: block;
  padding: 14rpx 8rpx;
  color: #777;
}

.right {
  flex: 1;
  border-left: 1rpx solid #f0f0f0;
  padding: 10rpx;
}

.item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.item image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 10rpx;
}

.item .info {
  flex: 1;
  margin-left: 10rpx;
}

.item .name {
  display: block;
  font-size: 30rpx;
}

.item .sold {
  display: block;
  color: #999;
  margin-top: 4rpx;
}

.price {
  display: block;
  margin-top: 6rpx;
  color: #d86a2a;
  font-size: 34rpx;
}

.old {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
}

.add {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #d82020;
  color: #fff;
  text-align: center;
  line-height: 56rpx;
  font-size: 38rpx;
}

.nomore {
  display: block;
  text-align: center;
  color: #9a9a9a;
  margin: 20rpx 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 10rpx 12rpx;
  gap: 10rpx;
}

.cart {
  width: 86rpx;
  text-align: center;
  font-size: 34rpx;
}

.total {
  flex: 1;
}

.money {
  display: block;
  color: #c52a2a;
  font-size: 30rpx;
}

.desc {
  display: block;
  color: #999;
  font-size: 20rpx;
}

.settle {
  width: 160rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  color: #fff;
  background: #d92020;
  border-radius: 16rpx;
}
