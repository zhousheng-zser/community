.container{
  background:#fff;
  min-height:100vh;
  padding-bottom: 200rpx;
}

.mock-banner {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #92400e;
  background: #fef3c7;
  border-bottom: 1rpx solid #fde68a;
  text-align: center;
}
.card{
  padding:24rpx 20rpx;
  border-bottom:1px solid #f0f0f0;
}
.head{
  background:#fafafa;
}
.row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14rpx;
}
.label{
  color:#666;
}
.value{
  color:#111;
  max-width:60%;
  text-align:right;
  word-break:break-all;
}
.sectionTitle{
  display:block;
  margin-bottom:16rpx;
  font-weight:600;
}
.item{
  display:flex;
  padding:18rpx 0;
  border-top:1px solid #f6f6f6;
}
.img{
  width:140rpx;
  height:110rpx;
  border-radius:12rpx;
  margin-right:20rpx;
}
.info{
  flex:1;
}
.name{
  display:block;
  font-size:26rpx;
  line-height:1.3;
}
.line{
  display:flex;
  justify-content:space-between;
  margin-top:10rpx;
}
.muted{
  color:#888;
}
.price{
  color:#FF7A00;
}
.bottomBar{
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  padding:18rpx 20rpx calc(env(safe-area-inset-bottom));
  background:#fff;
  border-top:1px solid #f0f0f0;
  display:flex;
  gap:16rpx;
  align-items:center;
}
.payBtn{
  flex:1;
  background:#07c160;
  color:#fff;
  font-size:30rpx;
}
.cancelBtn{
  flex:1;
  background:#FF7700;
  color:#fff;
  font-size:30rpx;
}
.cancelBtn.ghost{
  background:#fff;
  color:#FF7700;
  border:1px solid #ffccc7;
}

.order-chat-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 9;
  padding: 16rpx 24rpx 12rpx;
  background: #fafafa;
  border-top: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  bottom: env(safe-area-inset-bottom);
}
.order-chat-bar.above-pay {
  bottom: calc(112rpx + env(safe-area-inset-bottom));
}
.chatOrderBtn {
  background: #fff;
  color: #FF7A00;
  border: 1rpx solid #ffb366;
  font-size: 28rpx;
  border-radius: 12rpx;
}
.chatOrderHint {
  font-size: 22rpx;
  color: #888;
  text-align: center;
}

.merch-act-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: space-between;
}

.chatOrderBtn.sm {
  flex: 1;
  min-width: 28%;
  font-size: 26rpx;
  padding: 16rpx 12rpx;
}

.chatOrderBtn.sm.ghost {
  background: #fff;
  color: #0d9488;
  border-color: #99f6e4;
}

