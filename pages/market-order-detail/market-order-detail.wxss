.container {
  padding-bottom: 120rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}
.status-head {
  background: #FF7700;
  padding: 40rpx;
  color: #fff;
}
.st-text {
  font-size: 40rpx;
  font-weight: bold;
}
.card {
  margin: 20rpx;
  border-radius: 12rpx;
  background-color: #fff;
  padding: 30rpx;
}

/* 物流入口 */
.logistics-preview {
  display: flex;
  align-items: center;
}
.log-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}
.log-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.log-desc {
  font-size: 28rpx;
  color: #2b77ff;
  line-height: 40rpx;
  margin-bottom: 10rpx;
  font-weight: bold;
}
.log-time {
  font-size: 24rpx;
  color: #999;
}
.arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* 信息块 */
.sectionTitle {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}
.row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.row:last-child {
  margin-bottom: 0;
}
.label {
  color: #999;
  width: 140rpx;
}
.value {
  color: #333;
  flex: 1;
}
.copy-btn {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #FF7700;
  border: 1rpx solid #FF7700;
  padding: 0 10rpx;
  border-radius: 4rpx;
}

/* 商品卡 */
.shop-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  border-bottom: 1rpx solid #f9f9f9;
  padding-bottom: 20rpx;
}
.shop-title .arrow {
  font-size: 26rpx;
  font-weight: normal;
}
.item {
  display: flex;
  padding: 20rpx 0;
  position: relative;
  align-items: flex-start;
}
.img {
  width: 160rpx;
  height: 160rpx;
  background-color: #eee;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.name {
  font-size: 28rpx;
  color: #333;
  line-height: 40rpx;
  min-height: 80rpx;
}
.line {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}
.price {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}
.muted {
  font-size: 26rpx;
  color: #999;
}
.item-actions {
  position: absolute;
  bottom: 10rpx;
  right: 0;
}
.after-sale-btn {
  background: #fff;
  border: 1rpx solid #ccc;
  color: #666;
  font-size: 24rpx;
  padding: 5rpx 20rpx;
  border-radius: 30rpx;
  line-height: 1.5;
  margin: 0;
}
.after-sale-btn::after {
  content: none;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
}
.fee-row.total {
  margin-top: 30rpx;
  border-top: 1rpx solid #eee;
  padding-top: 20rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
}
.sum-price {
  color: #FF7700;
  font-size: 36rpx;
}

/* 底部功能盘 */
.bottomBar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}
.bottomBar button {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  border-radius: 32rpx;
  margin: 0 0 0 20rpx;
}
.bottomBar button::after {
  content: none;
}
.bottomBar .ghost {
  border: 1rpx solid #ccc;
  color: #333;
  background: #fff;
}
.bottomBar .primary {
  background-color: #FF7700;
  color: #fff;
}
