<view class="container">
  <view class="mock-banner" wx:if="{{isMock}}">演示订单 · 数据为虚构，不请求后端</view>
  <view class="card head">
    <view class="row">
      <text class="label">订单号</text>
      <text class="value">{{orderNo}}</text>
    </view>
    <view class="row">
      <text class="label">订单状态</text>
      <text class="value">{{order_status || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">支付状态</text>
      <text class="value">{{pay_status || '-'}}</text>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <text class="label">应付金额</text>
      <text class="value">￥{{payable_amount || '0.00'}}</text>
    </view>
    <view class="row">
      <text class="label">商品金额</text>
      <text class="value">￥{{goods_amount || '0.00'}}</text>
    </view>
    <view class="row">
      <text class="label">运费</text>
      <text class="value">￥{{delivery_fee || '0.00'}}</text>
    </view>
  </view>

  <view class="card">
    <text class="sectionTitle">收货信息</text>
    <view class="row">
      <text class="label">收货人</text>
      <text class="value">{{receiver_name || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">手机号</text>
      <text class="value">{{receiver_phone || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">地址</text>
      <text class="value">{{receiver_address || '-'}}</text>
    </view>
  </view>

  <view class="card">
    <text class="sectionTitle">订单明细</text>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <image class="img" mode="aspectFill" src="{{itemImage(item)}}"></image>
      <view class="info">
        <text class="name">{{item.goods_name_snapshot || item.goodsNameSnapshot || item.name || '-'}}</text>
        <view class="line">
          <text class="muted">x{{item.quantity}}</text>
          <text class="price">￥{{item.amount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="order-chat-bar merchant-acts {{order_status === 'pending_payment' ? 'above-pay' : ''}}" wx:if="{{isMerchantOrder}}">
    <view class="merch-act-row">
      <button class="chatOrderBtn sm" bindtap="openChatBuyer">联系买家</button>
      <button class="chatOrderBtn sm" bindtap="openChatRider">联系骑手</button>
      <button class="chatOrderBtn sm ghost" bindtap="openRiderMapPage">骑手位置</button>
    </view>
    <text class="chatOrderHint">买卖家 / 骑手会话 · 支持文字与图片</text>
  </view>
  <view class="order-chat-bar {{order_status === 'pending_payment' ? 'above-pay' : ''}}" wx:else>
    <button class="chatOrderBtn" bindtap="openOrderChat">联系商家</button>
    <text class="chatOrderHint">本单专属会话 · 支持文字与图片</text>
  </view>

  <view class="bottomBar" wx:if="{{order_status === 'pending_payment'}}">
    <button class="payBtn" bindtap="payNow">立即支付</button>
    <button class="cancelBtn ghost" bindtap="cancelOrder">取消订单</button>
  </view>
</view>

