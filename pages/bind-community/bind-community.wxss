.page {
  min-height: 100vh;
  background: #f3f4f6;
  padding: 24rpx;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.tip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  display: block;
  margin-bottom: 12rpx;
}
.tip-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: block;
}
.bound-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}
.bound-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}
.bound-value {
  font-size: 28rpx;
  color: #ff7a00;
  font-weight: 600;
}
.section-title {
  font-size: 28rpx;
  color: #333;
  margin: 8rpx 8rpx 16rpx;
}
.loading, .empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 28rpx;
}
.item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.item.active {
  border: 2rpx solid #ff7a00;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  display: block;
}
.addr {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}
.area {
  font-size: 22rpx;
  color: #ff7a00;
  margin-top: 8rpx;
  display: block;
}
.check {
  font-size: 36rpx;
  color: #ff7a00;
  margin-left: 16rpx;
}
