.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 48rpx;
}

.banner {
  background: #fff7ed;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: #333;
  border-bottom: 1rpx solid #ffe4c4;
}

.banner-label {
  color: #666;
}

.banner-value {
  color: #111;
  font-weight: 600;
}

.search-row {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.chevron {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}

.section {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  flex: 1;
}

.section-title.block {
  display: block;
  margin-bottom: 16rpx;
}

.relocate-btn {
  font-size: 26rpx;
  color: #e85d04;
  border: 1rpx solid #e85d04;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}

.loc-address {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.pending {
  margin: 0 24rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.btn-bind {
  background: #ff7a00 !important;
  color: #fff !important;
  border: none !important;
  margin-left: 16rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
}

.bind-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.bind-item:first-of-type {
  border-top: none;
}

.bind-main {
  flex: 1;
  min-width: 0;
}

.bind-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
}

.addr {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.tag-type {
  background: #fff3e0;
  color: #e65100;
}

.tag-active {
  background: #ffebee;
  color: #c62828;
}

.unbind-btn {
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.api-hint {
  font-size: 24rpx;
  color: #e85d04;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #fff7ed;
  border-radius: 8rpx;
}

.hint {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 32rpx 0;
}
