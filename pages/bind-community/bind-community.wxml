<view class="page">
  <view class="banner" wx:if="{{activeName}}">
    <text class="banner-label">已选地址：</text>
    <text class="banner-value">{{activeName}}</text>
  </view>

  <view class="search-row" bindtap="goSearch">
    <icon type="search" size="14" color="#999" />
    <text class="search-placeholder">搜索小区</text>
    <text class="chevron">›</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-icon">📍</text>
      <text class="section-title">当前定位</text>
      <view class="relocate-btn" bindtap="onRelocate">重新定位</view>
    </view>
    <text class="loc-address">{{gpsAddress || '正在获取位置…'}}</text>
  </view>

  <view class="pending card" wx:if="{{pendingCommunity}}">
    <view class="pending-main">
      <text class="name">{{pendingCommunity.name}}</text>
      <text class="addr">{{pendingCommunity.regionPath || pendingCommunity.address}}</text>
    </view>
    <button class="btn-bind" size="mini" bindtap="onBindPending" loading="{{saving}}">绑定</button>
  </view>

  <view class="section">
    <text class="section-title block">绑定地点</text>
    <view wx:if="{{bindingsApiHint}}" class="api-hint">{{bindingsApiHint}}</view>
    <view wx:if="{{loading}}" class="hint">加载中…</view>
    <view wx:elif="{{bindings.length === 0}}" class="hint">暂无绑定，请搜索小区后绑定（最多3个）</view>
    <view
      class="bind-item"
      wx:for="{{bindings}}"
      wx:key="community_id"
      bindtap="onSwitchBinding"
      data-id="{{item.community_id}}"
      data-name="{{item.name}}"
    >
      <view class="bind-main">
        <view class="bind-title-row">
          <text class="name">{{item.name}}</text>
          <text class="tag tag-type">小区</text>
          <text class="tag tag-active" wx:if="{{item.is_active}}">当前选择</text>
        </view>
        <text class="addr" wx:if="{{item.address}}">{{item.address}}</text>
      </view>
      <view
        class="unbind-btn"
        catchtap="onUnbind"
        data-id="{{item.community_id}}"
        data-name="{{item.name}}"
      >解绑</view>
    </view>
  </view>
</view>
