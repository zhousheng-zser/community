<view class="page">
  <view class="tip card">
    <text class="tip-title">绑定所属小区</text>
    <text class="tip-desc">绑定后首页直约、帮帮发布、社区帖将默认按该小区展示。地图选点若在服务范围内，也可自动匹配阳光小区/春风社区。</text>
    <view class="bound-row" wx:if="{{boundId}}">
      <text class="bound-label">当前已绑定</text>
      <text class="bound-value">{{boundName}}</text>
    </view>
  </view>

  <view class="section-title">选择小区</view>
  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{list.length === 0}}" class="empty">暂无可选小区，请联系管理员配置</view>
  <view class="list" wx:else>
    <view
      class="item {{boundId == item.id ? 'active' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onSelectCommunity"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
    >
      <view class="item-main">
        <text class="name">{{item.name}}</text>
        <text class="addr">{{item.address}}</text>
        <text class="area" wx:if="{{item.service_center}}">服务范围：{{item.service_center}} 半径{{item.radius_meters}}米</text>
      </view>
      <text class="check" wx:if="{{boundId == item.id}}">✓</text>
    </view>
  </view>
</view>
