.login-wrapper {
  padding: 80rpx 60rpx;
  min-height: 100vh;
  background-color: #fff;
}
.login-header {
  margin-bottom: 80rpx;
}
.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.subtitle {
  font-size: 28rpx;
  color: #999;
}
.login-tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #eeeeee;
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  color: #666;
  padding: 20rpx 0;
  position: relative;
}
.tab.active {
  color: #000;
  font-weight: bold;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: -1rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #000;
  border-radius: 4rpx;
}
.input-group {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eeeeee;
  padding: 20rpx 0;
  margin-bottom: 40rpx;
}
.sms-btn {
  font-size: 28rpx;
  color: #07c160;
  background: transparent;
  border: none;
  padding: 0 20rpx;
  margin: 0;
  width: auto;
  line-height: inherit;
}
.sms-btn::after {
  display: none;
}
.sms-btn[disabled] {
  color: #999 !important;
  background: transparent !important;
}
.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}
.input-field {
  flex: 1;
  font-size: 32rpx;
}
.primary-btn {
  background-color: #000000;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 60rpx;
}
.wechat-btn {
  background-color: #07c160;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}
.action-row {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}
.action-link {
  font-size: 28rpx;
  color: #666;
}
.guest-wrap {
  margin-top: 80rpx;
  text-align: center;
}
.guest-text {
  font-size: 28rpx;
  color: #FF7700;
  border-bottom: 1rpx solid #FF7700;
}

