<view class="local-live-page">
  <!-- 头部红色年画风背景 -->
  <view class="hero-header" style="padding-top: {{navTopPadding}}px;">
    <view class="back-btn" bindtap="goBack">
      <image class="arrow-img" src="/img/index/menuicon1.png" style="width:40rpx;height:40rpx;opacity:0;"></image>
      <text class="arrow">〈</text>
    </view>
    <view class="right-icon">•••</view>
    <!-- 背景图可以使用伪类或者定位图片呈现，这里用本地色块+图片占位 -->
    <image class="hero-bg" src="https://images.unsplash.com/photo-1543881523-267ec4c0f862?w=800&q=80" mode="aspectFill"></image>
  </view>

  <!-- 搜索和内容悬浮面 -->
  <view class="main-panel">
    <!-- 搜索条 -->
    <view class="search-bar">
      <view class="input-box">
        <icon type="search" size="14" color="#999"/>
        <input placeholder="请输入关键词" placeholder-class="ph-cls" />
      </view>
      <view class="search-btn">搜索</view>
    </view>

    <!-- 分类横向滑动 -->
    <scroll-view scroll-x class="cat-scroll">
      <view class="cat-list">
        <view class="cat-item {{currentTab === item.name ? 'on' : ''}}" wx:for="{{pavilions}}" wx:key="name" data-tab="{{item.name}}" bindtap="switchTab">
          <view class="img-box">
            <image src="{{item.image}}" mode="aspectFill"></image>
          </view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <!-- 指示点 (静态装饰) -->
    <view class="dots">
      <view class="dot active"></view>
      <view class="dot"></view>
    </view>

    <!-- 列表区 -->
    <view class="list">
      <view class="list-item" wx:for="{{filteredList}}" wx:key="id">
        <!-- 上半部商户信息 -->
        <view class="merchant-info">
          <!-- Logo 与闭播状态 -->
          <view class="logo-wrap">
            <image src="{{item.logo}}" mode="aspectFill"></image>
            <view class="live-badge gray" wx:if="{{item.status === 'closed'}}">关闭直播</view>
          </view>
          
          <view class="info">
            <view class="brand-row">
              <text class="region-badge">{{item.region}}</text>
              <text class="brand" style="margin-right:20rpx;">{{item.brand}}</text>
            </view>
            <text class="sub">{{item.sub}}</text>
            <view class="bottom-stats">
              <view class="rebate">最高返 <text>{{item.rebate}}</text></view>
              <view class="promoters">
                <view class="avatar-group"></view>
                <text>{{item.promoters}}人推广</text>
              </view>
            </view>
          </view>

          <!-- 右侧去推广按钮 -->
          <navigator url="/pages/push-live-promo/push-live-promo?id={{item.id}}&status={{item.status}}" class="push-btn">
            去推广
          </navigator>
        </view>

        <!-- 下半部商品带货列表 -->
        <view class="goods-row">
          <view class="goods-item" wx:for="{{item.goods}}" wx:for-item="g" wx:key="name">
            <image src="{{g.img}}" mode="aspectFill"></image>
            <view class="g-price">￥{{g.price}}</view>
            <view class="g-earn">赚/返 ￥{{g.comm}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{filteredList.length === 0}}" class="empty">暂无特产信息</view>
    </view>
  </view>
</view>
