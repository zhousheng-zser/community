page {
  background: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.local-live-page {
  min-height: 100vh;
  position: relative;
}

/* 顶部伪装区域: 返回 + Hero */
.hero-header {
  position: relative;
  height: 480rpx;
  overflow: hidden;
  padding: 10rpx 30rpx 20rpx;
  background: #ffdb17; /* 防止海报没加载的底色 */
}

/* 占据整个头部的绝对定位海报 */
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.back-btn {
  position: absolute;
  left: 30rpx;
  z-index: 10;
  font-size: 40rpx;
  font-weight: 300;
  color: #000;
  display: flex;
  align-items: center;
}

.right-icon {
  position: absolute;
  right: 30rpx;
  z-index: 10;
  background: rgba(255, 255, 255, 0.7);
  padding: 4rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #333;
}


/* 主面板从底部升起 */
.main-panel {
  background: #f7f8fa;
  border-radius: 30rpx 30rpx 0 0;
  margin-top: -60rpx;
  position: relative;
  padding: 30rpx 24rpx 60rpx;
  z-index: 5;
  min-height: 60vh;
}

/* 搜索栏悬浮效果 */
.search-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  position: absolute;
  top: -46rpx;
  left: 30rpx;
  right: 30rpx;
}

.input-box {
  flex: 1;
  background: #fff;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.input-box input {
  flex: 1;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.ph-cls {
  color: #999;
}

.search-btn {
  background: #fe4736;
  color: #fff;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  box-shadow: 0 6rpx 12rpx rgba(254, 71, 54, 0.2);
}

/* 分类横向滑动 */
.cat-scroll {
  margin-top: 50rpx; /* 给搜索框让位 */
  white-space: nowrap;
  padding-bottom: 20rpx;
}

.cat-list {
  display: flex;
  gap: 30rpx;
  padding: 0 10rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.img-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  padding: 4rpx;
  margin-bottom: 12rpx;
}

.cat-item.on .img-box {
  border-color: #ff8c00;
}

.img-box image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #fff;
}

.cat-item text {
  font-size: 24rpx;
  color: #333;
}

.cat-item.on text {
  color: #ff8c00;
  font-weight: 500;
}

/* 指示点 (静态装饰) */
.dots {
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #ddd;
}

.dot.active {
  background: #ff8c00;
}

/* 列表区 */
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-item {
  background: #fff;
  padding: 30rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

/* 上半部商户信息 */
.merchant-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.logo-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.logo-wrap image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid #eee;
}

.logo-wrap .live-badge {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #999;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.merchant-info .info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.region-badge {
  background: #ff4d3d;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  white-space: nowrap;
}

.merchant-info .brand {
  font-size: 30rpx;
  color: #111;
  font-weight: 600;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.merchant-info .sub {
  font-size: 22rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.bottom-stats {
  display: flex;
  align-items: center;
}

.rebate {
  border: 1rpx solid #ffbcba;
  color: #ff4d3d;
  background: #fff0ed;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.promoters {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #999;
}

.avatar-group {
  width: 50rpx;
  height: 20rpx;
  margin-right: 6rpx;
  background: url("https://images.unsplash.com/photo-1511367461989-f85a21fda167?w=100&q=80") no-repeat;
  background-size: cover;
  border-radius: 10rpx; 
}

.push-btn {
  background: #fe4736;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

/* 下半部商品带货列表 */
.goods-row {
  display: flex;
  gap: 20rpx;
}

.goods-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-item image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  margin-bottom: 12rpx;
}

.g-price {
  color: #ff4d3d;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.g-earn {
  color: #ff4d3d;
  font-size: 22rpx;
  opacity: 0.8;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 100rpx;
}
