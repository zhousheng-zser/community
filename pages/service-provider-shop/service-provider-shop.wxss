.sps-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}
.sps-head {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.sps-cover-banner {
  width: 100%;
  height: 280rpx;
  display: block;
}
.sps-head-info {
  padding: 20rpx 24rpx 8rpx;
}
.sps-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}
.sps-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
}
.sps-contact {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.sps-contact-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}
.sps-contact-tel {
  font-size: 24rpx;
  color: #ff6b35;
}
.sps-tip {
  padding: 10rpx 24rpx 16rpx;
  font-size: 22rpx;
  color: #bbb;
}
.sps-loading,
.sps-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.sps-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.sps-group-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.sps-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.sps-line-off {
  opacity: 0.72;
}
.sps-line:first-of-type {
  border-top: none;
}
.sps-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}
.sps-mid {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}
.sps-line-title {
  font-size: 28rpx;
  color: #222;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sps-line-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.sps-line-price {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #e45a2b;
}
.sps-line-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 6rpx;
}
.sps-line-status-off {
  font-size: 20rpx;
  color: #d93025;
  background: #fce8e6;
  border: 1rpx solid #f5c6c2;
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
}
.sps-qty {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.sps-qb {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
  background: #fafafa;
}
.sps-qb-disabled {
  color: #aaa;
  border-color: #e5e5e5;
  background: #f6f6f6;
}
.sps-qn {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
}
.sps-spacer {
  height: 24rpx;
}
.sps-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.sps-total {
  font-size: 30rpx;
  font-weight: 600;
  color: #e45a2b;
}
.sps-go {
  padding: 20rpx 48rpx;
  background: #000000;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

