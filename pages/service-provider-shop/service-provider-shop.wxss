.sps-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}
.sps-head {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.sps-cover-banner {
  width: 100%;
  height: 280rpx;
  display: block;
}
.sps-head-info {
  padding: 20rpx 24rpx 8rpx;
}
.sps-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}
.sps-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #888;
}
.sps-contact {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.sps-contact-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}
.sps-contact-tel {
  font-size: 24rpx;
  color: #ff6b35;
}
.sps-tip {
  padding: 10rpx 24rpx 16rpx;
  font-size: 22rpx;
  color: #bbb;
}
.sps-loading,
.sps-empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.sps-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.sps-group-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.sps-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.sps-line-off {
  opacity: 0.72;
}
.sps-line:first-of-type {
  border-top: none;
}
.sps-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}
.sps-mid {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}
.sps-line-title {
  font-size: 28rpx;
  color: #222;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sps-line-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #888;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.sps-line-price {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #e45a2b;
}
.sps-line-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 6rpx;
}
.sps-line-status-off {
  font-size: 20rpx;
  color: #d93025;
  background: #fce8e6;
  border: 1rpx solid #f5c6c2;
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
}
.sps-qty {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.sps-qb {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #333;
  background: #fafafa;
}
.sps-qb-disabled {
  color: #aaa;
  border-color: #e5e5e5;
  background: #f6f6f6;
}
.sps-qn {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
}
.sps-spacer {
  height: 160rpx;
}
.sps-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0;
  background: #333;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.25);
  overflow: hidden;
}
.sps-bar-left {
  display: flex;
  align-items: center;
  padding-left: 12rpx;
  flex-shrink: 0;
}
.sps-bar-mid {
  flex: 1;
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.sps-bar-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}
.sps-bar-actions {
  display: flex;
  height: 100%;
  flex-shrink: 0;
}
.sps-add-cart {
  width: 160rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  background: #444;
}
.sps-add-cart.active {
  background: #2a2a2a;
  color: #fff;
}
.sps-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.sps-total.empty {
  font-size: 26rpx;
  color: #ccc;
  font-weight: 400;
}
.sps-go {
  width: 150rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #555;
  color: #999;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 0 50rpx 50rpx 0;
}
.sps-go.active {
  background: #000;
  color: #fff;
}
.sps-cart-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #444;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid #333;
}
.sps-cart-icon-wrap.active {
  background: #000;
}
.sps-cart-icon {
  font-size: 36rpx;
}
.sps-cart-dot {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #000;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 700;
}

.sps-fav {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  flex-shrink: 0;
}

.sps-fav-icon {
  font-size: 38rpx;
  color: #999;
  line-height: 1;
}

.sps-fav-text {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.sps-fav-active .sps-fav-icon {
  color: #ff6146;
}

.sps-fav-active .sps-fav-text {
  color: #ff6146;
}

