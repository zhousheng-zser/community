<view class="sps-page">
  <view class="sps-head" wx:if="{{providerName}}">
    <image wx:if="{{providerCover}}" class="sps-cover-banner" src="{{providerCover}}" mode="aspectFill"></image>
    <view class="sps-head-info">
      <text class="sps-title">{{providerName}}</text>
      <text class="sps-sub" wx:if="{{providerDesc}}">{{providerDesc}}</text>
      <view class="sps-contact" wx:if="{{providerPhone}}" bindtap="callProvider">
        <text class="sps-contact-icon">📞</text>
        <text class="sps-contact-tel">{{providerPhone}}</text>
      </view>
    </view>
    <view class="sps-tip">勾选服务加入购物车，可打包下单</view>
  </view>

  <view wx:if="{{loading}}" class="sps-loading">加载中…</view>

  <block wx:else>
    <view wx:for="{{groups}}" wx:for-item="grp" wx:key="group_key" class="sps-group">
      <text class="sps-group-title">{{grp.group_label || grp.group_key}}</text>
      <view class="sps-line {{line.unsupported ? 'sps-line-off' : ''}}" wx:for="{{grp.items}}" wx:for-item="line" wx:key="service_id">
        <image class="sps-cover" src="{{line.cover}}" mode="aspectFill"></image>
        <view class="sps-mid">
          <text class="sps-line-title">{{line.title}}</text>
          <text class="sps-line-sub" wx:if="{{line.sub || line.desc}}">{{line.sub || line.desc}}</text>
          <view class="sps-line-price-row">
            <text class="sps-line-price">￥{{line.priceText}}</text>
            <text class="sps-line-status-off" wx:if="{{line.saleStatusText}}">{{line.saleStatusText}}</text>
          </view>
        </view>
        <view class="sps-qty">
          <view class="sps-qb" data-gk="{{grp.group_key}}" data-sid="{{line.service_id}}" bindtap="decLine">−</view>
          <text class="sps-qn">{{cart[line.cartKey] || 0}}</text>
          <view class="sps-qb {{line.unsupported ? 'sps-qb-disabled' : ''}}" data-gk="{{grp.group_key}}" data-sid="{{line.service_id}}" data-unsupported="{{line.unsupported}}" bindtap="incLine">+</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!groups.length}}" class="sps-empty">暂无服务目录，请稍后再试</view>
  </block>

  <view class="sps-spacer"></view>
</view>

<view class="sps-bar">
  <view class="sps-bar-left">
    <view class="sps-fav {{favorited ? 'sps-fav-active' : ''}}" bindtap="toggleFavorite">
      <text class="sps-fav-icon">{{favorited ? '★' : '☆'}}</text>
      <text class="sps-fav-text">{{favorited ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="sps-cart-icon-wrap {{cartCount > 0 ? 'active' : ''}}">
      <text class="sps-cart-icon">🛒</text>
      <text class="sps-cart-dot" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
    </view>
  </view>
  <view class="sps-bar-mid">
    <text class="sps-total" wx:if="{{cartCount > 0}}">￥{{totalText}}</text>
    <text class="sps-total empty" wx:else>未选购服务</text>
    <text class="sps-bar-desc">直约到家 · 可打包下单</text>
  </view>
  <view class="sps-bar-actions">
    <view class="sps-add-cart {{cartCount > 0 ? 'active' : ''}}" bindtap="goAddToGlobalCart">加入购物车</view>
    <view class="sps-go {{cartCount > 0 ? 'active' : ''}}" bindtap="checkout">去结算</view>
  </view>
</view>
