.rl-page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.rl-head {
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.rl-order {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.rl-rider {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  color: #0d9488;
  font-weight: 600;
}

.rl-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #888;
}

.rl-map {
  flex: 1;
  width: 100%;
  min-height: 600rpx;
}

.rl-foot {
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.rl-btn {
  background: #ff7a00;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
}

.rl-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
}
