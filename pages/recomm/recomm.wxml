<view class="neighbor-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text class="left" bindtap="goBack">〈 📍</text>
    <text class="title">邻里帮帮</text>
    <text class="right">•••</text>
  </view>

  <view class="top-tabs">
    <text class="active">邻里帮帮</text>
    <text bindtap="goServiceList">一键发布</text>
  </view>

  <view class="banner">一键发布 邻里响应</view>

  <scroll-view class="service-tabs" scroll-x="{{true}}">
    <view class="service-row">
      <view
        class="tab-item {{activeServiceTab===item.key ? 'active' : ''}}"
        wx:for="{{serviceTabs}}"
        wx:key="key"
        bindtap="switchServiceTab"
        data-key="{{item.key}}"
      >{{item.text}}</view>
    </view>
  </scroll-view>

  <!-- 表单卡片：直接用 activeTabConfig + currentForm，不做动态key访问 -->
  <view class="form-card">

    <!-- 主地址（取货/服务地址） -->
    <view class="input-item" bindtap="goPickAddr" data-field="from">
      <view class="label-dot blue">{{activeTabConfig.label}}</view>
      <view class="addr-nav-wrap">
        <text class="addr-nav-text {{currentForm.from ? 'has-val' : 'addr-ph'}}">{{currentForm.from || activeTabConfig.placeholder}}</text>
      </view>
      <text class="pick-btn">📍</text>
    </view>

    <!-- 第二地址（仅代取有收货地址） -->
    <view class="input-item" wx:if="{{activeTabConfig.secondLabel}}" bindtap="goPickAddr" data-field="to">
      <view class="label-dot green">{{activeTabConfig.secondLabel}}</view>
      <view class="addr-nav-wrap">
        <text class="addr-nav-text {{currentForm.to ? 'has-val' : 'addr-ph'}}">{{currentForm.to || activeTabConfig.secondPlaceholder}}</text>
      </view>
      <text class="pick-btn">📍</text>
    </view>

    <!-- 备注 -->
    <view class="input-item">
      <view class="label-dot gray">备</view>
      <input
        class="addr-field"
        placeholder="补充说明（可选）"
        placeholder-class="addr-ph"
        value="{{currentForm.remark}}"
        bindinput="onAddrInput"
        data-field="remark"
        confirm-type="done"
      />
    </view>

    <view
      class="submit-btn {{currentForm.from && (!activeTabConfig.secondLabel || currentForm.to) ? '' : 'disabled'}}"
      bindtap="doSubmit"
    >去发布</view>
    <text class="steps">填写服务信息 › 支付服务费用 › 技工服务 › 完成</text>
  </view>

  <view class="history-card" wx:if="{{history.length > 0}}">
    <view class="history-item" wx:for="{{history}}" wx:key="text">
      <text class="tag">{{item.tag}}</text>
      <text class="desc">{{item.text}}</text>
    </view>
  </view>

  <view class="month-card-btn" bindtap="goMonthCard">
    <text>开通月卡</text>
    <text class="small">单单立省</text>
  </view>
</view>
