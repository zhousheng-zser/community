<view class="neighbor-page">
  <view class="top-nav" style="padding-top: {{navTopPadding}}px;">
    <text class="left" bindtap="goBack">〈 果壳里的城</text>
    <text class="title">邻里帮帮</text>
    <text class="right">•••</text>
  </view>

  <view class="top-tabs">
    <text class="active">邻里帮帮</text>
    <text bindtap="goServiceList">一键发布</text>
  </view>

  <view class="banner">一键发布 邻里响应</view>

  <scroll-view class="service-tabs" scroll-x="{{true}}">
    <view class="service-row">
      <view class="tab-item {{activeServiceTab===item.key?'active':''}}" wx:for="{{serviceTabs}}" wx:key="key" bindtap="switchServiceTab" data-key="{{item.key}}">
        {{item.text}}
      </view>
    </view>
  </scroll-view>

  <view class="form-card" wx:for="{{serviceTabs}}" wx:key="key" wx:if="{{activeServiceTab===item.key}}">
    <view class="input-item">
      <text class="label">{{item.label}}</text>
      <text class="placeholder">{{item.placeholder}}</text>
      <text class="arrow">〉</text>
    </view>
    <view class="input-item" wx:if="{{item.secondLabel}}">
      <text class="label green">{{item.secondLabel}}</text>
      <text class="placeholder">{{item.secondPlaceholder}}</text>
      <text class="arrow">〉</text>
    </view>
    <view class="submit-btn">去发布</view>
    <text class="steps">填写服务信息>支付服务费用>技工服务>完成</text>
  </view>

  <view class="history-card">
    <view class="history-item" wx:for="{{history}}" wx:key="text">
      <text class="tag">{{item.tag}}</text>
      <text class="desc">{{item.text}}</text>
    </view>
  </view>

  <view class="month-card-btn" bindtap="goMonthCard">
    <text>开通月卡</text>
    <text class="small">单单立省</text>
  </view>
</view>
