<view class="live-list-page">
  <!-- 伪装的一个紫色底色海报区域 -->
  <view class="hero-header" style="padding-top: {{navTopPadding}}px;">
    <view class="back-btn" bindtap="goBack">
      <text class="arrow">〈</text>
    </view>
    <view class="right-icon">•••</view>
    
    <view class="hero-content">
      <text class="hero-title">大量热门直播间</text>
      <view class="hero-desc">分享至好友/朋友圈拿收益！</view>
    </view>
    <view class="hero-bg"></view>
  </view>

  <!-- 内容主体面板 -->
  <view class="main-panel">
    <!-- 搜索条 -->
    <view class="search-bar">
      <view class="input-box">
        <icon type="search" size="14" color="#999"/>
        <input placeholder="请输入关键词" placeholder-class="ph-cls" />
      </view>
      <view class="search-btn">搜索</view>
    </view>

    <!-- 分类标签 -->
    <view class="tabs">
      <view class="tab-item {{currentTab === 'all' ? 'on' : ''}}" data-tab="all" bindtap="switchTab">全部</view>
      <view class="tab-item {{currentTab === 'brand' ? 'on' : ''}}" data-tab="brand" bindtap="switchTab">品牌</view>
      <view class="tab-item {{currentTab === 'expert' ? 'on' : ''}}" data-tab="expert" bindtap="switchTab">达人</view>
    </view>

    <!-- 直播间列表 -->
    <view class="list">
      <view class="list-item" wx:for="{{filteredList}}" wx:key="id">
        <!-- 商家Logo 及状态叠加 -->
        <view class="logo-box">
          <image src="{{item.logo}}" mode="aspectFill"></image>
          <!-- 状态色块变化 -->
          <view wx:if="{{item.status === 'booking'}}" class="status-badge st-booking">预约中</view>
          <view wx:if="{{item.status === 'live'}}" class="status-badge st-live">直播中</view>
          <view wx:if="{{item.status === 'closed'}}" class="status-badge st-closed">已关闭</view>
        </view>
        
        <!-- 详情信息 -->
        <view class="info-box">
          <view class="title">{{item.brand}}</view>
          <view class="sub">{{item.sub}}</view>
          
          <view class="promo-info">
            <view class="rebate-tag">最高返 <text class="perc">{{item.rebate}}</text></view>
            <view class="promoters">
              <!-- 使用伪元素制作假头像组，文字 -->
              <view class="avatar-group"></view>
              <text>{{item.promoters}}人推广</text>
            </view>
          </view>
        </view>
        
        <!-- 动作按钮：传入 id 以及自身的状态，以便下一个页面判断 -->
        <navigator url="/pages/push-live-promo/push-live-promo?id={{item.id}}&status={{item.status}}" class="push-btn">
          去推广
        </navigator>
      </view>
      
      <!-- 空状态 -->
      <view wx:if="{{filteredList.length === 0}}" class="empty">暂无相关直播间</view>
    </view>
  </view>
</view>
