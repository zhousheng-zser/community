.pp-page { padding: 32rpx; min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }
.pp-tip { display: block; font-size: 24rpx; color: #888; line-height: 1.5; margin-bottom: 24rpx; }
.pp-list { background: #fff; border-radius: 16rpx; overflow: hidden; }
.pp-item { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; border-bottom: 1rpx solid #eee; font-size: 30rpx; }
.pp-item.on { color: #ff7a00; font-weight: 600; }
.pp-check { color: #ff7a00; }
