<view class="live-promo-page pb-safe">
  <!-- 头部红色渐变背景与导航 -->
  <view class="hero-top" style="padding-top: {{navTopPadding}}px;">
    <view class="back-btn" bindtap="goBack">
      <text class="arrow">〈</text>
    </view>
    <view class="header-title">直播详情</view>
    <view class="right-icon">•••</view>
    
    <!-- 商家头部信息区 -->
    <view class="brand-panel">
      <!-- 商家Logo 及状态叠加 -->
      <view class="logo-box">
        <image src="{{liveInfo.logo}}" mode="aspectFill"></image>
        <view class="status-badge {{status === 'live' ? 'st-live' : (status === 'booking' ? 'st-booking' : 'st-closed')}}">
          {{status === 'live' ? '直播中' : (status === 'booking' ? '预约中' : '关闭直播')}}
        </view>
      </view>
      
      <view class="info-box">
        <view class="name">{{liveInfo.brand}}</view>
        <view class="sub">{{liveInfo.sub}}</view>
        <view class="promo-info">
          <view class="rebate-tag">最高返 <text class="perc">{{liveInfo.rebate}}</text></view>
          <view class="promoters">
            <view class="avatar-group"></view>
            <text>{{liveInfo.promoters}}人推广</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 右侧大号摄影机水印点缀 -->
    <image class="camera-watermark" src="/img/index/menuicon4.png" mode="aspectFit"></image>
  </view>

  <!-- 中间：推广教程面板 -->
  <view class="tutorial-card">
    <view class="t-title">推广教程</view>
    <view class="t-steps">
      <view class="step">1 点击《去直播间》</view>
      <view class="step">2 直播间点击右下角，选择转发给朋友或分享到朋友圈</view>
      <view class="step">3 好友下单，您可拿到对应商品佣金</view>
      <view class="step desc">注：直播结束后下单将无法锁佣金，不在直播期间分享，请直接进入最下方产品详情中，分享产品海报，方能锁佣</view>
    </view>
    <!-- 示意图片区域 -->
    <view class="demo-img-box">
      <!-- 这里用一张宽屏灰底假图代替长图，并加上“点击”提示圈以还原 mockup -->
      <image class="demo-pic" src="/img/placeholders/home_repair.png" mode="widthFix"></image>
      <view class="click-hint">❶ 点击</view>
    </view>
  </view>

  <!-- 底部吸底操作栏 -->
  <view class="bottom-bar">
    <view class="btn share-btn">分享海报</view>
    <view class="btn action-btn {{status === 'live' ? 'btn-live' : (status === 'booking' ? 'btn-booking' : 'btn-closed')}}" bindtap="handlePrimaryAction">
      {{status === 'live' ? '进入直播间' : (status === 'booking' ? '预约直播间' : '直播已关闭')}}
    </view>
  </view>
</view>
