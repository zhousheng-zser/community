<view class="container">
  <view class="header">
    <text class="title">{{groupName}}</text>
    <text class="member-count">{{members.length}}人</text>
  </view>

  <view class="section">
    <view class="section-title">群成员</view>
    <view class="member-list">
      <view class="member-item" wx:for="{{members}}" wx:key="id">
        <image class="member-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
        <text class="member-name">{{item.name}}</text>
        <text class="member-role" wx:if="{{item.role === 'owner'}}">群主</text>
        <text class="member-role admin" wx:elif="{{item.role === 'admin'}}">管理员</text>
        <button class="remove-btn" wx:if="{{item.role === 'member'}}" bindtap="removeMember" data-id="{{item.id}}">移除</button>
      </view>
    </view>
  </view>

  <view class="section">
    <button class="action-btn add-btn" bindtap="showAddMember">+ 添加成员</button>
    <button class="action-btn quit-btn" bindtap="quitGroup">退出群聊</button>
    <button class="action-btn dismiss-btn" bindtap="dismissGroup">解散群聊</button>
  </view>
</view>
