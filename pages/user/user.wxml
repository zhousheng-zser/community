<!--pages/user/user.wxml-->
<view class="mine-page">
  <view class="mine-top-bg"></view>

  <view class="profile-card">
    <view class="profile-main">
      <navigator url="../user-edit/user-edit">
        <image class="avatar" src="{{user.userPhoto || '/img/head.jpg'}}" mode="aspectFill"></image>
      </navigator>
      <view class="base-info">
        <text class="name">{{user.userName || '微信用户'}}</text>
        <text class="mobile">{{user.tel || ''}}</text>
      </view>
      <navigator class="code-btn" url="../user-code/user-code">
        <image src="/img/user/user-code.png"></image>
      </navigator>
    </view>

    <view class="profile-stats">
      <view class="stat-item">
        <text class="num">{{points}}</text>
        <text class="label">家事积分</text>
      </view>
      <navigator class="stat-item" url="../coupons-my/coupons-my">
        <text class="num">{{couponCount}}</text>
        <text class="label">新服务优惠券</text>
      </navigator>
      <navigator class="stat-item" url="../coupons-my/coupons-my">
        <text class="num">{{couponCount}}</text>
        <text class="label">新零售优惠券</text>
      </navigator>
    </view>
  </view>

  <navigator class="income-card" url="../account/account">
    <view class="income-left">
      <view class="income-icon-wrap">
        <image class="income-icon" src="/img/user/user-2-1.png"></image>
      </view>
      <text>我的收益</text>
    </view>
    <view class="income-right">
      <text class="money">￥{{account.totalAcount || 0}}</text>
      <text class="sub">可提取 ></text>
    </view>
  </navigator>

  <view class="card">
    <text class="card-title">我的订单</text>
    <view class="menu-grid">
      <block wx:for="{{orderMenus}}" wx:key="name">
        <navigator wx:if="{{item.url}}" class="menu-item" url="{{item.url}}">
          <view class="menu-icon-wrap" style="background: {{item.iconBg}};">
            <image class="menu-icon" src="{{item.icon}}"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </navigator>
        <view wx:else class="menu-item">
          <view class="menu-icon-wrap" style="background: {{item.iconBg}};">
            <image class="menu-icon" src="{{item.icon}}"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <text class="card-title">我的社区</text>
    <view class="menu-grid">
      <block wx:for="{{communityMenus}}" wx:key="name">
        <view class="menu-item">
          <view class="menu-icon-wrap" style="background: {{item.iconBg}};">
            <image class="menu-icon" src="{{item.icon}}"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <text class="card-title">加入家事速配</text>
    <view class="join-grid">
      <block wx:for="{{joinMenus}}" wx:key="name">
        <view class="join-item">
          <view class="menu-icon-wrap join-icon-wrap" style="background: {{item.iconBg}};">
            <image class="menu-icon" src="{{item.icon}}"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
          <text class="join-sub">{{item.sub}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <text class="card-title">其他服务</text>
    <view class="menu-grid">
      <block wx:for="{{serviceMenus}}" wx:key="name">
        <view class="menu-item">
          <view class="menu-icon-wrap" style="background: {{item.iconBg}};">
            <image class="menu-icon" src="{{item.icon}}"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>
</view>
