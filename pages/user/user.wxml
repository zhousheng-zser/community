<!--pages/user/user.wxml-->
<view class="mine-page">

  <view class="mine-header" style="padding-top: {{navTop}}px;">
    <view class="header-row">
      <navigator url="{{loggedIn ? '../user-edit/user-edit' : '../login/login'}}" class="avatar-wrap">
        <image class="avatar" src="{{user.userPhoto || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80'}}" mode="aspectFill"></image>
        <view class="avatar-edit">{{loggedIn ? '编辑' : '登录'}}</view>
      </navigator>
      <view class="header-info" bindtap="goToLogin">
        <text class="header-name">{{loggedIn ? (user.userName || '微信用户') : '点击登录/注册'}}</text>
        <text class="header-mobile">{{loggedIn ? (user.tel || '点击完善信息') : '登录后享受更多特权'}}</text>
        <view class="role-badge" wx:if="{{loggedIn}}">{{roleLabel}}</view>
      </view>
      <navigator class="qr-btn" url="../user-code/user-code">
        <view class="qr-icon-wrap">
          <image class="qr-icon-img" src="/img/icon-qrcode.png" mode="aspectFit"></image>
        </view>
        <text class="qr-text">邀请码</text>
      </navigator>
    </view>

    <view class="header-stats">
      <view class="hstat">
        <view class="hstat-icon-wrap">
          <image class="hstat-icon-img" src="/img/home_icons2/points.png" mode="aspectFit"></image>
        </view>
        <text class="hstat-num">{{points}}</text>
        <text class="hstat-label">积分</text>
      </view>
      <view class="hstat-divider"></view>
      <navigator class="hstat" url="../coupons-my/coupons-my">
        <view class="hstat-icon-wrap">
          <image class="hstat-icon-img" src="/img/home_icons2/coupon.png" mode="aspectFit"></image>
        </view>
        <text class="hstat-num">{{couponCount}}</text>
        <text class="hstat-label">优惠券</text>
      </navigator>
      <view class="hstat-divider"></view>
      <view class="hstat">
        <view class="hstat-icon-wrap">
          <image class="hstat-icon-img" src="/img/market_icons/star.png" mode="aspectFit"></image>
        </view>
        <text class="hstat-num">0</text>
        <text class="hstat-label">收藏</text>
      </view>
      <view class="hstat-divider"></view>
      <view class="hstat">
        <view class="hstat-icon-wrap">
          <image class="hstat-icon-img" src="/img/home_icons2/pickup.png" mode="aspectFit"></image>
        </view>
        <text class="hstat-num">0</text>
        <text class="hstat-label">足迹</text>
      </view>
    </view>
  </view>

  <navigator class="wallet-card" url="../account/account">
    <view class="wallet-left">
      <view class="wallet-icon-bg">
        <image class="wallet-icon-img" src="/img/local_goods_icons/money.png" mode="aspectFit"></image>
      </view>
      <view class="wallet-text">
        <text class="wallet-label">可提现余额</text>
        <text class="wallet-sub">推客收益 · 实时结算</text>
      </view>
    </view>
    <view class="wallet-right">
      <text class="wallet-money">￥{{balance}}</text>
      <view class="wallet-withdraw-btn">去提现 ›</view>
    </view>
  </navigator>

  <view class="card" wx:if="{{loggedIn}}">
    <view class="card-head" bindtap="toggleWorkbench">
      <view class="workbench-head-left">
        <text class="card-title">工作台</text>
        <text class="card-more muted">技工 / 服务商 / 集市商家</text>
      </view>
      <text class="collapse-arrow {{workbenchCollapsed ? '' : 'expanded'}}">▶</text>
    </view>
    <view class="portal-grid {{workbenchCollapsed ? 'collapsed' : ''}}">
      <view class="portal-item" bindtap="goWorkerPortal">
        <view class="portal-icon-wrap worker-tone">
          <image class="portal-icon-img" src="/img/join_services/worker_join.png" mode="aspectFit"></image>
        </view>
        <text class="portal-name">技工工作台</text>
        <text class="portal-sub">接单与服务</text>
      </view>
      <view class="portal-item" bindtap="goServiceProviderPortal">
        <view class="portal-icon-wrap merchant-tone">
          <image class="portal-icon-img" src="/img/join_services/service_provider.png" mode="aspectFit"></image>
        </view>
        <text class="portal-name">服务商工作台</text>
        <text class="portal-sub">直约到家与店铺</text>
      </view>
      <view class="portal-item" bindtap="goMarketPortal">
        <view class="portal-icon-wrap market-tone">
          <image class="portal-icon-img" src="/img/market_icons/supermarket.png" mode="aspectFit"></image>
        </view>
        <text class="portal-name">集市商家工作台</text>
        <text class="portal-sub">集市商品与订单</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">我的订单</text>
      <navigator class="card-more" url="../service-orders-my/service-orders-my">全部订单 ›</navigator>
    </view>
    <view class="menu-grid">
      <block wx:for="{{orderMenus}}" wx:key="name">
        <navigator wx:if="{{item.url}}" class="menu-item" url="{{item.url}}">
          <view class="menu-icon-wrap">
            <image class="menu-icon-img" src="/img/my_orders/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </navigator>
        <view wx:else class="menu-item" bindtap="showToastWait">
          <view class="menu-icon-wrap">
            <image class="menu-icon-img" src="/img/my_orders/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">我的社区</text>
    </view>
    <view class="list-menu">
      <block wx:for="{{communityMenus}}" wx:key="name">
        <navigator wx:if="{{item.url}}" class="list-item" url="{{item.url}}">
          <view class="list-icon-wrap">
            <image class="list-icon-img" src="/img/my_community/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="list-name">{{item.name}}</text>
          <text class="list-arrow">›</text>
        </navigator>
        <view wx:else class="list-item" bindtap="showToastWait">
          <view class="list-icon-wrap">
            <image class="list-icon-img" src="/img/my_community/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="list-name">{{item.name}}</text>
          <text class="list-arrow">›</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 加入九州社区 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">加入九州社区</text>
    </view>
    <view class="join-grid">
      <block wx:for="{{joinMenus}}" wx:key="name">
        <navigator wx:if="{{item.url}}" class="join-item" url="{{item.url}}">
          <view class="join-icon-wrap">
            <image class="join-icon-img" src="/img/join_services/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="join-name">{{item.name}}</text>
          <text class="join-sub">{{item.sub}}</text>
        </navigator>
        <view wx:else class="join-item" bindtap="showToastWait">
          <view class="join-icon-wrap">
            <image class="join-icon-img" src="/img/join_services/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="join-name">{{item.name}}</text>
          <text class="join-sub">{{item.sub}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">其他服务</text>
    </view>
    <view class="list-menu">
      <block wx:for="{{serviceMenus}}" wx:key="name">
        <navigator wx:if="{{item.url}}" class="list-item" url="{{item.url}}">
          <view class="list-icon-wrap">
            <image class="list-icon-img" src="/img/other_services/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="list-name">{{item.name}}</text>
          <text class="list-arrow">›</text>
        </navigator>
        <view wx:else class="list-item" bindtap="showToastWait">
          <view class="list-icon-wrap">
            <image class="list-icon-img" src="/img/other_services/{{item.icon}}.png" mode="aspectFit"></image>
          </view>
          <text class="list-name">{{item.name}}</text>
          <text class="list-arrow">›</text>
        </view>
      </block>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
