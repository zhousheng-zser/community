/* pages/user/user.wxss */
page {
  background: #f3f4f6;
}

.mine-page {
  min-height: 100vh;
}

/* ===== 椤堕儴娓愬彉澶撮儴 ===== */
.mine-header {
  background: #000000;
  padding: 24rpx 28rpx 0;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  z-index: 1;
}

.header-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.7);
  background: #f3f3f3;
  display: block;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.header-info {
  flex: 1;
  margin-left: 20rpx;
}

.header-name {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.header-mobile {
  display: block;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.role-badge {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
}

.qr-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.16);
}

.qr-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.scan-btn-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: 16rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,0.15);
}

.scan-icon {
  font-size: 36rpx;
}

.qr-text {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
}

/* Stats 缁熻琛?*/
.bind-community-card {
  margin: 20rpx 28rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.bind-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111;
  display: block;
}
.bind-sub {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  display: block;
}
.bind-arrow {
  font-size: 40rpx;
  color: #ccc;
}

.header-stats {
  display: flex;
  background: transparent;
  padding: 18rpx 0 20rpx;
  margin: 0;
}

.hstat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hstat-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.hstat-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.hstat-icon-wrap--cart {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  overflow: hidden;
}

.hstat-icon-img--cart {
  width: 30rpx;
  height: 30rpx;
}

.hstat-num {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.hstat-label {
  color: rgba(255,255,255,0.85);
  font-size: 20rpx;
  margin-top: 4rpx;
}

.hstat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.4);
  align-self: center;
}

/* ===== 閽卞寘/鏀剁泭鍗?===== */
.wallet-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  margin: -24rpx 24rpx 0;
  position: relative;
  z-index: 2;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,122,0,0.08);
}

.wallet-left {
  display: flex;
  align-items: center;
}

.wallet-icon-bg {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f4f8ff;
  border-radius: 20rpx;
}

.wallet-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.wallet-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.wallet-sub {
  display: block;
  font-size: 20rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.wallet-right {
  text-align: right;
}

.wallet-money {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FF7A00;
}

.wallet-withdraw-btn {
  display: inline-block;
  margin-top: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #000000;
  color: #fff;
  font-size: 22rpx;
}

/* ===== 閫氱敤鍗＄墖 ===== */
.card {
  margin: 16rpx 24rpx 0;
  border-radius: 24rpx;
  background: #fff;
  padding: 18rpx 20rpx 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-more {
  font-size: 22rpx;
  color: #aaa;
}

.card-more.muted {
  color: #9ca3af;
  font-weight: 400;
}

/* ===== 宸ヤ綔鍙板叆鍙ｏ紙鎶€宸?/ 鍟嗗鍒嗗寘锛?==== */
.workbench-head-left {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.collapse-arrow {
  font-size: 24rpx;
  color: #999;
  transition: transform 0.2s;
  margin-left: 12rpx;
}
.collapse-arrow.expanded {
  transform: rotate(90deg);
}
.portal-grid {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
  overflow: hidden;
  transition: max-height 0.3s, opacity 0.3s;
  max-height: 400rpx;
  opacity: 1;
}
.portal-grid.collapsed {
  max-height: 0;
  opacity: 0;
  padding: 0;
}

.portal-item {
  flex: 1;
  background: #fafafa;
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #eef2f7;
}

.portal-item:active {
  opacity: 0.88;
}

.portal-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  margin-bottom: 14rpx;
}

.portal-icon-wrap.steward-tone {
  background: linear-gradient(145deg, #e8f5ef 0%, #d4ede3 100%);
}

.portal-icon-wrap.worker-tone {
  background: #e6f4ff;
}

.portal-icon-wrap.merchant-tone {
  background: #fff4e6;
}

.portal-icon-wrap.market-tone {
  background: #dcfce7;
}

.portal-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.portal-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}

.portal-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #888;
}

/* ===== 鍥炬爣缃戞牸锛堣鍗曞尯锛?===== */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 10rpx;
}

.menu-item {
  width: 20%;
  text-align: center;
  margin-bottom: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f8ff;
  border-radius: 28rpx;
}

.menu-icon-img {
  width: 60rpx;
  height: 60rpx;
}

.menu-name {
  display: block;
  margin-top: 10rpx;
  color: #333;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

/* ===== 鍒楄〃鑿滃崟锛堢ぞ鍖?/ 鍏朵粬鏈嶅姟锛?===== */
.list-menu {
  margin-top: 8rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 20rpx 6rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f4f8ff;
  border-radius: 20rpx;
}

.list-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.list-name {
  flex: 1;
  margin-left: 18rpx;
  font-size: 28rpx;
  color: #222;
}

.list-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

/* ===== 鍔犲叆鍗＄墖 ===== */
.join-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 0 8rpx;
}

.join-item {
  flex: 1;
  min-width: calc(50% - 12rpx);
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid #eef5ff;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(255,122,0,0.04);
}

.join-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  background: #f4f8ff;
  border-radius: 24rpx;
}

.join-icon-wrap.steward-join-tone {
  background: #fff4eb;
}

.join-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.join-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.3;
}

.join-sub {
  display: block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 999rpx;
  color: #777;
  font-size: 18rpx;
}

/* ===== 搴曢儴鍗犱綅 ===== */
.bottom-space {
  height: 130rpx;
}

