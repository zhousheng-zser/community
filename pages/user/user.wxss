/* pages/user/user.wxss */
page {
  background: #f3f4f6;
}

.mine-page {
  min-height: 100vh;
}

/* ===== 顶部渐变头部 ===== */
.mine-header {
  background: linear-gradient(180deg, #FF7A00 0%, #FF9E3D 100%);
  padding: 24rpx 28rpx 0;
  border-radius: 0 0 40rpx 40rpx;
  position: relative;
  z-index: 1;
}

.header-row {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.7);
  background: #f3f3f3;
  display: block;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.45);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.header-info {
  flex: 1;
  margin-left: 20rpx;
}

.header-name {
  display: block;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
}

.header-mobile {
  display: block;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.role-badge {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.4);
}

.qr-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.16);
}

.qr-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.qr-text {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255,255,255,0.9);
}

/* Stats 统计行 */
.header-stats {
  display: flex;
  background: transparent;
  padding: 18rpx 0 20rpx;
  margin: 0;
}

.hstat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hstat-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.hstat-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.hstat-num {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.hstat-label {
  color: rgba(255,255,255,0.85);
  font-size: 20rpx;
  margin-top: 4rpx;
}

.hstat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.4);
  align-self: center;
}

/* ===== 钱包/收益卡 ===== */
.wallet-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  margin: -24rpx 24rpx 0;
  position: relative;
  z-index: 2;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255,122,0,0.08);
}

.wallet-left {
  display: flex;
  align-items: center;
}

.wallet-icon-bg {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f4f8ff;
  border-radius: 20rpx;
}

.wallet-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.wallet-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.wallet-sub {
  display: block;
  font-size: 20rpx;
  color: #aaa;
  margin-top: 4rpx;
}

.wallet-right {
  text-align: right;
}

.wallet-money {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FF7A00;
}

.wallet-withdraw-btn {
  display: inline-block;
  margin-top: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #FF7A00, #FFA033);
  color: #fff;
  font-size: 22rpx;
}

/* ===== 通用卡片 ===== */
.card {
  margin: 16rpx 24rpx 0;
  border-radius: 24rpx;
  background: #fff;
  padding: 18rpx 20rpx 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.card-more {
  font-size: 22rpx;
  color: #aaa;
}

.card-more.muted {
  color: #9ca3af;
  font-weight: 400;
}

/* ===== 工作台入口（技工 / 商家分包）===== */
.portal-grid {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.portal-item {
  flex: 1;
  background: #fafafa;
  border-radius: 16rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #eef2f7;
}

.portal-item:active {
  opacity: 0.88;
}

.portal-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  margin-bottom: 14rpx;
}

.portal-icon-wrap.worker-tone {
  background: #e6f4ff;
}

.portal-icon-wrap.merchant-tone {
  background: #fff4e6;
}

.portal-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.portal-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}

.portal-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #888;
}

/* ===== 图标网格（订单区） ===== */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding-top: 10rpx;
}

.menu-item {
  width: 20%;
  text-align: center;
  margin-bottom: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f4f8ff;
  border-radius: 28rpx;
}

.menu-icon-img {
  width: 60rpx;
  height: 60rpx;
}

.menu-name {
  display: block;
  margin-top: 10rpx;
  color: #333;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

/* ===== 列表菜单（社区 / 其他服务） ===== */
.list-menu {
  margin-top: 8rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 20rpx 6rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon-wrap {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f4f8ff;
  border-radius: 20rpx;
}

.list-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.list-name {
  flex: 1;
  margin-left: 18rpx;
  font-size: 28rpx;
  color: #222;
}

.list-arrow {
  font-size: 32rpx;
  color: #ccc;
  font-weight: 300;
}

/* ===== 加入卡片 ===== */
.join-grid {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0 8rpx;
}

.join-item {
  flex: 1;
  background: #fff;
  border: 1rpx solid #eef5ff;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(255,122,0,0.04);
}

.join-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  background: #f4f8ff;
  border-radius: 24rpx;
}

.join-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.join-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.3;
}

.join-sub {
  display: block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 999rpx;
  color: #777;
  font-size: 18rpx;
}

/* ===== 底部占位 ===== */
.bottom-space {
  height: 130rpx;
}
