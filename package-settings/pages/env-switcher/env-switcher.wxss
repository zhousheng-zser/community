page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }
.env-page { padding: 24rpx; }
.env-header { background: #fff; border-radius: 16rpx; padding: 32rpx 24rpx; margin-bottom: 24rpx; }
.env-title { font-size: 36rpx; font-weight: 700; color: #333; display: block; margin-bottom: 8rpx; }
.env-current { font-size: 26rpx; color: #999; }
.env-list { background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.env-item { padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.env-item:last-child { border-bottom: none; }
.env-item.active { background: #fef9f0; }
.item-main { display: flex; align-items: center; justify-content: space-between; }
.item-info { flex: 1; }
.item-label { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 8rpx; }
.item-desc { font-size: 24rpx; color: #999; }
.item-radio { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid #ccc; display: flex; align-items: center; justify-content: center; }
.item-radio.checked { border-color: #6b4f2a; background: #6b4f2a; }
.radio-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #fff; }
.env-tips { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.tip-title { font-size: 28rpx; font-weight: 600; color: #333; display: block; margin-bottom: 16rpx; }
.tip-text { font-size: 24rpx; color: #666; display: block; line-height: 1.6; margin-bottom: 8rpx; }
.env-back-btn { text-align: center; padding: 20rpx; font-size: 26rpx; color: #999; }
