<view class="settings-page">
  <view class="settings-group">
    <navigator class="row" url="../user-edit/user-edit">
      <text class="row-label">修改资料</text><text class="arrow">›</text>
    </navigator>
    <view class="row" bindtap="changePwd"><text class="row-label">修改密码</text><text class="arrow">›</text></view>
    <view class="row" bindtap="changePhone"><text class="row-label">修改绑定手机号</text><text class="row-value">{{maskedPhone}}</text><text class="arrow">›</text></view>
    <navigator class="row" url="../privacy-publish/privacy-publish">
      <text class="row-label">谁可以看我的发布</text><text class="arrow">›</text>
    </navigator>
    <navigator class="row" url="../privacy-reply/privacy-reply">
      <text class="row-label">谁可以看我的回复</text><text class="arrow">›</text>
    </navigator>
    <navigator class="row" url="../notification-settings/notification-settings">
      <text class="row-label">通知设置</text><text class="arrow">›</text>
    </navigator>
    <view class="row" bindtap="checkUpdate"><text class="row-label">检查更新</text><text class="arrow">›</text></view>
    <view class="row" bindtap="aboutUs"><text class="row-label">关于九州社区</text><text class="row-value">2.0.1</text><text class="arrow">›</text></view>
    <navigator class="row" url="../consumer-rights/consumer-rights">
      <text class="row-label">消费者权益保障措施说明</text><text class="arrow">›</text>
    </navigator>
    <view class="row" bindtap="cancelAccount"><text class="row-label cancel-text">注销账号</text><text class="arrow">›</text></view>
  </view>
  <view class="logout-area">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>
