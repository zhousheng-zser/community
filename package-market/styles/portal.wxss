/* 集市商家端 · 工作台通用样式 */

page {
  background: #f0fdf4;
}

.portal-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #dcfce7 0%, #f0fdf4 16%, #f0fdf4 100%);
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.portal-top {
  padding: 36rpx 32rpx 44rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.portal-top::after {
  content: '';
  position: absolute;
  right: -50rpx;
  top: -30rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.market-gradient {
  background: linear-gradient(135deg, #166534 0%, #15803d 42%, #22c55e 100%);
  box-shadow: 0 12rpx 40rpx rgba(22, 101, 52, 0.38);
}

.portal-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.portal-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  opacity: 0.95;
  position: relative;
  z-index: 1;
  line-height: 1.45;
}

.portal-banner {
  margin: 20rpx 28rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.55;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.banner-warn {
  background: linear-gradient(180deg, #fffbeb 0%, #fef3c7 100%);
  color: #92400e;
  border: 1rpx solid #fcd34d;
}

.banner-ok {
  background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%);
  color: #166534;
  border: 1rpx solid #bbf7d0;
}

.portal-card {
  margin: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 8rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  padding: 24rpx 20rpx 12rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #15803d, #22c55e);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.grid-2 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 16rpx 20rpx;
}

.grid-btn {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 24rpx 28rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f0fdf4 0%, #ecfdf5 100%);
  text-align: left;
  border: 1rpx solid #d1fae5;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.grid-btn:active {
  transform: scale(0.99);
  opacity: 0.96;
}

.grid-btn-icon {
  width: 120rpx;
  min-width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.grid-btn-icon image {
  width: 76rpx;
  height: 76rpx;
}

.grid-btn-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.grid-btn-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.grid-btn-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4d7c5f;
  line-height: 1.4;
}

.grid-btn-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 32rpx;
  color: #86efac;
  font-weight: 300;
  line-height: 1;
}

.back-user {
  margin: 8rpx 28rpx 8rpx;
  padding: 24rpx 28rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #fff;
  color: #15803d;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 20rpx rgba(21, 128, 61, 0.14);
  border: 1rpx solid #bbf7d0;
}

.back-user:active {
  opacity: 0.92;
}

.portal-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e8ecf1;
  z-index: 100;
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.06);
}

.pt-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.pt-item.pt-on {
  color: #15803d;
  font-weight: 700;
}

.pt-ico {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}
