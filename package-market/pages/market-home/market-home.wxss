@import "../../styles/portal.wxss";

.mk-hero {
  padding-top: 28rpx;
}

.mk-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  position: relative;
  z-index: 1;
}

.mk-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.15);
}

.mk-text {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.mk-greet {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.mk-sub {
  margin-top: 8rpx !important;
}

.mk-title {
  font-size: 36rpx !important;
  position: relative;
  z-index: 1;
}

.mk-stat {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 28rpx 0;
  padding: 24rpx 16rpx;
  background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 36rpx rgba(22, 101, 52, 0.1);
  border: 1rpx solid #bbf7d0;
  gap: 16rpx 0;
}

.mk-stat-item {
  width: 50%;
  text-align: center;
  padding: 12rpx 0;
}

.mk-stat-item.warn .mk-stat-num {
  color: #dc2626;
}

.mk-stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #15803d;
}

.mk-stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4d7c5f;
}

.mk-section {
  margin-top: 8rpx;
}

.mk-create-row {
  display: flex;
  justify-content: flex-end;
  padding: 6rpx 14rpx 10rpx;
}

.mk-create-btn {
  margin: 0;
  font-size: 24rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
  border: 1rpx solid #15803d;
}

.mk-link-list {
  padding: 0 8rpx 16rpx;
}

.mk-link-item {
  display: flex;
  align-items: center;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(180deg, #f0fdf4 0%, #ecfdf5 100%);
  border: 1rpx solid #d1fae5;
}

.mk-link-item:active {
  opacity: 0.9;
}

.mk-link-ico {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.mk-link-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.mk-link-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #166534;
  line-height: 1.4;
}

.mk-link-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4d7c5f;
  line-height: 1.55;
}

.mk-link-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: #86efac;
  font-weight: 300;
  margin-left: 12rpx;
}
