page {
  background: #e9e9f1;
}

.detail-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading-tip {
  padding: 80rpx 0;
  text-align: center;
  color: #888;
  font-size: 28rpx;
}

.error-tip {
  padding: 80rpx 40rpx;
  line-height: 1.6;
  color: #666;
}

.post-card {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.time {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.category-tag {
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff4eb;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.post-content {
  margin-top: 24rpx;
}

.content-text {
  font-size: 32rpx;
  line-height: 1.65;
  color: #333;
  white-space: pre-wrap;
}

.location {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.image-gallery {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.post-image {
  width: 210rpx;
  height: 210rpx;
  border-radius: 12rpx;
}

.post-image.single {
  width: 100%;
  height: 360rpx;
}

.stats-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: #888;
}

.comment-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.empty-comment {
  font-size: 26rpx;
  color: #aaa;
  padding: 20rpx 0;
}

.comment-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.c-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.c-body {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.c-name {
  font-size: 26rpx;
  color: #666;
}

.c-text {
  font-size: 28rpx;
  color: #333;
  margin-top: 8rpx;
  line-height: 1.5;
}

.c-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.like-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #666;
  margin-right: 20rpx;
  min-width: 64rpx;
}

.like-btn.active {
  color: #ff4757;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f7;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #fff;
  background: #ccc;
}

.send-btn.active {
  background: linear-gradient(135deg, #ff8a4c, #ff5e3a);
}
