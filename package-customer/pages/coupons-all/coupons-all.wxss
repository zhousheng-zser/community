/* pages/coupons-all/coupons-all.wxss — 紧凑券卡片 */

page {
  background-color: #f5f5f5;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.loading-tip,
.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 48rpx 0;
}

.item {
  display: flex;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  min-height: 120rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.item.yellow {
  background: linear-gradient(135deg, #fff3c4 0%, #ffc107 45%, #ff9800 100%);
}

.item.red {
  background: linear-gradient(135deg, #ffcdd2 0%, #ef5350 50%, #c62828 100%);
}

.item .left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 16rpx 16rpx 16rpx 20rpx;
  color: #fff;
  min-width: 0;
}

.row1 {
  display: flex;
  align-items: baseline;
}

.item .icon {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: rgba(255, 255, 255, 0.35);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
}

.money {
  font-size: 52rpx;
  line-height: 1;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.name {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.98);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
  line-height: 1.3;
}

.item .right {
  flex: 0 0 72rpx;
  width: 72rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 2rpx dashed rgba(0, 0, 0, 0.08);
}

.item .btn {
  width: 100%;
  min-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1.3;
}

.item .btn.disabled {
  opacity: 0.65;
}

.item.yellow .btn-inner {
  color: #e65100;
}

.item.red .btn-inner {
  color: #c62828;
}

.item .btn.disabled .btn-inner {
  color: #999;
}

.btn-inner {
  font-size: 24rpx;
  font-weight: 600;
  writing-mode: vertical-rl;
  letter-spacing: 4rpx;
}
