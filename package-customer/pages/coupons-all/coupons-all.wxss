/* pages/coupons-all/coupons-all.wxss — 无内嵌大图，满足单资源 ≤200KB */

page {
  background-color: #f5f5f5;
  padding: 30rpx;
  box-sizing: border-box;
}

.item {
  display: flex;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  min-height: 200rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.item.yellow {
  background: linear-gradient(135deg, #fff3c4 0%, #ffc107 45%, #ff9800 100%);
}

.item.red {
  background: linear-gradient(135deg, #ffcdd2 0%, #ef5350 50%, #c62828 100%);
}

.item .left {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 32rpx 24rpx 32rpx 28rpx;
  color: #fff;
  min-width: 0;
}

.row1 {
  display: flex;
  align-items: center;
}

.item .icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.35);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.money {
  font-size: 120rpx;
  line-height: 1;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.name {
  font-size: 44rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.98);
  margin-top: 16rpx;
}

.time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.item .right {
  flex: 0 0 96rpx;
  width: 96rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 2rpx dashed rgba(0, 0, 0, 0.08);
}

.item .btn {
  width: 100%;
  min-height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1.4;
}

.item.yellow .btn-inner {
  color: #e65100;
}

.item.red .btn-inner {
  color: #c62828;
}

.btn-inner {
  font-size: 28rpx;
  font-weight: 600;
  writing-mode: vertical-rl;
  letter-spacing: 6rpx;
}
