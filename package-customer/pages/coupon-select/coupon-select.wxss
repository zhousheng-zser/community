.page { min-height: 100vh; background: #f5f5f5; padding: 24rpx 24rpx 200rpx; box-sizing: border-box; }
.tip { text-align: center; color: #999; padding: 80rpx 0; font-size: 28rpx; }
.item {
  display: flex; align-items: center; background: #fff; border-radius: 16rpx;
  margin-bottom: 20rpx; padding: 28rpx 24rpx; border: 2rpx solid transparent;
}
.item.on { border-color: #e8a000; background: #fffbf0; }
.left { width: 160rpx; text-align: center; flex-shrink: 0; }
.money { display: block; font-size: 44rpx; font-weight: 700; color: #e74c3c; }
.cond { font-size: 22rpx; color: #999; }
.right { flex: 1; min-width: 0; padding: 0 16rpx; }
.name { display: block; font-size: 30rpx; color: #333; font-weight: 600; }
.sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.check { font-size: 36rpx; color: #e8a000; width: 48rpx; text-align: center; }
.foot {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; display: flex; gap: 20rpx; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06);
}
.btn { flex: 1; background: #e8a000; color: #fff; font-size: 30rpx; border-radius: 44rpx; }
.btn.ghost { background: #f5f5f5; color: #666; }
