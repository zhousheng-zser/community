/* pages/coupons-my/coupons-my.wxss — 无内嵌大图，满足单资源 ≤200KB */

page {
  background-color: #f5f5f5;
  padding: 30rpx;
  box-sizing: border-box;
}

.item {
  display: flex;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  min-height: 200rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.item.yellow {
  background: linear-gradient(135deg, #fff3c4 0%, #ffc107 45%, #ff9800 100%);
}

.item.red {
  background: linear-gradient(135deg, #ffcdd2 0%, #ef5350 50%, #c62828 100%);
}

.left {
  flex: 0 0 300rpx;
  width: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  color: #fff;
}

.item .icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.35);
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
}

.right {
  flex: 1;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 28rpx 24rpx;
  border-left: 2rpx dashed rgba(0, 0, 0, 0.08);
  min-width: 0;
}

.time {
  color: #888;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.btn {
  color: #ff9800;
  padding: 12rpx 24rpx;
  border: 2rpx solid #ff9800;
  border-radius: 32rpx;
  display: inline-block;
  margin-top: 20rpx;
  font-size: 26rpx;
  text-align: center;
  align-self: flex-start;
  background: #fff;
}

.btn.grey {
  color: #999;
  border-color: #ccc;
  background: #f5f5f5;
}

.money {
  font-size: 120rpx;
  line-height: 1;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}
