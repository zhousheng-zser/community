.container {
  background: #f5f5f5;
  min-height: 100vh;
}

/* Tab 鏍?*/
.tab-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  position: relative;
}

.tab-item.active {
  color: #ff7a00;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #000000;
  border-radius: 3rpx;
}

/* 璁板綍鍒楄〃 */
.record-list {
  padding: 20rpx;
}

.record-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-order {
  display: flex;
  flex-direction: column;
}

.order-id {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.order-type {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.record-amount {
  font-weight: bold;
}

.record-amount .amount {
  font-size: 36rpx;
  color: #ff7a00;
}

.record-amount.refunded .amount {
  color: #ff4d4f;
}

.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-meta {
  display: flex;
  gap: 16rpx;
}

.role-tag, .status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  border: 2rpx solid;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

/* 绌虹姸鎬?*/
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

