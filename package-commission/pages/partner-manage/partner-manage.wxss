.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 瑙掕壊鍒楄〃 */
.role-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-badge {
  display: flex;
  align-items: center;
  background: #fff8f0;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 2rpx solid #ff7a00;
}

.role-icon text {
  font-size: 40rpx;
}

.role-info {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.role-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.role-status {
  font-size: 22rpx;
  color: #ff7a00;
  margin-top: 4rpx;
}

.role-status.active {
  color: #52c41a;
}

.no-role {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.btn-apply {
  background: #000000;
  color: #fff;
  margin-top: 20rpx;
  border-radius: 8rpx;
}

/* 涓婃父鍏崇郴 */
.chain-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chain-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

.chain-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}

.chain-avatar image {
  width: 100%;
  height: 100%;
}

.chain-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.chain-role {
  font-size: 22rpx;
  color: #ff7a00;
  margin-top: 4rpx;
}

.chain-empty {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 涓嬬嚎 */
.downline-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.downline-item {
  display: flex;
  align-items: center;
}

.downline-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.downline-info {
  display: flex;
  flex-direction: column;
}

.downline-name {
  font-size: 26rpx;
  color: #333;
}

.downline-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.downline-more {
  text-align: center;
  padding: 16rpx;
  color: #ff7a00;
  font-size: 24rpx;
  border-top: 2rpx solid #f0f0f0;
  margin-top: 8rpx;
}

/* 鎺ㄥ箍宸ュ叿 */
.tool-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tool-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

.tool-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.tool-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.tool-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 璇存槑 */
.notice-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

