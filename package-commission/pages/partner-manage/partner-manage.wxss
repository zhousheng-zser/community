.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.status-tip {
  font-size: 26rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.status-tip.approved {
  background: #f6ffed;
  color: #389e0d;
}

.status-tip.pending {
  background: #fff7e6;
  color: #d46b08;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-label.required::before {
  content: '*';
  color: #e74c3c;
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
}

.form-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
}

.btn-submit {
  margin-top: 12rpx;
  background: #ff7a00;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}

.invite-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 8rpx;
}

.invite-code {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #ff7a00;
  padding: 24rpx 0;
}

.invite-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.invite-actions {
  margin-top: 24rpx;
}

.btn-copy {
  background: #333;
  color: #fff;
  border-radius: 8rpx;
}

.invite-loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
