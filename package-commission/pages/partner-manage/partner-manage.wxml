<view class="container">
  <!-- 申请成为合伙人 -->
  <view class="section">
    <view class="section-title">申请成为合伙人</view>
    <view class="status-tip approved" wx:if="{{isPartner}}">您已是合伙人，可分享邀请码发展好友</view>
    <view class="status-tip pending" wx:elif="{{application && application.status === 'pending'}}">资料已提交，审核中</view>

    <block wx:if="{{!isPartner && (!application || application.status === 'rejected')}}">
      <view class="form-row">
        <text class="form-label required">真实姓名</text>
        <input class="form-input" placeholder="请输入真实姓名" value="{{form.realName}}" bindinput="onInput" data-key="realName" maxlength="20" />
      </view>
      <view class="form-row">
        <text class="form-label required">手机号</text>
        <input class="form-input" type="number" placeholder="请输入手机号" value="{{form.phone}}" bindinput="onInput" data-key="phone" maxlength="11" />
      </view>
      <view class="form-row">
        <text class="form-label required">所在城市</text>
        <input class="form-input" placeholder="如：上海市闵行区" value="{{form.city}}" bindinput="onInput" data-key="city" maxlength="50" />
      </view>
      <view class="form-row">
        <text class="form-label">申请说明</text>
        <textarea class="form-textarea" placeholder="可简述推广计划或资源（选填）" value="{{form.remark}}" bindinput="onInput" data-key="remark" maxlength="200" />
      </view>
      <button class="btn-submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitApply">提交申请</button>
    </block>
  </view>

  <!-- 我的邀请码 -->
  <view class="section">
    <view class="section-title">我的邀请码</view>
    <view class="invite-card" wx:if="{{inviteCode}}">
      <text class="invite-code" bindtap="copyInviteCode">{{inviteCode}}</text>
      <text class="invite-hint">好友注册时填写此邀请码即可绑定</text>
      <view class="invite-actions">
        <button class="btn-copy" size="mini" bindtap="copyInviteCode">复制邀请码</button>
      </view>
    </view>
    <view class="invite-loading" wx:else>
      <text>{{loadingInvite ? '加载中…' : '登录后可查看邀请码'}}</text>
    </view>
  </view>
</view>
