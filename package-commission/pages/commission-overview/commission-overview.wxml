<view class="container">
  <!-- 总览卡片 -->
  <view class="summary-card" wx:if="{{summary}}">
    <view class="summary-title">佣金总览</view>
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-amount">¥{{summary.total_earned || 0}}</text>
        <text class="summary-label">累计收益</text>
      </view>
      <view class="summary-item">
        <text class="summary-amount available">¥{{summary.available_amount || 0}}</text>
        <text class="summary-label">可提现</text>
      </view>
      <view class="summary-item">
        <text class="summary-amount pending">¥{{summary.pending_amount || 0}}</text>
        <text class="summary-label">待结算</text>
      </view>
      <view class="summary-item">
        <text class="summary-amount withdrawn">¥{{summary.withdrawn_amount || 0}}</text>
        <text class="summary-label">已提现</text>
      </view>
    </view>
  </view>

  <!-- 各角色明细 -->
  <view class="section" wx:if="{{roles.length > 0}}">
    <view class="section-title">各角色佣金</view>
    <view class="role-card" wx:for="{{roles}}" wx:key="role" style="border-left: 4px solid {{item.color}}">
      <view class="role-header">
        <text class="role-name">{{item.label}}</text>
        <text class="role-earned">¥{{item.total_earned || 0}}</text>
      </view>
      <view class="role-details">
        <view class="role-detail-item">
          <text>可提现</text>
          <text class="role-detail-value">¥{{item.available_amount || 0}}</text>
        </view>
        <view class="role-detail-item">
          <text>待结算</text>
          <text class="role-detail-value pending">¥{{item.pending_amount || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 无角色提示 -->
  <view class="empty-state" wx:if="{{!loading && roles.length === 0}}">
    <view class="empty-icon">💰</view>
    <view class="empty-text">暂无合伙人角色</view>
    <view class="empty-desc">填写资料申请成为合伙人，分享邀请码赚取佣金</view>
    <button class="btn-primary" size="mini" bindtap="goPartner">申请成为合伙人</button>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar" wx:if="{{summary && summary.available_amount > 0}}">
    <button class="btn-withdraw" size="default" bindtap="goWithdraw">提现</button>
    <button class="btn-secondary" size="default" bindtap="goRecords">收益明细</button>
  </view>

  <view class="action-bar" wx:if="{{summary && summary.available_amount <= 0 && roles.length > 0}}">
    <button class="btn-secondary" size="default" bindtap="goRecords">收益明细</button>
  </view>
</view>
